{
  "id": "preset.ai",
  "name": "AI & Copilot Management",
  "description": "Turns off Copilot, Recall snapshots, Click to Do, Bing web results in search, and AI features in Paint and Notepad.",
  "standard": [
    "ai.clicktodo.disable",
    "ai.notepad.disable-ai-features",
    "ai.paint.disable-ai-features",
    "apps.edge.disable-sidebar"
  ],
  "full": [
    "ai.clicktodo.disable",
    "ai.copilot.disable-policy",
    "ai.copilot.disable-taskbar-button",
    "ai.notepad.disable-ai-features",
    "ai.paint.disable-ai-features",
    "ai.recall.disable-availability",
    "ai.recall.disable-snapshots",
    "ai.search.disable-bing-web-search",
    "apps.edge.disable-sidebar"
  ],
  "excluded": [
    {
      "id": "advanced.bravedebloat",
      "reason": "High risk — enable individually from Tweaks"
    },
    {
      "id": "advanced.windowsai",
      "reason": "High risk — enable individually from Tweaks"
    }
  ]
}
