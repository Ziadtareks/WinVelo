{
  "id": "preset.gaming",
  "name": "Gaming: Fewer Background Interruptions",
  "description": "Disables background Xbox Game Bar recording overlays, Game DVR background captures, and optimizes system responsiveness and raw input for gaming.",
  "standard": [
    "gaming.input.disable-mouse-acceleration",
    "gaming.mode.enable",
    "pref.multiplaneoverlay",
    "pref.stickykeys"
  ],
  "full": [
    "advanced.disablenotifications",
    "advanced.logiblock",
    "advanced.razerblock",
    "gaming.dvr.disable-background-recording",
    "gaming.input.disable-mouse-acceleration",
    "gaming.mode.enable",
    "gaming.xbox.disable-game-bar",
    "performance.cpu.priority-separation",
    "performance.gpu.disable-mpo",
    "performance.gpu.hags",
    "performance.power.disable-throttling",
    "pref.multiplaneoverlay",
    "pref.stickykeys"
  ],
  "excluded": [
    {
      "id": "performance.cpu.unpark-cores",
      "reason": "Experimental tweak — requires manual testing"
    },
    {
      "id": "performance.gaming.mmcss-responsiveness",
      "reason": "Experimental tweak — requires manual testing"
    },
    {
      "id": "performance.input.buffer-queue",
      "reason": "Experimental tweak — requires manual testing"
    }
  ]
}
