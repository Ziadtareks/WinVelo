[
  {
    "schemaVersion": "1.0.0",
    "id": "ai.copilot.disable-taskbar-button",
    "name": "Hide Copilot Taskbar Button",
    "description": "Hides the Copilot button from the Windows 11 taskbar.",
    "category": "ai",
    "subcategory": "copilot",
    "risk": "Safe",
    "impacts": [
      "ui"
    ],
    "tags": [
      "copilot",
      "taskbar",
      "ai"
    ],
    "presets": [
      "recommended",
      "privacy",
      "minimal"
    ],
    "windows": {
      "minBuild": 22621,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": true,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "valueName": "ShowCopilotButton",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "valueName": "ShowCopilotButton",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "valueName": "ShowCopilotButton",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/client-management/manage-windows-copilot",
    "verifiedOnBuild": "22631.4317"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "ai.copilot.disable-policy",
    "name": "Disable Windows Copilot Globally",
    "description": "Turns off the Windows Copilot assistant system-wide using policy.",
    "category": "ai",
    "subcategory": "copilot",
    "risk": "Low",
    "impacts": [
      "privacy",
      "ui"
    ],
    "tags": [
      "copilot",
      "ai",
      "policy"
    ],
    "presets": [
      "privacy"
    ],
    "windows": {
      "minBuild": 22621,
      "maxBuild": null,
      "editions": [
        "Pro",
        "Enterprise",
        "Education",
        "IoTEnterprise"
      ]
    },
    "requiresReboot": false,
    "requiresExplorerRestart": true,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
      "valueName": "TurnOffWindowsCopilot",
      "matchType": "Equals",
      "expectedValue": 1
    },
    "apply": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
        "valueName": "TurnOffWindowsCopilot",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
        "valueName": "TurnOffWindowsCopilot",
        "operation": "DeleteValue"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/client-management/manage-windows-copilot",
    "verifiedOnBuild": "22631.4317"
  },
