[
  {
    "schemaVersion": "1.0.0",
    "id": "updates.drivers.exclude-from-updates",
    "name": "Exclude Hardware Drivers from Windows Update",
    "description": "Prevents Windows Update from automatically replacing your dedicated GPU or chipset drivers.",
    "category": "updates",
    "subcategory": "drivers",
    "risk": "Low",
    "impacts": [
      "gaming",
      "performance"
    ],
    "tags": [
      "drivers",
      "windowsupdate"
    ],
    "presets": [
      "recommended",
      "gaming"
    ],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
      "valueName": "ExcludeWUDriversInQualityUpdate",
      "matchType": "Equals",
      "expectedValue": 1
    },
    "apply": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "valueName": "ExcludeWUDriversInQualityUpdate",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
        "valueName": "ExcludeWUDriversInQualityUpdate",
        "operation": "DeleteValue"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/deployment/update/waas-wu-settings#do-not-include-drivers-with-windows-updates",
    "verifiedOnBuild": "22631.4317"
  },
