[
  {
    "schemaVersion": "1.0.0",
    "id": "performance.gaming.mmcss-responsiveness",
    "origin": "performance.gaming.mmcss-responsiveness",
    "name": "Multimedia Class Scheduler Service (MMCSS) Gaming Priority",
    "description": "Turns off MMCSS network throttling and lowers the CPU share reserved for background tasks. It also raises the Games task priority, which only affects programs that register with MMCSS as a game. Most games do not.",
    "category": "Experimental",
    "subcategory": "Gaming & CPU",
    "risk": "Medium",
    "evidence": "situational",
    "sideEffects": "Background system tasks may experience CPU starvation during gaming; in rare hardware setups, this may introduce audio latency or streaming capture frame drops.",
    "impacts": [
      "gaming",
      "network",
      "performance"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": true,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
      "valueName": "NetworkThrottlingIndex",
      "matchType": "Equals",
      "expectedValue": -1
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
        "operation": "Set",
        "valueName": "NetworkThrottlingIndex",
        "valueKind": "DWord",
        "data": -1
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
        "operation": "Set",
        "valueName": "SystemResponsiveness",
        "valueKind": "DWord",
        "data": 10
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "GPU Priority",
        "valueKind": "DWord",
        "data": 8
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "Priority",
        "valueKind": "DWord",
        "data": 6
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "Scheduling Category",
        "valueKind": "String",
        "data": "High"
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "SFIO Priority",
        "valueKind": "String",
        "data": "High"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
        "operation": "Set",
        "valueName": "NetworkThrottlingIndex",
        "valueKind": "DWord",
        "data": 10
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
        "operation": "Set",
        "valueName": "SystemResponsiveness",
        "valueKind": "DWord",
        "data": 20
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "GPU Priority",
        "valueKind": "DWord",
        "data": 8
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "Priority",
        "valueKind": "DWord",
        "data": 2
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "Scheduling Category",
        "valueKind": "String",
        "data": "Medium"
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
        "operation": "Set",
        "valueName": "SFIO Priority",
        "valueKind": "String",
        "data": "Normal"
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631",
    "whatItDoes": "Configures Multimedia Class Scheduler Service (MMCSS) by setting SystemResponsiveness to 10 and NetworkThrottlingIndex to -1 in SystemProfile, with Games task GPU Priority to 8 and Priority to 6.",
    "sources": [
      "https://learn.microsoft.com/en-us/windows/win32/procthread/multimedia-class-scheduler-service"
    ],
    "needsReview": true,
    "tags": [
      "gaming",
      "performance",
      "network"
    ],
    "presetRole": "advanced"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "performance.gpu.hags",
    "origin": "performance.gpu.hags",
    "name": "Hardware-Accelerated GPU Scheduling (HAGS)",
    "description": "User preference toggle for Windows Display Driver Model (WDDM 2.7+) hardware GPU scheduling. Offloads scheduling from CPU to dedicated GPU scheduling processor.",
    "category": "preferences",
    "subcategory": "Gaming & GPU",
    "risk": "Medium",
    "evidence": "ui-equivalent",
    "impacts": [
      "performance",
      "gaming"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": true,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "valueName": "HwSchMode",
      "matchType": "Equals",
      "expectedValue": 2
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
        "operation": "Set",
        "valueName": "HwSchMode",
        "valueKind": "DWord",
        "data": 2
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
        "operation": "Set",
        "valueName": "HwSchMode",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631",
    "whatItDoes": "Sets HwSchMode to 2 under GraphicsDrivers to enable Hardware-Accelerated GPU Scheduling (HAGS) in WDDM.",
    "sideEffects": "Requires a system restart; may cause instability, stuttering, or frame drops in select older games or video capture/streaming applications with certain GPU drivers.",
    "sources": [
      "https://devblogs.microsoft.com/directx/hardware-accelerated-gpu-scheduling/"
    ],
    "needsReview": false,
    "uiEquivalentLocation": "Settings › System › Display › Graphics › Default graphics settings › Hardware-accelerated GPU scheduling",
    "tags": [
      "gaming",
      "performance"
    ],
    "presetRole": "preference"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "performance.gpu.disable-mpo",
    "origin": "performance.gpu.disable-mpo",
    "name": "Disable Multi-Plane Overlay (MPO Workaround)",
    "description": "Workaround for specific display-flicker and black screen bugs on certain older GPU drivers. Note: Disabling MPO is not a general performance optimization; it increases power usage and disables hardware-level windowed presentation optimizations on modern systems.",
    "category": "gaming",
    "subcategory": "Gaming & GPU",
    "risk": "Medium",
    "evidence": "situational",
    "sideEffects": "Workaround for screen flickering or black screens on multi-monitor setups; increases GPU power consumption and may disable windowed HDR/G-Sync optimizations.",
    "impacts": [
      "gaming",
      "performance"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": true,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Microsoft\\Windows\\Dwm",
      "valueName": "OverlayTestMode",
      "matchType": "Equals",
      "expectedValue": 5
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\Dwm",
        "operation": "Set",
        "valueName": "OverlayTestMode",
        "valueKind": "DWord",
        "data": 5
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\Dwm",
        "operation": "DeleteValue",
        "valueName": "OverlayTestMode"
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631",
    "whatItDoes": "Sets OverlayTestMode to 5 to disable Multi-Plane Overlay (MPO) in Desktop Window Manager (DWM).",
    "sources": [
      "https://learn.microsoft.com/en-us/windows-hardware/drivers/display/multiplane-overlay-support"
    ],
    "needsReview": false,
    "tags": [
      "gaming",
      "performance",
      "ui"
    ],
    "presetRole": "fix",
    "effectNote": "OverlayTestMode 5 is reported to no longer disable MPO on recent Windows 11 builds. Check MaxPlanes in DxDiag after rebooting.",
    "aliases": [
      "pref.multiplaneoverlay",
      "WPFMultiplaneOverlay"
    ]
  },
  {
    "schemaVersion": "1.0.0",
    "id": "performance.power.disable-throttling",
    "origin": "performance.power.disable-throttling",
    "name": "Disable Windows Power Throttling",
    "description": "Disables Windows Execution Power Throttling for background applications. Useful for background rendering or compute tasks, but significantly increases battery consumption.",
    "category": "performance",
    "subcategory": "Gaming & Power",
    "risk": "Medium",
    "evidence": "situational",
    "sideEffects": "Noticeably reduces battery runtime and increases thermal output on mobile and battery-powered devices.",
    "impacts": [
      "performance",
      "gaming"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": true,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling",
      "valueName": "PowerThrottlingOff",
      "matchType": "Equals",
      "expectedValue": 1
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling",
        "operation": "Set",
        "valueName": "PowerThrottlingOff",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Power\\PowerThrottling",
        "operation": "DeleteValue",
        "valueName": "PowerThrottlingOff"
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631",
    "whatItDoes": "Sets PowerThrottlingOff to 1 under system power policies, preventing Windows from reducing background execution frequency on idle threads.",
    "sources": [
      "https://learn.microsoft.com/en-us/windows/win32/power/power-throttling"
    ],
    "needsReview": false,
    "tags": [
      "performance",
      "gaming"
    ],
    "presetRole": "advanced"
  }
]
