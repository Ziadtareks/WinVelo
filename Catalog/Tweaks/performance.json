        "valueKind": "DWord",
        "data": 0
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Power\\PowerSettings\\54533251-82be-4824-96c1-47b60b740d00\\0cc5b647-c1df-4637-891a-dec35c318583",
        "operation": "Set",
        "valueName": "ValueMax",
        "valueKind": "DWord",
        "data": 100
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631",
    "whatItDoes": "Sets the processor performance core parking minimum cores unparked percentage (ValueMax) to 100% in system power settings.",
    "sources": [
      "https://learn.microsoft.com/en-us/windows-server/administration/performance-tuning/hardware/power/"
