[
  {
    "schemaVersion": "1.0.0",
    "id": "performance.visual.disable-transparency",
    "name": {
      "en": "Disable Transparency Effects",
      "ar": "تعطيل تأثيرات الشفافية"
    },
    "description": {
      "en": "Turns off transparency on taskbar, Start menu, and windows to reduce GPU overhead.",
      "ar": "إيقاف شفافية النوافذ وشريط المهام لتقليل الحمل على كارت الشاشة وتحسين الاستجابة."
    },
    "category": "performance",
    "subcategory": "visual",
    "risk": "Safe",
    "impacts": ["performance", "battery", "ui"],
    "tags": ["transparency", "gpu"],
    "presets": ["gaming", "minimal"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "valueName": "EnableTransparency",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
        "valueName": "EnableTransparency",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
        "valueName": "EnableTransparency",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/configuration/visual-effects",
    "verifiedOnBuild": "22631.4317"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "performance.visual.disable-animations",
    "name": {
      "en": "Disable Window Minimize/Maximize Animations",
      "ar": "تعطيل حركات تصغير وتكبير النوافذ"
    },
    "description": {
      "en": "Speeds up desktop responsiveness by eliminating window transition animations.",
      "ar": "تسريع التنقل عبر النوافذ بإلغاء الرسوم المتحركة عند التصغير والتكبير."
    },
    "category": "performance",
    "subcategory": "visual",
    "risk": "Safe",
    "impacts": ["performance", "ui"],
    "tags": ["animations", "speed"],
    "presets": ["gaming", "minimal"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": true,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Control Panel\\Desktop\\WindowMetrics",
      "valueName": "MinAnimate",
      "matchType": "Equals",
      "expectedValue": "0"
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Control Panel\\Desktop\\WindowMetrics",
        "valueName": "MinAnimate",
        "valueKind": "String",
        "data": "0",
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Control Panel\\Desktop\\WindowMetrics",
        "valueName": "MinAnimate",
        "valueKind": "String",
        "data": "1",
        "operation": "Set"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/configuration/visual-effects",
    "verifiedOnBuild": "22631.4317"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "performance.system.disable-startup-delay",
    "name": {
      "en": "Disable Windows Startup App Delay",
      "ar": "إلغاء مهلة تأخير تشغيل تطبيقات الإقلاع"
    },
    "description": {
      "en": "Eliminates the built-in 10-second startup delay Windows imposes on autostart apps.",
      "ar": "إلغاء فترة التأخير التلقائية التي يفرضها ويندوز عند تشغيل البرامج مع إقلاع النظام."
    },
    "category": "performance",
    "subcategory": "startup",
    "risk": "Safe",
    "impacts": ["performance"],
    "tags": ["startup", "boot"],
    "presets": ["recommended", "gaming"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
      "valueName": "StartupDelayInMSec",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
        "valueName": "StartupDelayInMSec",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize",
        "valueName": "StartupDelayInMSec",
        "operation": "DeleteValue"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/client-management/client-tools/startup-apps",
    "verifiedOnBuild": "22631.4317"
  },
