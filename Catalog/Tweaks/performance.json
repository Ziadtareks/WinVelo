      "minBuild": 19041
    },
    "requiresReboot": true,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Services\\mouclass\\Parameters",
