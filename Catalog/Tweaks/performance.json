[
  {
    "schemaVersion": "1.0.0",
    "id": "performance.visual.disable-transparency",
    "name": "Disable Transparency Effects",
    "description": "Turns off transparency on taskbar, Start menu, and windows to reduce GPU overhead.",
    "category": "performance",
    "subcategory": "visual",
    "risk": "Safe",
    "impacts": [
      "performance",
      "battery",
      "ui"
    ],
    "tags": [
      "transparency",
      "gpu"
    ],
    "presets": [
      "gaming",
      "minimal"
    ],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "valueName": "EnableTransparency",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
        "valueName": "EnableTransparency",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
        "valueName": "EnableTransparency",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows-hardware/customize/desktop/unattend/microsoft-windows-shell-setup-themes",
    "verifiedOnBuild": "22631.4317"
  },
