  {
    "schemaVersion": "1.0.0",
    "id": "performance.cpu.priority-separation",
    "origin": "performance.cpu.priority-separation",
    "name": "CPU Foreground Quantum Boost (Win32PrioritySeparation)",
    "description": "Optimizes CPU thread quantum allocation (0x26 = 38) to prioritize foreground applications and games, eliminating micro-stutters and input lag.",
    "category": "performance",
    "subcategory": "Gaming & CPU",
    "risk": "Safe",
    "impacts": [
      "performance",
      "gaming"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\PriorityControl",
      "valueName": "Win32PrioritySeparation",
      "matchType": "Equals",
      "expectedValue": 38
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\PriorityControl",
        "operation": "Set",
        "valueName": "Win32PrioritySeparation",
        "valueKind": "DWord",
        "data": 38
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\PriorityControl",
        "operation": "Set",
        "valueName": "Win32PrioritySeparation",
        "valueKind": "DWord",
        "data": 2
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631"
  },
