    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "valueName": "HwSchMode",
      "matchType": "Equals",
      "expectedValue": 2
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
        "operation": "Set",
        "valueName": "HwSchMode",
        "valueKind": "DWord",
        "data": 2
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
        "operation": "Set",
        "valueName": "HwSchMode",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631",
    "whatItDoes": "Enables Hardware-Accelerated GPU Scheduling (HagsEnabled = 2) in the DirectX Graphics Kernel to allow the GPU to manage its own video memory scheduling.",
    "sideEffects": "Requires a system restart; may cause instability, stuttering, or frame drops in select older games or video capture/streaming applications with certain GPU drivers.",
    "sources": [
      "https://devblogs.microsoft.com/directx/hardware-accelerated-gpu-scheduling/"
    ],
    "needsReview": false
  },
