  {
    "schemaVersion": "1.0.0",
    "id": "performance.network.delivery-optimization-simple",
    "name": {
      "en": "Restrict Delivery Optimization to Local Network",
      "ar": "تقييد تحسين التسليم على الشبكة المحلية فقط"
    },
    "description": {
      "en": "Stops Windows Update from uploading update files to external internet peers (Mode 0: HTTP only / No P2P).",
      "ar": "منع ويندوز من استخدام سرعة الإنترنت لديك لرفع التحديثات لأجهزة أخرى عبر الإنترنت."
    },
    "category": "performance",
    "subcategory": "network",
    "risk": "Safe",
    "impacts": ["network", "performance"],
    "tags": ["bandwidth", "updates"],
    "presets": ["recommended", "gaming"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
      "valueName": "DODownloadMode",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
        "valueName": "DODownloadMode",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
        "valueName": "DODownloadMode",
        "operation": "DeleteValue"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/deployment/do/waas-delivery-optimization-reference#download-mode",
    "verifiedOnBuild": "22631.4317"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "performance.memory.svchost-split-threshold",
    "name": {
      "en": "Tune SvcHost Split Threshold",
      "ar": "تحسين عتبة تجزئة عمليات الخدمات (SvcHost)"
    },
    "description": {
      "en": "Groups system services into fewer svchost processes on systems with moderate RAM to reduce memory overhead.",
      "ar": "تجميع خدمات النظام في عدد أقل من عمليات svchost لتوفير استهلاك الذاكرة العشوائية (RAM)."
    },
    "category": "performance",
    "subcategory": "memory",
    "risk": "Low",
    "impacts": ["performance"],
    "tags": ["svchost", "ram"],
    "presets": ["recommended"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": true,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control",
      "valueName": "SvcHostSplitThresholdInKB",
      "matchType": "Equals",
      "expectedValue": 380000
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control",
        "valueName": "SvcHostSplitThresholdInKB",
        "valueKind": "DWord",
        "data": 380000,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control",
        "valueName": "SvcHostSplitThresholdInKB",
        "operation": "DeleteValue"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/application-management/svchost-service-refactoring",
    "verifiedOnBuild": "22631.4317"
  }
]
