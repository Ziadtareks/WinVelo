[
  {
    "schemaVersion": "1.0.0",
    "id": "performance.cpu.priority-separation",
    "origin": "performance.cpu.priority-separation",
    "name": "Adjust Win32 Priority Separation",
    "description": "Configures thread scheduling quantum length for foreground applications (0x26 = short, variable quantum with high foreground boost). Situational: may improve foreground responsiveness in specific scenarios, but can starve background threads and cause audio dropouts or micro-stutters in multi-threaded modern games.",
    "category": "performance",
    "subcategory": "Gaming & CPU",
    "risk": "Medium",
    "evidence": "situational",
    "sideEffects": "May slightly reduce throughput for heavy background processing, video encoding, or continuous background rendering.",
    "impacts": [
      "performance",
      "gaming"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\PriorityControl",
      "valueName": "Win32PrioritySeparation",
      "matchType": "Equals",
      "expectedValue": 38
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\PriorityControl",
        "operation": "Set",
        "valueName": "Win32PrioritySeparation",
        "valueKind": "DWord",
        "data": 38
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\PriorityControl",
        "operation": "Set",
        "valueName": "Win32PrioritySeparation",
        "valueKind": "DWord",
        "data": 2
      }
    ],
    "source": "https://github.com/hellzerg/optimizer",
    "verifiedOnBuild": "22631",
    "whatItDoes": "Sets Win32PrioritySeparation to 38 (0x26), optimizing processor thread quantum duration for foreground interactive applications.",
    "sources": [
      "https://learn.microsoft.com/en-us/windows/win32/procthread/priority-classes",
      "https://learn.microsoft.com/en-us/windows-server/administration/performance-tuning/subsystem/processor"
    ],
    "needsReview": false
  },
