  {
    "schemaVersion": "1.0.0",
    "id": "performance.cpu.unpark-cores",
    "origin": "performance.cpu.unpark-cores",
    "name": "Disable CPU Core Parking (Experimental)",
    "description": "Forces all CPU cores unparked. On modern Windows, the thread scheduler already unparks cores dynamically within microseconds. Disabling parking wastes significant battery and power on laptops with no measurable gaming performance uplift.",
    "category": "Experimental",
    "subcategory": "Gaming & CPU",
    "risk": "Medium",
    "evidence": "anecdotal",
    "sideEffects": "Keeps all CPU logical cores unparked at all times, preventing deeper C-states and increasing power consumption and heat output, particularly on laptops. Unverified benefit on modern schedulers.",
    "impacts": [
      "performance",
      "gaming"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\Power\\PowerSettings\\54533251-82be-4824-96c1-47b60b740d00\\0cc5b647-c1df-4637-891a-dec35c318583",
      "valueName": "ValueMax",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
