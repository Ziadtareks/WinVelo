[
  {
    "schemaVersion": "1.0.0",
    "id": "gaming.mode.enable",
    "name": "Enable Windows Game Mode",
    "description": "Prioritizes CPU and GPU resources for active games and suppresses background tasks.",
    "category": "gaming",
    "subcategory": "mode",
    "risk": "Safe",
    "impacts": [
      "gaming",
      "performance"
    ],
    "tags": [
      "gaming",
      "gamemode"
    ],
    "presets": [
      "recommended",
      "gaming"
    ],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Software\\Microsoft\\GameBar",
      "valueName": "AutoGameModeEnabled",
      "matchType": "Equals",
      "expectedValue": 1
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\GameBar",
        "valueName": "AutoGameModeEnabled",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\GameBar",
        "valueName": "AutoGameModeEnabled",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "source": "https://support.microsoft.com/en-us/windows/use-game-mode-on-your-pc-5896ee1a-1e64-44b7-a3f2-892f33c37574",
    "verifiedOnBuild": "22631.4317"
  },
