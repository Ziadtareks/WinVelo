[
  {
    "schemaVersion": "1.0.0",
    "id": "privacy.telemetry.diagnostic-data",
    "name": "Diagnostic Data Level",
    "description": "Reduces diagnostic data sent to Microsoft to the lowest allowed level.",
    "effectNote": "On Windows Enterprise and Education, this sets data collection to 0 (Security). On Windows Home and Pro, Windows treats 0 as 1 (Required diagnostic data).",
    "category": "privacy",
    "subcategory": "telemetry",
    "risk": "Safe",
    "impacts": [
      "privacy"
    ],
    "tags": [
      "telemetry",
      "privacy",
      "diagnostics"
    ],
    "presets": [
      "recommended",
      "privacy"
    ],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null,
      "editions": [
        "Home",
        "Pro",
        "Enterprise",
        "Education",
        "IoTEnterprise"
      ]
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "valueName": "AllowTelemetry",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
        "valueName": "AllowTelemetry",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Policy",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
        "valueName": "AllowTelemetry",
        "operation": "DeleteValue"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/privacy/configure-windows-diagnostic-data-in-your-organization",
    "verifiedOnBuild": "22631.4317",
    "warnings": "Windows Settings will display \u0027Some settings are managed by your organization\u0027. This is normal when Group Policy registry keys are set."
  },
