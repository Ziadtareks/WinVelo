[
  {
    "schemaVersion": "1.0.0",
    "id": "system.security.disable-remote-assistance",
    "name": "Disable Remote Assistance",
    "description": "Disables Windows Remote Assistance (Easy Connect and invitation files) to close unsolicited remote help access.",
    "category": "system",
    "subcategory": "Security",
    "risk": "Safe",
    "impacts": [
      "security"
    ],
    "tags": [
      "remote",
      "security",
      "assistance"
    ],
    "presets": [
      "recommended",
      "minimal"
    ],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\Remote Assistance",
      "valueName": "fAllowToGetHelp",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Remote Assistance",
        "valueName": "fAllowToGetHelp",
        "valueKind": "DWord",
        "data": 0
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Remote Assistance",
        "valueName": "fAllowToGetHelp",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-remoteassistance",
    "verifiedOnBuild": "26100"
  },
