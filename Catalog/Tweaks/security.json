[
  {
    "schemaVersion": "1.0.0",
    "id": "system.security.disable-remote-assistance",
    "name": {
      "en": "Disable Remote Assistance",
      "ar": "تعطيل المساعدة عن بعد"
    },
    "description": {
      "en": "Disables Windows Remote Assistance (Easy Connect and invitation files) to close unsolicited remote help access.",
      "ar": "تعطيل المساعدة عن بعد في ويندوز لمنع جلسات الدعم والمساعدة غير المصرح بها."
    },
    "category": "system",
    "subcategory": "Security",
    "risk": "Safe",
    "impacts": ["security"],
    "tags": ["remote", "security", "assistance"],
    "presets": ["recommended", "minimal"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\Remote Assistance",
      "valueName": "fAllowToGetHelp",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Remote Assistance",
        "valueName": "fAllowToGetHelp",
        "valueKind": "DWord",
        "data": 0
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\Remote Assistance",
        "valueName": "fAllowToGetHelp",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-remoteassistance",
    "verifiedOnBuild": "26100"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "system.security.disable-autorun",
    "name": {
      "en": "Disable AutoRun & AutoPlay on All Drives",
      "ar": "تعطيل التشغيل التلقائي لكافة محركات الأقراص"
    },
    "description": {
      "en": "Prevents malicious executables on USB drives and external media from executing automatically.",
      "ar": "منع تشغيل البرامج التلقائية من محركات أقراص USB والوسائط الخارجية لحماية النظام."
    },
    "category": "system",
    "subcategory": "Security",
    "risk": "Safe",
    "impacts": ["security"],
    "tags": ["autoplay", "autorun", "usb", "security"],
    "presets": ["recommended"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
      "valueName": "NoDriveTypeAutoRun",
      "matchType": "Equals",
      "expectedValue": 255
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
        "valueName": "NoDriveTypeAutoRun",
        "valueKind": "DWord",
        "data": 255
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer",
        "valueName": "NoDriveTypeAutoRun",
        "valueKind": "DWord",
        "data": 145
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/win32/shell/autoplay-reg",
    "verifiedOnBuild": "26100"
  },
