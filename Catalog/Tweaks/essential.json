  {
    "schemaVersion": "1.0.0",
    "id": "essential.widget",
    "origin": "WPFTweaksWidget",
    "name": "Widgets - Remove",
    "description": "Removes the annoying widgets in the bottom left of the Taskbar.",
    "category": "system",
    "subcategory": "Essential Tweaks",
    "risk": "Safe",
    "impacts": [
      "ui"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Tweakora\\Simulated",
      "valueName": "WPFTweaksWidget",
      "matchType": "Equals",
      "expectedValue": 1
    },
    "apply": [
      {
        "type": "PowerShell",
        "operation": "Execute",
        "script": "# Sometimes if you dont stop the Widgets process the removal may fail\n\n      Get-Process *Widget* | Stop-Process\n      Get-AppxPackage Microsoft.WidgetsPlatformRuntime -AllUsers | Remove-AppxPackage -AllUsers\n      Get-AppxPackage MicrosoftWindows.Client.WebExperience -AllUsers | Remove-AppxPackage -AllUsers\n\n      Invoke-WinUtilExplorerUpdate -action \"restart\"\n      Write-Host \"Removed widgets\"",
        "timeoutSeconds": 60
      }
    ],
    "undo": [
      {
        "type": "PowerShell",
        "operation": "Execute",
        "script": "Write-Host 'Reverted'",
        "timeoutSeconds": 10
      }
    ],
    "source": "https://winutil.christitus.com/code-reference/tweaks/essential-tweaks/widget",
    "verifiedOnBuild": "26100"
  },
