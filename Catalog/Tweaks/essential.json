  {
    "schemaVersion": "1.0.0",
    "id": "essential.diskcleanup",
    "origin": "WPFTweaksDiskCleanup",
    "name": "Disk Cleanup - Run",
    "description": "Runs Disk Cleanup on Drive C: and removes old Windows Updates.",
    "category": "performance",
    "subcategory": "Essential Tweaks",
    "risk": "Safe",
    "impacts": [
      "performance"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VolumeCaches\\Temporary Files",
      "valueName": "StateFlags0001",
      "matchType": "Equals",
      "expectedValue": 2
    },
    "apply": [
      {
        "type": "PowerShell",
        "operation": "Execute",
        "script": "cleanmgr.exe /d C: /VERYLOWDISK\n      if ($LASTEXITCODE -ne 0) { throw \"cleanmgr failed with exit code $LASTEXITCODE\" }\n      Dism.exe /online /Cleanup-Image /StartComponentCleanup /ResetBase\n      if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne 3010) { throw \"Dism failed with exit code $LASTEXITCODE\" }",
        "timeoutSeconds": 600
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VolumeCaches\\Temporary Files",
        "operation": "Set",
        "valueName": "StateFlags0001",
        "valueKind": "DWord",
        "data": 2
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VolumeCaches\\Temporary Files",
        "operation": "DeleteValue",
        "valueName": "StateFlags0001"
      }
    ],
    "source": "https://winutil.christitus.com/code-reference/tweaks/essential-tweaks/diskcleanup",
    "verifiedOnBuild": "26100",
    "warnings": "Purges superseded Windows update components via DISM /ResetBase. Once executed, superseded updates cannot be rolled back. Undo only resets CleanMgr registry flags.",
    "reversible": false,
    "irreversibleReason": "Executes DISM ResetBase and CleanMgr which permanently purge superseded Windows update components; deleted update baselines cannot be restored."
  },
