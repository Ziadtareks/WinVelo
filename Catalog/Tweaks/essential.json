  {
    "schemaVersion": "1.0.0",
    "id": "essential.services",
    "origin": "WPFTweaksServices",
    "name": "Services - Set to Manual",
    "description": "Sets some services to Manual startup and adjusts the SvcHostSplitThresholdInKB registry value to better match system memory, which can significantly reduce the number of svchost.exe processes.",
    "category": "performance",
    "subcategory": "Essential Tweaks",
    "risk": "Safe",
    "impacts": [
      "performance"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Service",
      "serviceName": "CscService",
      "expectedStartup": "Disabled"
    },
    "apply": [
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "CscService",
        "startupType": "Disabled"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "DiagTrack",
        "startupType": "Disabled"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "MapsBroker",
        "startupType": "Manual"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "StorSvc",
        "startupType": "Manual"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "SharedAccess",
        "startupType": "Disabled"
      },
      {
        "type": "PowerShell",
        "operation": "Execute",
        "script": "$Memory = (Get-CimInstance Win32_PhysicalMemory | Measure-Object Capacity -Sum).Sum / 1KB\n      Set-ItemProperty -Path \"HKLM:\\SYSTEM\\CurrentControlSet\\Control\" -Name SvcHostSplitThresholdInKB -Value $Memory",
        "timeoutSeconds": 60
      }
    ],
    "undo": [
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "CscService",
        "startupType": "Manual"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "DiagTrack",
        "startupType": "Automatic"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "MapsBroker",
        "startupType": "Automatic"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "StorSvc",
        "startupType": "Automatic"
      },
      {
        "type": "Service",
        "operation": "SetStartup",
        "serviceName": "SharedAccess",
        "startupType": "Automatic"
      }
    ],
    "source": "https://winutil.christitus.com/code-reference/tweaks/essential-tweaks/services",
    "verifiedOnBuild": "26100"
  },
