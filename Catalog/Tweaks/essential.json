    "subcategory": "Essential Tweaks",
    "risk": "Safe",
    "impacts": [
      "ui"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "System\\CurrentControlSet\\Control\\Session Manager\\Power",
      "valueName": "HibernateEnabled",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "System\\CurrentControlSet\\Control\\Session Manager\\Power",
        "operation": "Set",
        "valueName": "HibernateEnabled",
        "valueKind": "DWord",
        "data": 0
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FlyoutMenuSettings",
        "operation": "Set",
        "valueName": "ShowHibernateOption",
        "valueKind": "DWord",
        "data": 0
      },
      {
        "type": "PowerShell",
        "operation": "Execute",
        "script": "powercfg.exe /hibernate off",
        "timeoutSeconds": 60
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "System\\CurrentControlSet\\Control\\Session Manager\\Power",
        "operation": "Set",
        "valueName": "HibernateEnabled",
        "valueKind": "DWord",
        "data": 1
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\FlyoutMenuSettings",
        "operation": "Set",
        "valueName": "ShowHibernateOption",
        "valueKind": "DWord",
        "data": 1
      },
      {
