    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\WcmSvc\\wifinetworkmanager\\config",
        "valueName": "AutoConnectAllowedOEM",
        "valueKind": "DWord",
        "data": 0
      }
