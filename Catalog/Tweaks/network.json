  {
    "schemaVersion": "1.0.0",
    "id": "network.optimization.limit-peering-lan",
    "name": {
      "en": "Restrict Delivery Optimization to Local Network Only",
      "ar": "قصر تحسين التوصيل على شبكة الاتصال المحلية فقط"
    },
    "description": {
      "en": "Stops Windows Update from uploading update packages to random computers across the public Internet.",
      "ar": "منع ويندوز من استهلاك سرعة رفع الإنترنت لمشاركة التحديثات مع حواسيب أخرى خارج الشبكة المحلية."
    },
    "category": "network",
    "subcategory": "Bandwidth",
    "risk": "Safe",
    "impacts": ["network", "performance"],
    "tags": ["delivery-optimization", "bandwidth", "updates"],
    "presets": ["recommended", "gaming"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
      "valueName": "DODownloadMode",
      "matchType": "Equals",
      "expectedValue": 1
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
        "valueName": "DODownloadMode",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "DeleteValue",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
        "valueName": "DODownloadMode"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/deployment/do/waas-delivery-optimization-reference",
    "verifiedOnBuild": "26100"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "network.dns.enable-doh",
    "name": {
      "en": "Enable DNS over HTTPS (DoH) System Fallback",
      "ar": "تفعيل دعم استعلامات DNS عبر بروتوكول HTTPS المشفر"
    },
    "description": {
      "en": "Configures Windows DNS client to prefer secure encrypted DNS over HTTPS queries when supported by resolver.",
      "ar": "توجيه عميل DNS في ويندوز لتفضيل الاستعلامات المشفرة لمنع مراقبة مزودي الخدمة وتشفير البيانات."
    },
    "category": "network",
    "subcategory": "Security",
    "risk": "Safe",
    "impacts": ["privacy", "security", "network"],
    "tags": ["dns", "doh", "privacy", "security"],
    "presets": ["recommended", "privacy"],
    "windows": {
      "minBuild": 22000,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
      "valueName": "DnsOverHttps",
      "matchType": "Equals",
      "expectedValue": 2
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
        "valueName": "DnsOverHttps",
        "valueKind": "DWord",
        "data": 2
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "DeleteValue",
        "hive": "HKLM",
        "key": "SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
        "valueName": "DnsOverHttps"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows-server/networking/dns/doh-client-support",
    "verifiedOnBuild": "26100"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "network.teredo.disable-tunneling",
    "name": {
      "en": "Disable Teredo IPv6 Tunneling",
      "ar": "تعطيل نفق Teredo لبروتوكول IPv6"
    },
    "description": {
      "en": "Disables obsolete Teredo transition protocol tunneling to reduce attack surface and prevent IP leaks.",
      "ar": "تعطيل نفق Teredo القديم لتقليل مساحة الهجمات ومنع تسريبات عناوين بروتوكول الإنترنت."
    },
    "category": "network",
    "subcategory": "Security",
    "risk": "Safe",
    "impacts": ["security", "network"],
    "tags": ["teredo", "ipv6", "security"],
    "presets": ["recommended"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Services\\TCPIP6\\Parameters",
      "valueName": "DisabledComponents",
      "matchType": "Equals",
      "expectedValue": 8
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\TCPIP6\\Parameters",
        "valueName": "DisabledComponents",
        "valueKind": "DWord",
        "data": 8
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "DeleteValue",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\TCPIP6\\Parameters",
        "valueName": "DisabledComponents"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/troubleshoot/windows-server/networking/configure-ipv6-in-windows",
    "verifiedOnBuild": "26100"
  }
]
