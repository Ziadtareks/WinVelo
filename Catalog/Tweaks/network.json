[
  {
    "schemaVersion": "1.0.0",
    "id": "network.wifi.disable-hotspot-reporting",
    "name": {
      "en": "Disable Wi-Fi Sense Hotspot Reporting",
      "ar": "تعطيل مشاركة وإبلاغ شبكات Wi-Fi Sense"
    },
    "description": {
      "en": "Prevents Windows from automatically sharing known Wi-Fi network information with Microsoft services.",
      "ar": "منع ويندوز من مشاركة بيانات ومعلومات شبكات Wi-Fi المعروفة مع خوادم مايكروسوفت."
    },
    "category": "network",
    "subcategory": "Wi-Fi",
    "risk": "Safe",
    "impacts": ["privacy", "network"],
    "tags": ["wifi", "privacy", "network"],
    "presets": ["recommended", "privacy"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Microsoft\\PolicyManager\\default\\WiFi\\AllowWiFiHotSpotReporting",
      "valueName": "value",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\PolicyManager\\default\\WiFi\\AllowWiFiHotSpotReporting",
        "valueName": "value",
        "valueKind": "DWord",
        "data": 0
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\PolicyManager\\default\\WiFi\\AllowWiFiHotSpotReporting",
        "valueName": "value",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-wifi#allowwifihotspotreporting",
    "verifiedOnBuild": "26100"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "network.probing.disable-active-probing",
    "name": {
      "en": "Disable NCSI Active Internet Probing",
      "ar": "تعطيل الفحص الدوري النشط للاتصال بالإنترنت (NCSI)"
    },
    "description": {
      "en": "Prevents Windows from continuously pinging msftconnecttest.com to verify connectivity.",
      "ar": "منع إرسال طلبات اتصال مستمرة إلى خوادم الفحص msftconnecttest.com لتوفير الاتصال وتقليل التتبع."
    },
    "category": "network",
    "subcategory": "Telemetry",
    "risk": "Safe",
    "impacts": ["privacy", "network"],
    "tags": ["ncsi", "probing", "privacy"],
    "presets": ["privacy"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Services\\NlaSvc\\Parameters\\Internet",
      "valueName": "EnableActiveProbing",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\NlaSvc\\Parameters\\Internet",
        "valueName": "EnableActiveProbing",
        "valueKind": "DWord",
        "data": 0
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Services\\NlaSvc\\Parameters\\Internet",
        "valueName": "EnableActiveProbing",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "source": "https://learn.microsoft.com/en-us/troubleshoot/windows-server/networking/network-connectivity-status-indicator-active-probing-behavior",
    "verifiedOnBuild": "26100"
  },
