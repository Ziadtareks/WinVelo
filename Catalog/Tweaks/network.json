      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Microsoft\\WcmSvc\\wifinetworkmanager\\config",
      "valueName": "AutoConnectAllowedOEM",
      "matchType": "Equals",
      "expectedValue": 0
