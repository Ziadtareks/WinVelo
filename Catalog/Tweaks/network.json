[
  {
    "schemaVersion": "1.0.0",
    "id": "network.wifi.disable-hotspot-reporting",
    "name": "Disable Wi-Fi Sense Hotspot Reporting",
    "description": "Prevents Windows from automatically sharing known Wi-Fi network information with Microsoft services.",
    "category": "network",
    "subcategory": "Wi-Fi",
    "risk": "Safe",
    "impacts": [
      "privacy",
      "network"
    ],
    "tags": [
      "wifi",
      "privacy",
      "network"
    ],
    "presets": [
      "recommended",
      "privacy"
    ],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SOFTWARE\\Microsoft\\PolicyManager\\default\\WiFi\\AllowWiFiHotSpotReporting",
      "valueName": "value",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\PolicyManager\\default\\WiFi\\AllowWiFiHotSpotReporting",
        "valueName": "value",
        "valueKind": "DWord",
        "data": 0
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "operation": "Set",
        "hive": "HKLM",
        "key": "SOFTWARE\\Microsoft\\PolicyManager\\default\\WiFi\\AllowWiFiHotSpotReporting",
        "valueName": "value",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-wifi#allowwifihotspotreporting",
    "verifiedOnBuild": "26100"
  },
