    "schemaVersion": "1.0.0",
    "id": "ui.system.enable-long-paths",
    "name": {
      "en": "Enable Win32 Long Paths (>260 Chars)",
      "ar": "تفعيل المسارات الطويلة لملفات النظام (> 260 حرف)"
    },
    "description": {
      "en": "Removes the historical 260-character path length limitation for Win32 file APIs.",
      "ar": "إلغاء الحد الأقصى القديم لطول مسار الملفات (260 حرفاً) لتمكين فتح المسارات العميقة."
    },
    "category": "ui",
    "subcategory": "filesystem",
    "risk": "Safe",
    "impacts": ["storage"],
    "tags": ["filesystem", "paths"],
    "presets": ["recommended"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "type": "Registry",
      "hive": "HKLM",
      "key": "SYSTEM\\CurrentControlSet\\Control\\FileSystem",
      "valueName": "LongPathsEnabled",
      "matchType": "Equals",
      "expectedValue": 1
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\FileSystem",
        "valueName": "LongPathsEnabled",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\FileSystem",
        "valueName": "LongPathsEnabled",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/win32/fileio/maximum-file-path-limitation",
    "verifiedOnBuild": "22631.4317"
  },
