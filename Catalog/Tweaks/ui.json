[
  {
    "schemaVersion": "1.0.0",
    "id": "ui.explorer.classic-context-menu",
    "name": {
      "en": "Restore Classic Right-Click Menu",
      "ar": "استعادة قائمة الزر الأيمن الكلاسيكية"
    },
    "description": {
      "en": "Restores the Windows 10 full context menu in Windows 11 File Explorer without 'Show more options'.",
      "ar": "استعادة قائمة الزر الأيمن الكاملة في ويندوز 11 بدون الحاجة للضغط على 'إظهار المزيد من الخيارات'."
    },
    "category": "ui",
    "subcategory": "explorer",
    "risk": "Safe",
    "impacts": ["ui", "performance"],
    "tags": ["contextmenu", "explorer", "win11"],
    "presets": ["recommended", "minimal"],
    "windows": {
      "minBuild": 22000,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": true,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
      "matchType": "Exists"
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
        "valueName": "",
        "valueKind": "String",
        "data": "",
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
        "operation": "DeleteKey"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/win32/shell/context-menu-handlers",
    "verifiedOnBuild": "22631.4317"
  },
  {
    "schemaVersion": "1.0.0",
    "id": "ui.explorer.show-file-extensions",
    "name": {
      "en": "Always Show Known File Extensions",
      "ar": "إظهار امتدادات وصيغ الملفات دائماً"
    },
    "description": {
      "en": "Displays file extensions (.exe, .txt, .pdf) in File Explorer for transparency and security.",
      "ar": "إظهار امتداد الملفات (مثل .exe و .txt) في مستكشف الملفات لزيادة الأمان والوضوح."
    },
    "category": "ui",
    "subcategory": "explorer",
    "risk": "Safe",
    "impacts": ["ui", "security"],
    "tags": ["extensions", "explorer"],
    "presets": ["recommended", "minimal"],
    "windows": {
      "minBuild": 19041,
      "maxBuild": null
    },
    "requiresReboot": false,
    "requiresExplorerRestart": true,
    "detect": {
      "type": "Registry",
      "hive": "HKCU",
      "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "valueName": "HideFileExt",
      "matchType": "Equals",
      "expectedValue": 0
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "valueName": "HideFileExt",
        "valueKind": "DWord",
        "data": 0,
        "operation": "Set"
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
        "valueName": "HideFileExt",
        "valueKind": "DWord",
        "data": 1,
        "operation": "Set"
      }
    ],
    "source": "https://learn.microsoft.com/en-us/windows/security/operating-system-security/device-management/windows-security-configuration-framework/security-compliance-toolkit-10",
    "verifiedOnBuild": "22631.4317"
  },
