                "type": "Registry",
                "hive": "HKLM",
                "key": "SYSTEM\\CurrentControlSet\\Control\\CrashControl",
                "operation": "Set",
                "valueName": "DisplayParameters",
                "valueKind": "DWord",
                "data": 0
