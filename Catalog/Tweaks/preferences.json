        "id": "pref.multiplaneoverlay",
        "origin": "WPFMultiplaneOverlay",
        "name": "Multiplane Overlay Workaround",
        "description": "Workaround for specific display-flicker bugs on certain older GPU drivers. Note: Disabling MPO is not a general performance optimization; it increases power usage and disables hardware-level windowed presentation optimizations on modern systems.",
        "category": "preferences",
        "subcategory": "Customize Preferences",
        "risk": "Low",
        "evidence": "situational",
        "sideEffects": "Workaround for screen flickering; increases DWM power usage and may disable windowed HDR presentation.",
        "impacts": [
            "ui"
        ],
        "windows": {
            "minBuild": 19041
        },
        "requiresReboot": false,
        "requiresExplorerRestart": false,
        "detect": {
            "type": "Registry",
            "hive": "HKLM",
            "key": "SOFTWARE\\Microsoft\\Windows\\Dwm",
            "valueName": "OverlayTestMode",
            "matchType": "Equals",
            "expectedValue": 1
        },
        "apply": [
            {
                "type": "Registry",
                "hive": "HKLM",
                "key": "SOFTWARE\\Microsoft\\Windows\\Dwm",
                "operation": "Set",
                "valueName": "OverlayTestMode",
                "valueKind": "DWord",
                "data": 1
            },
            {
                "type": "Registry",
                "hive": "HKLM",
                "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
                "operation": "Set",
                "valueName": "DisableOverlays",
                "valueKind": "DWord",
                "data": 1
            }
        ],
        "undo": [
            {
                "type": "Registry",
                "hive": "HKLM",
                "key": "SOFTWARE\\Microsoft\\Windows\\Dwm",
                "operation": "DeleteValue",
                "valueName": "OverlayTestMode"
            },
            {
                "type": "Registry",
                "hive": "HKLM",
                "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
                "operation": "DeleteValue",
                "valueName": "DisableOverlays"
            }
        ],
        "source": "https://winutil.christitus.com/code-reference/tweaks/customize-preferences/multiplaneoverlay",
        "verifiedOnBuild": "26100",
        "whatItDoes": "Sets OverlayTestMode to 1 in DWM and DisableOverlays to 1 in GraphicsDrivers to disable Multi-Plane Overlay (MPO).",
        "sources": [
            "https://learn.microsoft.com/en-us/windows-hardware/drivers/display/multiplane-overlay-support"
        ],
        "needsReview": false,
        "relatedTweaks": [
            "performance.gpu.disable-mpo"
        ],
        "oppositeOf": "performance.gpu.disable-mpo"
