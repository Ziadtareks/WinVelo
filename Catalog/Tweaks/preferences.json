  {
    "schemaVersion": "1.0.0",
    "id": "pref.stickykeys",
    "origin": "WPFToggleStickyKeys",
    "name": "Sticky Keys Shortcut - Disable",
    "description": "Stops Sticky Keys from turning on when Shift is pressed five times, which commonly interrupts games.",
    "category": "ui",
    "subcategory": "Customize Preferences",
    "risk": "Safe",
    "impacts": [
      "ui"
    ],
    "windows": {
      "minBuild": 19041
    },
    "requiresReboot": false,
    "requiresExplorerRestart": false,
    "detect": {
      "any": [
        {
          "type": "Registry",
          "hive": "HKCU",
          "key": "Control Panel\\Accessibility\\StickyKeys",
          "valueName": "Flags",
          "matchType": "BitsClear",
          "expectedValue": 5
        }
      ]
    },
    "apply": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Control Panel\\Accessibility\\StickyKeys",
        "operation": "Set",
        "valueName": "Flags",
        "valueKind": "String",
        "data": "506"
      },
      {
        "type": "PowerShell",
        "operation": "Execute",
        "script": "$f = [int](Get-ItemProperty -Path 'HKCU:\\Control Panel\\Accessibility\\StickyKeys').Flags\nAdd-Type -Namespace WinVelo -Name StickySpi -MemberDefinition '[StructLayout(LayoutKind.Sequential)] public struct STICKYKEYS { public uint cbSize; public uint dwFlags; } [DllImport(\"user32.dll\")] public static extern bool SystemParametersInfo(uint uiAction, uint uiParam, ref STICKYKEYS pvParam, uint fWinIni);'\n$sk = New-Object WinVelo.StickySpi+STICKYKEYS\n$sk.cbSize = 8\n$sk.dwFlags = [uint32]$f\n[WinVelo.StickySpi]::SystemParametersInfo(0x3B, 8, [ref]$sk, 3) | Out-Null",
        "timeoutSeconds": 30
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKCU",
        "key": "Control Panel\\Accessibility\\StickyKeys",
        "operation": "Set",
        "valueName": "Flags",
        "valueKind": "String",
        "data": "510"
      },
      {
        "type": "PowerShell",
        "operation": "Execute",
        "script": "$f = [int](Get-ItemProperty -Path 'HKCU:\\Control Panel\\Accessibility\\StickyKeys').Flags\nAdd-Type -Namespace WinVelo -Name StickySpi -MemberDefinition '[StructLayout(LayoutKind.Sequential)] public struct STICKYKEYS { public uint cbSize; public uint dwFlags; } [DllImport(\"user32.dll\")] public static extern bool SystemParametersInfo(uint uiAction, uint uiParam, ref STICKYKEYS pvParam, uint fWinIni);'\n$sk = New-Object WinVelo.StickySpi+STICKYKEYS\n$sk.cbSize = 8\n$sk.dwFlags = [uint32]$f\n[WinVelo.StickySpi]::SystemParametersInfo(0x3B, 8, [ref]$sk, 3) | Out-Null",
        "timeoutSeconds": 30
      }
    ],
    "source": "https://winutil.christitus.com/code-reference/tweaks/customize-preferences/stickykeys",
    "verifiedOnBuild": "26100",
    "evidence": "ui-equivalent",
    "whatItDoes": "Disables the accessibility shortcut that triggers Sticky Keys when pressing Shift 5 times.",
    "sideEffects": "None known.",
    "sources": [
      "https://learn.microsoft.com/en-us/windows/apps/design/accessibility/accessibility-overview"
    ],
    "needsReview": false,
    "uiEquivalentLocation": "Settings › Accessibility › Keyboard › Sticky keys",
    "tags": [
      "gaming"
    ],
    "presetRole": "optimization",
    "scriptStateDerived": true
  },
