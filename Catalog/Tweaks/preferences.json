        "valueName": "DisableEmoticon",
        "valueKind": "DWord",
        "data": 1
      }
    ],
    "undo": [
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\CrashControl",
        "operation": "Set",
        "valueName": "DisplayParameters",
        "valueKind": "DWord",
        "data": 0
      },
      {
        "type": "Registry",
        "hive": "HKLM",
        "key": "SYSTEM\\CurrentControlSet\\Control\\CrashControl",
        "operation": "Set",
        "valueName": "DisableEmoticon",
        "valueKind": "DWord",
        "data": 0
      }
