{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TweakoraTweak",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "category",
    "risk",
    "impacts",
    "windows",
    "detect",
    "apply",
    "undo",
    "source",
    "verifiedOnBuild"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "origin": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "effectNote": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["privacy", "ai", "performance", "gaming", "ui", "network", "system", "updates"]
    },
    "subcategory": { "type": "string" },
    "risk": {
      "type": "string",
      "enum": ["Safe", "Low", "Medium", "High"]
    },
    "impacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["privacy", "performance", "ui", "gaming", "network", "security", "battery", "storage"]
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "presets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflictsWith": {
      "type": "array",
      "items": { "type": "string" }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minBuild"],
      "properties": {
        "minBuild": { "type": "integer" },
        "maxBuild": { "type": ["integer", "null"] },
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["Home", "Pro", "Enterprise", "Education", "IoTEnterprise", "Server"]
          }
        }
      }
    },
    "requiresReboot": { "type": "boolean" },
    "requiresExplorerRestart": { "type": "boolean" },
    "detect": { "$ref": "#/definitions/detectStructure" },
    "apply": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/actionItem" }
    },
    "undo": {
      "type": "array",
      "minItems": 1,
      "description": "Static fallback if the rollback journal is missing.",
      "items": { "$ref": "#/definitions/actionItem" }
    },
    "source": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        }
      ]
    },
    "verifiedOnBuild": { "type": "string" },
    "warnings": {
      "type": "string"
    }
  },
  "definitions": {
    "detectStructure": {
      "oneOf": [
        { "$ref": "#/definitions/singleDetectRule" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/singleDetectRule" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/singleDetectRule" }
            }
          }
        }
      ]
    },
    "singleDetectRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "hive", "key", "matchType"],
          "properties": {
            "type": { "const": "Registry" },
            "hive": { "type": "string", "enum": ["HKCU", "HKLM", "HKCR", "HKU"] },
            "key": { "type": "string" },
            "valueName": { "type": "string" },
            "matchType": { "type": "string", "enum": ["Equals", "NotEquals", "Exists", "NotExists"] },
            "expectedValue": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "serviceName"],
          "properties": {
            "type": { "const": "Service" },
            "serviceName": { "type": "string" },
            "expectedStartup": { "type": "string", "enum": ["Automatic", "Manual", "Disabled"] },
            "expectedState": { "type": "string", "enum": ["Running", "Stopped"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "taskPath", "taskName", "expectedState"],
          "properties": {
            "type": { "const": "ScheduledTask" },
            "taskPath": { "type": "string" },
            "taskName": { "type": "string" },
            "expectedState": { "type": "string", "enum": ["Enabled", "Disabled"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "packagePattern", "expectedInstalled"],
          "properties": {
            "type": { "const": "Appx" },
            "packagePattern": { "type": "string" },
            "expectedInstalled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "featureName", "expectedEnabled"],
          "properties": {
            "type": { "const": "OptionalFeature" },
            "featureName": { "type": "string" },
            "expectedEnabled": { "type": "boolean" }
          }
        }
      ]
    },
    "actionItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "hive", "key", "operation"],
          "properties": {
            "type": { "enum": ["Registry", "Policy"] },
            "hive": { "type": "string", "enum": ["HKCU", "HKLM", "HKCR", "HKU"] },
            "key": { "type": "string" },
            "operation": { "type": "string", "enum": ["Set", "DeleteValue", "DeleteKey"] },
            "valueName": { "type": "string" },
            "valueKind": {
              "type": "string",
              "enum": ["DWord", "QWord", "String", "ExpandString", "MultiString", "Binary"]
            },
            "data": {}
          },
          "if": {
            "properties": { "operation": { "const": "Set" } }
          },
          "then": {
            "required": ["valueName", "valueKind", "data"]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "serviceName", "operation"],
          "properties": {
            "type": { "const": "Service" },
            "serviceName": { "type": "string" },
            "operation": { "type": "string", "enum": ["SetStartup", "Start", "Stop"] },
            "startupType": { "type": "string", "enum": ["Automatic", "Manual", "Disabled"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "taskPath", "taskName", "operation"],
          "properties": {
            "type": { "const": "ScheduledTask" },
            "taskPath": { "type": "string" },
            "taskName": { "type": "string" },
            "operation": { "type": "string", "enum": ["Enable", "Disable", "Delete"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "packagePattern", "operation"],
          "properties": {
            "type": { "const": "Appx" },
            "packagePattern": { "type": "string" },
            "allUsers": { "type": "boolean" },
            "operation": { "type": "string", "enum": ["Remove", "Restore"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "featureName", "operation"],
          "properties": {
            "type": { "const": "OptionalFeature" },
            "featureName": { "type": "string" },
            "operation": { "type": "string", "enum": ["Enable", "Disable"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operation", "arguments"],
          "properties": {
            "type": { "const": "PowerCfg" },
            "operation": { "type": "string", "enum": ["SetActivePlan", "SetSetting", "DuplicateScheme"] },
            "arguments": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pathPattern", "allowedRoot", "operation"],
          "properties": {
            "type": { "const": "File" },
            "pathPattern": { "type": "string" },
            "allowedRoot": {
              "type": "string",
              "enum": [
                "%TEMP%",
                "%LOCALAPPDATA%\\Temp",
                "%WINDIR%\\Temp",
                "%WINDIR%\\SoftwareDistribution\\Download"
              ]
            },
            "operation": { "type": "string", "enum": ["DeleteFiles", "EmptyFolder"] },
            "stopServicesBefore": {
              "type": "array",
              "items": { "type": "string" }
            },
            "startServicesAfter": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "script", "timeoutSeconds", "operation"],
          "properties": {
            "type": { "const": "PowerShell" },
            "script": { "type": "string" },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 900 },
            "operation": { "type": "string", "enum": ["Execute"] }
          }
        }
      ]
    }
  }
}
