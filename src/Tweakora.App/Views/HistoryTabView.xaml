<UserControl x:Class="Tweakora.App.Views.HistoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             xmlns:models="clr-namespace:Tweakora.Core.Models;assembly=Tweakora.Core"
             xmlns:interfaces="clr-namespace:Tweakora.Core.Interfaces;assembly=Tweakora.Core"
             AutomationProperties.AutomationId="HistoryTabView"
             AutomationProperties.Name="History and Rollback Journal">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & Global Actions -->
            <RowDefinition Height="*" />    <!-- Main 2-Column Workspace -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="History &amp; Rollback Journal" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Track every modification made by WinVelo with baseline snapshots and non-destructive rollbacks."
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Undo All WinVelo Changes -->
                <Button AutomationProperties.AutomationId="UndoAllWinVeloButton"
                        AutomationProperties.Name="Undo all WinVelo changes"
                        Content="Undo All WinVelo Changes" Style="{DynamicResource ModernSecondaryBtn}"
                        Command="{Binding UndoAllChangesCommand}" Margin="0,0,8,0" Padding="12,7" FontSize="12" />

                <!-- Create Restore Point -->
                <Button AutomationProperties.AutomationId="CreateRestorePointButton"
                        AutomationProperties.Name="Create restore point"
                        Content="Create Restore Point" Style="{DynamicResource ModernGhostBtn}"
                        Command="{Binding CreateRestorePointCommand}" Margin="0,0,8,0" Padding="10,7" FontSize="12" />

                <!-- Refresh -->
                <Button AutomationProperties.AutomationId="RefreshHistoryButton"
                        AutomationProperties.Name="Refresh history"
                        Content="Refresh" Style="{DynamicResource ModernGhostBtn}"
                        Command="{Binding RefreshHistoryCommand}" Padding="10,7" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- MAIN 2-COLUMN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" /> <!-- Left: Sessions & Restore Points -->
                <ColumnDefinition Width="*" />   <!-- Right: Selected Session Details & Tweaks -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: SESSIONS LIST & RESTORE POINTS -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="160" />
                </Grid.RowDefinitions>

                <!-- SESSIONS CARD -->
                <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="2,0,0,10">
                            <TextBlock Text="Journal Sessions" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                            <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding Sessions.Count, StringFormat='{}{0} recorded'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </DockPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}"
                                 SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="Recorded sessions list"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistorySessionCardModel}">
                                    <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StartedAtDisplay}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1"
                                                        Background="{Binding StatusBg}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding StatusFg}" />
                                                </Border>
                                            </DockPanel>

                                            <DockPanel Margin="0,0,0,4">
                                                <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,1" DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding TriggerSource}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding TotalActions, StringFormat='{}Actions: {0}'}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <TextBlock Text="{Binding DistinctTweaksSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="330" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- SPLITTER -->
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- RESTORE POINTS CARD -->
                <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="2,0,0,8">
                            <TextBlock Text="System Restore Points" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                            <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="10" Padding="8,1">
                                <TextBlock Text="{Binding RestorePoints.Count, StringFormat='{}{0} available'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </DockPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding RestorePoints}"
                                 Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="System restore points list"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type interfaces:RestorePointItem}">
                                    <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CreationTimeDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SequenceNumber, StringFormat='#{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: SELECTED SESSION ACTIONS & TWEAKS LIST -->
            <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Session Actions Bar -->
                        <RowDefinition Height="*" />    <!-- Tweaks & Actions List -->
                    </Grid.RowDefinitions>

                    <!-- Session Actions Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="{Binding SelectedSession.SessionId, StringFormat='Session ID: {0}'}"
                                               FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                    <Border Margin="8,0,0,0" Background="{Binding SelectedSession.StatusBg}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedSession.StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding SelectedSession.StatusFg}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="{Binding SelectedSession.DistinctTweaksSummary, StringFormat='Target Tweaks: {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="450" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Undo Session Button -->
                                <Button AutomationProperties.Name="Undo this session"
                                        AutomationProperties.AutomationId="UndoSessionButton"
                                        Content="Undo This Session" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding UndoSessionCommand}" CommandParameter="{Binding SelectedSession}"
                                        Margin="0,0,8,0" Padding="12,6" FontSize="12" />

                                <!-- Export Log Button -->
                                <Button AutomationProperties.Name="Export session log"
                                        AutomationProperties.AutomationId="ExportSessionLogButton"
                                        Content="Export Session Log (.txt)" Style="{DynamicResource ModernGhostBtn}"
                                        Command="{Binding ExportSessionLogCommand}" CommandParameter="{Binding SelectedSession}"
                                        Padding="10,6" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tweaks in Session List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedSession.Tweaks}"
                             Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Tweaks in selected session"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryTweakItemModel}">
                                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Tweak Header Row -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tweak Name & ID -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TweakName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding TweakId}" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Status chip -->
                                            <Border Grid.Column="1" Background="{Binding StatusBg}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="10,0,10,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusFg}" />
                                            </Border>

                                            <!-- Undo Tweak Button -->
                                            <Button Grid.Column="2" Content="Undo Tweak" Style="{DynamicResource ModernGhostBtn}"
                                                    AutomationProperties.Name="{Binding TweakName, StringFormat='Undo tweak {0}'}"
                                                    Command="{Binding DataContext.UndoTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding TweakId}"
                                                    Padding="10,4" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Actions sub-list -->
                                        <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" Padding="8,6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding Records}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:JournalActionRecord}">
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding ActionType}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                            </Border>

                                                            <TextBlock Grid.Column="1" Text="{Binding TargetIdentifier}" FontFamily="Consolas, Cascadia Code"
                                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                                                <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsBaseline, Converter={StaticResource BoolToVisConverter}}">
                                                                    <TextBlock Text="Baseline" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                                </Border>
                                                                <Border CornerRadius="3" Padding="4,1"
                                                                        Background="{Binding IsReverted, Converter={StaticResource BoolToVisConverter}, FallbackValue='#064E3B'}">
                                                                    <TextBlock Text="{Binding IsReverted, Converter={StaticResource BoolToVisConverter}}" FontSize="9" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
        </Border>

        <!-- EXPORT DIALOG OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
              Visibility="{Binding IsExportDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Width="720" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Session Log Export (.txt)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button DockPanel.Dock="Right" Content="Close" Style="{DynamicResource ModernGhostBtn}"
                                AutomationProperties.Name="Close export dialog"
                                Command="{Binding CloseExportDialogCommand}" />
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding ExportedLogContent}"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}" FontFamily="Consolas, Cascadia Code" FontSize="11" Padding="10" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Close" Style="{DynamicResource ModernSecondaryBtn}"
                                AutomationProperties.Name="Close export dialog"
                                Command="{Binding CloseExportDialogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
