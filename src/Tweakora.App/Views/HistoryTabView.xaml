<UserControl x:Class="Tweakora.App.Views.HistoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             xmlns:models="clr-namespace:Tweakora.Core.Models;assembly=Tweakora.Core"
             AutomationProperties.AutomationId="HistoryTabView"
             AutomationProperties.Name="History and Rollback Journal">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & Actions -->
            <RowDefinition Height="*" />    <!-- Main 2-Column Workspace -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="History &amp; Rollback Journal" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Track every modification made by WinVelo with baseline snapshots and non-destructive rollbacks."
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Undo All WinVelo Changes -->
                <Button AutomationProperties.AutomationId="UndoAllWinVeloButton"
                        Content="Undo All WinVelo Changes" Style="{DynamicResource ModernSecondaryBtn}"
                        Command="{Binding UndoAllChangesCommand}" Margin="0,0,8,0" Padding="12,7" FontSize="12" />

                <!-- Create Restore Point -->
                <Button Content="Create Restore Point" Style="{DynamicResource ModernGhostBtn}"
                        Command="{Binding CreateRestorePointCommand}" Margin="0,0,8,0" Padding="10,7" FontSize="12" />

                <!-- Refresh -->
                <Button Content="Refresh" Style="{DynamicResource ModernGhostBtn}"
                        Command="{Binding RefreshHistoryCommand}" Padding="10,7" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <!-- MAIN 2-COLUMN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" /> <!-- Left: Sessions List -->
                <ColumnDefinition Width="*" />   <!-- Right: Selected Session Details & Actions -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: SESSIONS LIST -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Recorded Sessions (Newest First)" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,10" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistorySessionCardModel}">
                                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding StartedAtDisplay}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource StatusAppliedBgBrush}" CornerRadius="4" Padding="6,1"
                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Completed" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusAppliedFgBrush}" />
                                            </Border>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4">
                                            <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,1" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding TriggerSource}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding TotalActions, StringFormat='{}Actions: {0}'}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding DistinctTweaksSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="330" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Restore Points / Snapshots Info Footer -->
                    <Border Grid.Row="2" Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="System Restore Status" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding RestorePointCount, StringFormat='Restore Points: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Snapshots.Count, StringFormat='Snapshots: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: SELECTED SESSION ACTIONS & CHRONOLOGICAL LOG -->
            <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Session Actions Bar -->
                        <RowDefinition Height="*" />    <!-- Recorded Actions List -->
                    </Grid.RowDefinitions>

                    <!-- Session Actions Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSession.SessionId, StringFormat='Session ID: {0}'}"
                                           FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedSession.DistinctTweaksSummary, StringFormat='Target Tweaks: {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="450" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Undo Session Button -->
                                <Button Content="Undo This Session" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding UndoSessionCommand}" CommandParameter="{Binding SelectedSession}"
                                        Margin="0,0,8,0" Padding="12,6" FontSize="12" />

                                <!-- Export Log Button -->
                                <Button Content="Export Session Log (.txt)" Style="{DynamicResource ModernGhostBtn}"
                                        Command="{Binding ExportSessionLogCommand}" CommandParameter="{Binding SelectedSession}"
                                        Padding="10,6" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Recorded Actions List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedSession.Records}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:JournalActionRecord}">
                                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status indicator badge -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0"
                                                Background="{DynamicResource StatusDefaultBgBrush}">
                                            <TextBlock Text="{Binding ActionType}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Border>

                                        <!-- Target details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding TweakId}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource StatusAppliedBgBrush}" CornerRadius="3" Padding="4,1"
                                                        Visibility="{Binding IsBaseline, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Baseline" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatusAppliedFgBrush}" />
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding TargetIdentifier}" FontFamily="Consolas, Cascadia Code"
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Row Action: Undo Tweak -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Button Content="Undo Tweak" Style="{DynamicResource ModernGhostBtn}"
                                                    Command="{Binding DataContext.UndoTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding TweakId}"
                                                    Padding="8,4" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
        </Border>

        <!-- EXPORT DIALOG OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
              Visibility="{Binding IsExportDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Width="720" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Session Log Export (.txt)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button DockPanel.Dock="Right" Content="Close" Style="{DynamicResource ModernGhostBtn}"
                                Command="{Binding CloseExportDialogCommand}" />
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding ExportedLogContent}"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}" FontFamily="Consolas, Cascadia Code" FontSize="11" Padding="10" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Close" Style="{DynamicResource ModernSecondaryBtn}"
                                Command="{Binding CloseExportDialogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
