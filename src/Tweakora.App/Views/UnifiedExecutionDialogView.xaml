<UserControl x:Class="Tweakora.App.Views.UnifiedExecutionDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             AutomationProperties.AutomationId="UnifiedExecutionDialogView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- 1. UNIFIED PREVIEW DIALOG MODAL -->
        <Grid Background="#99000000"
              Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="3100">
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Width="780" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75" />
                </Border.Effect>
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Layer24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                                AutomationProperties.Name="Close Preview Dialog"
                                Command="{Binding CancelPreviewCommand}" />
                    </DockPanel>

                    <!-- Description & Notice -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="{Binding PreviewDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info16" Foreground="#60A5FA" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PreviewNotice}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Loading State or Items List -->
                    <Grid Grid.Row="2">
                        <!-- Loading Indicator -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30"
                                    Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisConverter}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,10" />
                            <TextBlock Text="Analyzing system states..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Items ScrollViewer -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <ItemsControl ItemsSource="{Binding PreviewItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox (disabled if already applied in apply mode) -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                          AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          VerticalAlignment="Center" Margin="0,0,12,0" />

                                                <!-- Tweak Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" FontFamily="Consolas, Cascadia Code, Courier New" />
                                                        <TextBlock Text="{Binding ReversibleText, StringFormat='Reversible: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" />
                                                        <TextBlock Text="Reboot Required" FontSize="11" Foreground="#F87171" FontWeight="SemiBold" Margin="0,0,10,0"
                                                                   Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisConverter}}" />
                                                        <TextBlock Text="Restarts Explorer" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"
                                                                   ToolTip="Windows Explorer will be restarted automatically when this tweak is applied or undone"
                                                                   Visibility="{Binding RequiresExplorerRestart, Converter={StaticResource BoolToVisConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Status & Risk Badges -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- State Badge -->
                                                    <Border Background="{Binding StateBg}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StateFg}" />
                                                    </Border>

                                                    <!-- Risk Badge (Safe green / Low blue / Medium amber / High red) -->
                                                    <Border Background="{Binding RiskBadgeBg}" BorderBrush="{Binding RiskBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                        <TextBlock Text="{Binding Risk}" FontSize="10" FontWeight="Bold" Foreground="{Binding RiskBadgeFg}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,10,0"
                                   AutomationProperties.AutomationId="PreviewCancelButton"
                                   AutomationProperties.Name="Cancel Preview"
                                   Command="{Binding CancelPreviewCommand}" />
                        <ui:Button Content="{Binding PreviewConfirmText}" Appearance="Primary"
                                   AutomationProperties.AutomationId="PreviewConfirmButton"
                                   AutomationProperties.Name="{Binding PreviewConfirmText}"
                                   Command="{Binding ConfirmPreviewCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. UNIFIED RESULT DIALOG MODAL -->
        <Grid Background="#99000000"
              Visibility="{Binding IsResultOpen, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="3200">
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Width="740" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75" />
                </Border.Effect>
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#064E3B" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#10B981" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ResultTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                                AutomationProperties.Name="Close Result Dialog"
                                Command="{Binding CloseResultCommand}" />
                    </DockPanel>

                    <!-- Summary -->
                    <TextBlock Grid.Row="1" Text="{Binding ResultSummary}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <!-- Changed Tweaks List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <ItemsControl ItemsSource="{Binding ResultItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas, Cascadia Code, Courier New" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#F87171" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding HasReason, Converter={StaticResource BoolToVisConverter}}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{Binding StatusBg}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusFg}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Servicing Health Check Section -->
                    <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="8" Padding="12,10"
                            Background="{Binding IsServicingHealthy, Converter={StaticResource BoolToVisConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#064E3B" />
                                <Setter Property="BorderBrush" Value="#059669" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServicingHealthy}" Value="False">
                                        <Setter Property="Background" Value="#450A0A" />
                                        <Setter Property="BorderBrush" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#10B981" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Windows Servicing Health Check" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ServicingHealthSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding ServicingWarnings}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="Done" Appearance="Primary"
                                   AutomationProperties.Name="Done and Close Results"
                                   Command="{Binding CloseResultCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
