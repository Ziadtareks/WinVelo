<UserControl x:Class="Tweakora.App.Views.BackupsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.AutomationId="BackupsTabView">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="System Backups &amp; Snapshots" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Automated registry (.reg) snapshots and service state points created before modifying tweaks."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="Create New Snapshot" Style="{DynamicResource ModernSecondaryBtn}"
                        Command="{Binding CreateInstantBackupCommand}" Margin="0,0,8,0" />
                <Button Content="Open Folder" Style="{DynamicResource ModernGhostBtn}"
                        Command="{Binding OpenBackupsFolderCommand}" Margin="0,0,8,0" />
                <Button Content="Refresh" Style="{DynamicResource ModernGhostBtn}"
                        Command="{Binding RefreshBackupsCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Main Content (2 Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Backups List -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Available Snapshots" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,10" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Backups}"
                             SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}"
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                       DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} values'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding RegFileCount, StringFormat='{}{0} .reg exports'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Details & Restore Action -->
            <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Snapshot Details" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectedBackup.Description}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,16" />

                    <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedBackup.DirectoryPath, StringFormat='Directory: {0}'}"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedBackup.ItemCount, StringFormat='Total Target Entries: {0}'}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedBackup.RegFileCount, StringFormat='Exported .reg Files: {0}'}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Restore Selected Snapshot" Style="{DynamicResource ModernPrimaryBtn}"
                            Command="{Binding RestoreSelectedBackupCommand}"
                            HorizontalAlignment="Left" Padding="20,10" Margin="0,0,0,12" />

                    <TextBlock Text="⚠️ Restoring will overwrite modified Registry keys and Service startup states with their exact pre-tweak snapshot values."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
