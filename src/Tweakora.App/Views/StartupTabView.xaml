<UserControl x:Class="Tweakora.App.Views.StartupTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             xmlns:startup="clr-namespace:Tweakora.Modules.Startup;assembly=Tweakora.Modules"
             AutomationProperties.AutomationId="StartupTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Metrics Banner -->
            <RowDefinition Height="Auto" /> <!-- Filter & Action Bar -->
            <RowDefinition Height="*" />    <!-- Apps List -->
        </Grid.RowDefinitions>

        <!-- ==================== TOP METRICS & ANALYTICS BANNER ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Row: Title & Action -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Rocket24" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Startup Applications Manager" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Task Manager bi-directional sync &amp; boot speed optimizer (StartupApproved architecture)"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Top Action: 1-Click Optimize Startup -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ui:Button AutomationProperties.AutomationId="OptimizeStartupButton"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Flash24}"
                                   Content="1-Click Optimize Startup"
                                   Command="{Binding OptimizeStartupCommand}"
                                   Padding="14,8" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"
                                   ToolTip="Disable heavy non-essential apps to accelerate Windows boot time" />

                        <ui:Button AutomationProperties.AutomationId="RefreshStartupButton"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Content="Refresh"
                                   Command="{Binding RefreshCommandAsync}"
                                   Padding="10,8" FontSize="12" />
                    </StackPanel>
                </DockPanel>

                <!-- Metric Cards Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Total Apps -->
                    <Border Grid.Column="0" Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="TOTAL APPS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" DockPanel.Dock="Left" />
                                <ui:SymbolIcon Symbol="Apps24" Foreground="#94A3B8" FontSize="14" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,2" />
                            <TextBlock Text="Scanned across 5 sources" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Enabled Apps -->
                    <Border Grid.Column="1" Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ENABLED APPS" FontSize="10" FontWeight="Bold" Foreground="#10B981" DockPanel.Dock="Left" />
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#10B981" FontSize="14" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock Text="{Binding EnabledCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,2" />
                            <TextBlock Text="Active at user sign-in" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- Card 3: High Impact Apps -->
                    <Border Grid.Column="2" Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="HIGH IMPACT" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" DockPanel.Dock="Left" />
                                <ui:SymbolIcon Symbol="Flash24" Foreground="#F59E0B" FontSize="14" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock Text="{Binding HighImpactCount}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,2" />
                            <TextBlock Text="Heavy launchers &amp; services" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Estimated Boot Impact -->
                    <Border Grid.Column="3" Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="BOOT IMPACT" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" DockPanel.Dock="Left" />
                                <ui:SymbolIcon Symbol="Timer24" Foreground="#A78BFA" FontSize="14" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock Text="{Binding BootDelayText}" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding BootTimeSavedText}" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== FILTER & ACTION BAR ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <!-- Search Box -->
                <ui:TextBox AutomationProperties.AutomationId="StartupSearchBox"
                            PlaceholderText="Search startup apps by name, publisher, path, or impact..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"
                            Width="360" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center" />

                <!-- Filter Pills -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <ui:Button Content="All"
                               Command="{Binding SetFilterCommand}" CommandParameter="All"
                               Appearance="{Binding IsFilterAll, Converter={StaticResource BoolToVisConverter}}"
                               Padding="12,6" FontSize="12" Margin="0,0,6,0" />

                    <ui:Button Content="Enabled"
                               Command="{Binding SetFilterCommand}" CommandParameter="Enabled"
                               Padding="12,6" FontSize="12" Margin="0,0,6,0" />

                    <ui:Button Content="Disabled"
                               Command="{Binding SetFilterCommand}" CommandParameter="Disabled"
                               Padding="12,6" FontSize="12" Margin="0,0,6,0" />

                    <ui:Button Content="High Impact"
                               Command="{Binding SetFilterCommand}" CommandParameter="HighImpact"
                               Padding="12,6" FontSize="12" Margin="0,0,6,0" />
                </StackPanel>

                <!-- Status Message -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
            </DockPanel>
        </Border>

        <!-- ==================== STARTUP APPS LIST ==================== -->
        <ListBox Grid.Row="2"
                 AutomationProperties.AutomationId="StartupAppsListBox"
                 ItemsSource="{Binding FilteredApps}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type startup:StartupAppItem}">
                    <Border Background="#181B22" BorderBrush="#262B36" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- App Icon Tile -->
                                <ColumnDefinition Width="*" />    <!-- Name, Publisher, Command, Location -->
                                <ColumnDefinition Width="Auto" /> <!-- Impact Badge, Status, Open Folder, Switch -->
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Colored Icon Tile with Initial -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{Binding IconColor}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IconLetter}" Foreground="White" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Column 1: App Metadata -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <!-- Top Line: Name, Publisher, Source Pill, Essential Pill -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <TextBlock Text="{Binding Publisher}" FontSize="12" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Source Pill -->
                                    <Border Background="#20242D" BorderBrush="#2F3642" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#94A3B8" FontWeight="Medium" />
                                    </Border>

                                    <!-- System Essential Pill -->
                                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{Binding IsEssentialSystemItem, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark16" Foreground="#34D399" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="SYSTEM ESSENTIAL" FontSize="9" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Bottom Line: Clean Exe Path / Command + File Size -->
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding CleanExePath}" FontFamily="Consolas" FontSize="11"
                                               Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center" DockPanel.Dock="Left" />

                                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="#475569"
                                               Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Column 2: Right-hand Badges & Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Impact Badge -->
                                <Border CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1E293B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Impact}" Value="High">
                                                    <Setter Property="Background" Value="#7F1D1D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                    <Setter Property="Background" Value="#78350F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impact}" Value="Low">
                                                    <Setter Property="Background" Value="#1E293B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                <Setter Property="Text" Value="LOW IMPACT" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Impact}" Value="High">
                                                        <Setter Property="Foreground" Value="#F87171" />
                                                        <Setter Property="Text" Value="HIGH IMPACT" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                        <Setter Property="Text" Value="MEDIUM IMPACT" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Impact}" Value="Low">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Setter Property="Text" Value="LOW IMPACT" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Status Badge -->
                                <Border CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1E293B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Background" Value="#064E3B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Setter Property="Text" Value="DISABLED" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                        <Setter Property="Text" Value="ENABLED" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Open Folder Action Button -->
                                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}"
                                           Appearance="Transparent"
                                           Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Open in File Explorer"
                                           Padding="6" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <!-- Inline Progress Ring when toggling -->
                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsToggling, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Toggle Switch -->
                                <ui:ToggleSwitch AutomationProperties.AutomationId="{Binding Name, StringFormat='Toggle_{0}'}"
                                                 IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                 IsEnabled="{Binding IsNotToggling}"
                                                 Command="{Binding DataContext.ToggleAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}"
                                                 VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
