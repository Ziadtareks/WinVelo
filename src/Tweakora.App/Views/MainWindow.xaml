<ui:FluentWindow x:Class="Tweakora.App.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
                  xmlns:views="clr-namespace:Tweakora.App.Views"
                  xmlns:loc="clr-namespace:Tweakora.App.Localization"
                  Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}"
                  Height="820" Width="1240"
                  MinHeight="650" MinWidth="960"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  AutomationProperties.AutomationId="TweakoraMainWindow">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding ToggleCommandPaletteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- View Data Templates for the 5 Top Tabs -->
        <DataTemplate DataType="{x:Type vm:InstallViewModel}">
            <views:InstallTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <views:TweaksTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolboxViewModel}">
            <views:ToolboxPage />
        </DataTemplate>

        <!-- Legacy Data Templates for compatibility -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PresetsViewModel}">
            <views:PresetsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="Auto" /> <!-- Test Mode Warning Banner -->
            <RowDefinition Height="Auto" /> <!-- Top Horizontal Navigation Bar -->
            <RowDefinition Height="*" />    <!-- Main Active Tab Content -->
            <RowDefinition Height="Auto" /> <!-- Activity Log Panel -->
        </Grid.RowDefinitions>

        <!-- TitleBar with Search, Theme Toggle, Config Menu, Log Button -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Shield24" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <!-- Live Search Box (Filters Active Tab) -->
                    <ui:TextBox AutomationProperties.AutomationId="TopSearchBox"
                                PlaceholderText="Search active tab..."
                                Text="{Binding TopSearchText, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}"
                                Width="240" Margin="0,0,10,0" VerticalAlignment="Center" />

                    <!-- Command Palette Shortcut Button (Ctrl+K) -->
                    <ui:Button AutomationProperties.AutomationId="OpenCommandPaletteButton"
                               Icon="{ui:SymbolIcon AppGeneric24}"
                               ToolTip="Command Palette (Ctrl+K)"
                               Command="{Binding ToggleCommandPaletteCommand}"
                               Appearance="Transparent" Margin="0,0,4,0" />

                    <!-- Config / Settings Menu Button -->
                    <ui:Button AutomationProperties.AutomationId="ConfigMenuButton"
                               Icon="{ui:SymbolIcon Settings24}"
                               ToolTip="Config &amp; About"
                               Appearance="Transparent" Margin="0,0,4,0">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export Config JSON..." Command="{Binding ExportConfigCommand}" />
                                <MenuItem Header="Import Config JSON..." Command="{Binding ExportConfigCommand}" />
                                <Separator />
                                <MenuItem Header="About Tweakora" Command="{Binding OpenAboutDialogCommand}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>

                    <!-- Theme Toggle Button -->
                    <ui:Button AutomationProperties.AutomationId="ToggleThemeButton"
                               Icon="{ui:SymbolIcon DarkTheme24}"
                               ToolTip="Toggle Dark / Light Theme"
                               Command="{Binding ToggleThemeCommand}"
                               Appearance="Transparent" Margin="0,0,4,0" />

                    <!-- Activity Log Button -->
                    <ui:Button AutomationProperties.AutomationId="ToggleLogButton"
                               Icon="{ui:SymbolIcon DocumentBulletList24}"
                               ToolTip="Toggle Activity Log"
                               Command="{Binding ToggleLogPanelCommand}"
                               Appearance="Transparent" />

                    <TextBlock AutomationProperties.AutomationId="CurrentThemeText"
                               Text="{Binding CurrentThemeName}"
                               Width="0" Height="0" Opacity="0" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Test Mode Warning Banner -->
        <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding IsTestModeActive, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <ui:SymbolIcon Symbol="Warning24" Foreground="#856404" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AutomationId="TestModeBanner"
                           Text="TEST MODE ACTIVE — Simulated Platform Engine. Real Windows host system is untouched."
                           FontWeight="Bold" Foreground="#856404" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- TOP HORIZONTAL TAB BAR (Like WinUtil, Modernized) -->
        <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Brand Label -->
                    <TextBlock Text="TWEAKORA" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,24,0" />

                    <!-- TAB 1: INSTALL -->
                    <ui:Button AutomationProperties.AutomationId="Tab_Install"
                               Content="INSTALL" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Command="{Binding SwitchTabCommand}" CommandParameter="Install"
                               Margin="0,0,6,0" Padding="14,7" FontWeight="Bold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Install">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- TAB 2: TWEAKS -->
                    <ui:Button AutomationProperties.AutomationId="Tab_Tweaks"
                               Content="TWEAKS" Icon="{ui:SymbolIcon Wrench24}"
                               Command="{Binding SwitchTabCommand}" CommandParameter="Tweaks"
                               Margin="0,0,6,0" Padding="14,7" FontWeight="Bold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Tweaks">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- TAB 3: CONFIG -->
                    <ui:Button AutomationProperties.AutomationId="Tab_Config"
                               Content="CONFIG" Icon="{ui:SymbolIcon Settings24}"
                               Command="{Binding SwitchTabCommand}" CommandParameter="Config"
                               Margin="0,0,6,0" Padding="14,7" FontWeight="Bold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Config">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- TAB 4: UPDATES -->
                    <ui:Button AutomationProperties.AutomationId="Tab_Updates"
                               Content="UPDATES" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding SwitchTabCommand}" CommandParameter="Updates"
                               Margin="0,0,6,0" Padding="14,7" FontWeight="Bold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Updates">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- TAB 5: TOOLBOX -->
                    <ui:Button AutomationProperties.AutomationId="Tab_Toolbox"
                               Content="TOOLBOX" Icon="{ui:SymbolIcon Toolbox24}"
                               Command="{Binding SwitchTabCommand}" CommandParameter="Toolbox"
                               Margin="0,0,6,0" Padding="14,7" FontWeight="Bold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Toolbox">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>

                <!-- Right Side Info Label -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="v0.2.0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ui:Button Content="Config JSON" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Appearance="Transparent" Padding="8,4" FontSize="11"
                               Command="{Binding ExportConfigCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN PAGE CONTENT HOST -->
        <ContentControl Grid.Row="3" Content="{Binding CurrentPage}" />

        <!-- Collapsible Bottom Log Panel -->
        <Border Grid.Row="4" Height="140"
                Visibility="{Binding IsLogPanelOpen, Converter={StaticResource BoolToVisConverter}}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogTitle]}"
                               FontWeight="SemiBold" FontSize="13" />
                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                               Command="{Binding ToggleLogPanelCommand}" HorizontalAlignment="Right" Padding="4" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogSink.Messages}"
                         Background="Transparent" BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== COMMAND PALETTE (Ctrl+K) OVERLAY ==================== -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Background="#70000000"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Width="600" MaxHeight="450" VerticalAlignment="Top" Margin="0,60,0,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   AutomationProperties.AutomationId="CloseCommandPaletteButton"
                                   Command="{Binding ToggleCommandPaletteCommand}" Margin="8,0,0,0" />
                        <ui:TextBox AutomationProperties.AutomationId="CommandPaletteSearchBox"
                                    PlaceholderText="Search tabs, tweaks, tools, apps, and actions... (Ctrl+K)"
                                    Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteFirstPaletteItemCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="350" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PaletteResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button AutomationProperties.AutomationId="{Binding Title, StringFormat='PaletteItem_{0}'}"
                                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                               Appearance="Transparent"
                                               Margin="0,0,0,6" Padding="10"
                                               Command="{Binding DataContext.ExecutePaletteItemCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                               CommandParameter="{Binding}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                            </Border>
                                        </Grid>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== CONFIG JSON IMPORT/EXPORT MODAL ==================== -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Background="#70000000"
              Visibility="{Binding IsConfigDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Width="650" MaxHeight="500" VerticalAlignment="Center" Margin="20" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Configuration Profile JSON" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   Command="{Binding CloseConfigDialogCommand}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <TextBox Grid.Row="1" Text="{Binding ConfigDialogText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                             Padding="10" Margin="0,0,0,14" />

                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <TextBlock Text="Paste a JSON profile to import, or copy this text to export."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <ui:Button Content="Close" Command="{Binding CloseConfigDialogCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Apply &amp; Import Profile" Appearance="Primary"
                                       Command="{Binding ImportConfigCommand}" CommandParameter="{Binding ConfigDialogText}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ABOUT TWEAKORA MODAL ==================== -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Background="#70000000"
              Visibility="{Binding IsAboutDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Width="520" VerticalAlignment="Center" Margin="20" Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tweakora v0.2.0" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Professional Windows 10/11 Tweak &amp; Toolbox" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   Command="{Binding CloseAboutDialogCommand}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <TextBlock Text="Engine &amp; Safety Architecture:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="• Write-ahead rollback journal with baseline protection.&#x0a;• Dry-run diff preview before making changes.&#x0a;• Non-destructive simulated test mode.&#x0a;• .NET 10 LTS + WPF Fluent Modern UI."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />

                    <TextBlock Text="Attribution &amp; Credits:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="Based on ideas and tweak data from Chris Titus Tech's WinUtil (MIT License). Open source under the MIT License."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <DockPanel LastChildFill="False">
                        <ui:Button DockPanel.Dock="Right" Content="Close" Appearance="Primary" Command="{Binding CloseAboutDialogCommand}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
