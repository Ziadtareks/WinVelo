<ui:FluentWindow x:Class="Tweakora.App.Views.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
                   xmlns:views="clr-namespace:Tweakora.App.Views"
                   xmlns:loc="clr-namespace:Tweakora.App.Localization"
                   Title="WinVelo — Windows Velocity &amp; Performance Utility"
                   Height="860" Width="1360"
                   MinHeight="700" MinWidth="1080"
                   WindowStartupLocation="CenterScreen"
                   ExtendsContentIntoTitleBar="True"
                   AutomationProperties.AutomationId="TweakoraMainWindow">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding ToggleCommandPaletteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <views:TweaksTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallViewModel}">
            <views:InstallTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolboxViewModel}">
            <views:ToolboxPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupsViewModel}">
            <views:BackupsTabView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BgDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar (Row 0) -->
            <RowDefinition Height="Auto" /> <!-- Test Mode Warning Banner (Row 1) -->
            <RowDefinition Height="Auto" /> <!-- Admin Privilege Warning Banner (Row 2) -->
            <RowDefinition Height="*" />    <!-- Main Work Area with Sidebar & Workspace (Row 3) -->
        </Grid.RowDefinitions>

        <!-- TITLEBAR -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="WinVelo"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Shield24" Foreground="{DynamicResource AccentPrimaryBrush}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <!-- Command Palette Shortcut Button (Ctrl+K) -->
                    <ui:Button AutomationProperties.AutomationId="OpenCommandPaletteButton"
                               Icon="{ui:SymbolIcon Search24}"
                               ToolTip="Command Palette (Ctrl+K)"
                               Command="{Binding ToggleCommandPaletteCommand}"
                               Appearance="Transparent" Margin="0,0,4,0" />

                    <!-- Theme Toggle Button -->
                    <ui:Button AutomationProperties.AutomationId="ToggleThemeButton"
                               Icon="{ui:SymbolIcon DarkTheme24}"
                               ToolTip="Toggle Dark / Light Theme"
                               Command="{Binding ToggleThemeCommand}"
                               Appearance="Transparent" Margin="0,0,4,0" />

                    <!-- Config / Settings Menu Button -->
                    <ui:Button AutomationProperties.AutomationId="ConfigMenuButton"
                               Icon="{ui:SymbolIcon Settings24}"
                               ToolTip="Options &amp; About"
                               Appearance="Transparent" Margin="0,0,4,0">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export Config JSON..." Command="{Binding ExportConfigCommand}" />
                                <Separator />
                                <MenuItem Header="About WinVelo" Command="{Binding OpenAboutDialogCommand}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>

                    <TextBlock AutomationProperties.AutomationId="CurrentThemeText"
                               Text="{Binding CurrentThemeName}"
                               Width="0" Height="0" Opacity="0" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- TEST MODE WARNING BANNER -->
        <Border Grid.Row="1" AutomationProperties.AutomationId="TestModeBanner" AutomationProperties.Name="TEST MODE ACTIVE — Simulated Platform Engine. Real Windows host system is untouched." Background="#78350F" BorderBrush="#D97706" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding IsTestModeActive, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <ui:SymbolIcon Symbol="Warning24" Foreground="#FBBF24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AutomationId="TestModeBannerText"
                           AutomationProperties.Name="TEST MODE ACTIVE — Simulated Platform Engine. Real Windows host system is untouched."
                           Text="TEST MODE ACTIVE — Simulated Platform Engine. Real Windows host system is untouched."
                           FontWeight="Bold" Foreground="#FBBF24" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ADMIN PRIVILEGE WARNING BANNER -->
        <Border Grid.Row="2" Background="#7F1D1D" BorderBrush="#DC2626" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding IsMissingAdministratorPrivileges, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldError24" Foreground="#F87171" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock AutomationProperties.AutomationId="AdminWarningBanner"
                               Text="LIMITED ACCESS — WinVelo is running as a Standard User. Applying system tweaks and services requires Administrator privileges."
                               FontWeight="Bold" Foreground="#F87171" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Restart as Administrator"
                        AutomationProperties.AutomationId="RestartAsAdminButton"
                        Style="{DynamicResource ModernPrimaryBtn}" Command="{Binding RestartAsAdminCommand}"
                        Padding="12,5" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- MAIN LAYOUT: LEFT SIDEBAR + WORKSPACE -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" /> <!-- Left Sidebar Navigation -->
                <ColumnDefinition Width="*" />   <!-- Center & Bottom Workspace -->
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR ==================== -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Brand Logo & Title -->
                        <RowDefinition Height="*" />    <!-- Navigation Items -->
                        <RowDefinition Height="Auto" /> <!-- Sidebar Footer (Backups, System Info, Mode Switch) -->
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <DockPanel Grid.Row="0" Margin="4,0,4,16" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                <ui:SymbolIcon Symbol="Shield24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="WINVELO" FontSize="16" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </DockPanel>

                    <!-- Scrollable Navigation Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- OVERVIEW / QUICK START -->
                            <TextBlock Text="OVERVIEW" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="8,4,0,6" />

                            <!-- Home (Easy Boost) -->
                            <Button AutomationProperties.AutomationId="Tab_Dashboard"
                                    Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="Dashboard" Margin="0,0,0,8">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Home (Easy Boost)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="HOME" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </DockPanel>
                            </Button>

                            <!-- CATEGORIES SECTION -->
                            <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="8,4,0,6" />

                            <!-- All Tweaks -->
                            <Button AutomationProperties.AutomationId="Tab_Tweaks"
                                    Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding NavigateCategoryCommand}" CommandParameter="All">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="Apps24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="All Tweaks" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TweaksVM.AllCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </Button>

                            <!-- Essential Tweaks -->
                            <Button Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding NavigateCategoryCommand}" CommandParameter="Essential">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Essential Tweaks" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TweaksVM.EssentialCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </Button>

                            <!-- Privacy & Telemetry -->
                            <Button Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding NavigateCategoryCommand}" CommandParameter="Privacy">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="EyeOff24" FontSize="16" Margin="0,0,8,0" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <TextBlock Text="Privacy &amp; Telemetry" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TweaksVM.PrivacyCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </Button>

                            <!-- Performance -->
                            <Button Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding NavigateCategoryCommand}" CommandParameter="Performance">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="Flash24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource WarningAmberBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Performance" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TweaksVM.PerformanceCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </Button>

                            <!-- Windows UI & Customization -->
                            <Button Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding NavigateCategoryCommand}" CommandParameter="Customize UI">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="Color24" FontSize="16" Margin="0,0,8,0" Foreground="#A78BFA" VerticalAlignment="Center" />
                                        <TextBlock Text="Windows UI &amp; Style" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TweaksVM.CustomizeUiCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </Button>

                            <!-- Advanced / Caution -->
                            <Button Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding NavigateCategoryCommand}" CommandParameter="Advanced">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource CautionRedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Advanced / Caution" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TweaksVM.AdvancedCount}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DockPanel>
                            </Button>

                            <!-- SYSTEM TOOLS SECTION -->
                            <TextBlock Text="SYSTEM TOOLS" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="8,16,0,6" />

                            <!-- Install Apps (WinGet) -->
                            <Button AutomationProperties.AutomationId="Tab_Install"
                                    Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="Install">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Install Apps" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- System Config -->
                            <Button AutomationProperties.AutomationId="Tab_Config"
                                    Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="Config">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="System Config &amp; Fixes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Windows Updates -->
                            <Button AutomationProperties.AutomationId="Tab_Updates"
                                    Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="Updates">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Windows Updates" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Toolbox & Cleaner -->
                            <Button AutomationProperties.AutomationId="Tab_Toolbox"
                                    Style="{DynamicResource SidebarNavBtn}"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="Toolbox">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Toolbox24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Toolbox &amp; Cleaner" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer: Backups, Mode Switch & System Info -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <!-- Backups & Restore Navigation -->
                        <Button Style="{DynamicResource SidebarNavBtn}"
                                Command="{Binding SwitchTabCommand}" CommandParameter="Backups" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Backups &amp; Snapshots" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Dry-Run / Live Mode Switch -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Dry-Run Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding TweaksVM.IsDryRun, Mode=TwoWay}"
                                          Style="{DynamicResource ModernCheckBox}" ToolTip="When ON, actions are simulated without touching system" />
                            </DockPanel>
                        </Border>

                        <!-- System Info Summary Card -->
                        <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding SystemInfo.OsName}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"
                                               MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding SystemInfo.OsName}" />
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource StatusAppliedBgBrush}" CornerRadius="4" Padding="4,1"
                                            Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="ADMIN" FontSize="9" FontWeight="ExtraBold" Foreground="{DynamicResource StatusAppliedFgBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="{Binding SystemInfo.BuildNumber}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                <DockPanel LastChildFill="False" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SystemInfo.Architecture}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding SystemInfo.MemoryDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== CENTER & BOTTOM WORKSPACE ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Top Action Header: Live Search, Presets, Status Counter -->
                    <RowDefinition Height="*" />    <!-- Active View Content -->
                    <RowDefinition Height="Auto" /> <!-- Sticky Bottom Action Bar -->
                    <RowDefinition Height="Auto" /> <!-- Collapsible Live Log Drawer -->
                </Grid.RowDefinitions>

                <!-- TOP ACTION HEADER -->
                <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <DockPanel LastChildFill="False">
                        <!-- Left: Live Search Box -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <ui:TextBox AutomationProperties.AutomationId="TopSearchBox"
                                        PlaceholderText="Search tweaks by title, ID, or description..."
                                        Text="{Binding TopSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Icon="{ui:SymbolIcon Search24}"
                                        Width="320" Margin="0,0,14,0" VerticalAlignment="Center" />

                            <!-- Presets Toolbar -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Presets:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <Button AutomationProperties.AutomationId="Preset_Standard"
                                        Content="Standard (Recommended)" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding TweaksVM.ApplyPresetCommand}" CommandParameter="Standard"
                                        Margin="0,0,6,0" Padding="10,6" FontSize="12" />

                                <Button AutomationProperties.AutomationId="Preset_Minimal"
                                        Content="Minimal (Safe)" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding TweaksVM.ApplyPresetCommand}" CommandParameter="Minimal"
                                        Margin="0,0,6,0" Padding="10,6" FontSize="12" />

                                <Button Content="Select Applied" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding TweaksVM.ApplyPresetCommand}" CommandParameter="SelectApplied"
                                        Margin="0,0,6,0" Padding="10,6" FontSize="12" />

                                <Button AutomationProperties.AutomationId="Preset_Clear"
                                        Content="Clear" Style="{DynamicResource ModernGhostBtn}"
                                        Command="{Binding TweaksVM.ClearSelectionCommand}"
                                        Padding="8,6" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Status Counters & Diff Preview -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- Selected Counter Badge -->
                            <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TweaksVM.SelectedCount, StringFormat='Selected: {0}'}"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" FontSize="12" />
                            </Border>

                            <!-- Currently Applied Counter Badge -->
                            <Border Background="{DynamicResource StatusAppliedBgBrush}" BorderBrush="{DynamicResource StatusAppliedBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TweaksVM.AppliedCount, StringFormat='Applied on PC: {0}'}"
                                           Foreground="{DynamicResource StatusAppliedFgBrush}" FontWeight="Bold" FontSize="12" />
                            </Border>

                            <!-- Diff Preview Dialog Button -->
                            <Button AutomationProperties.AutomationId="PreviewTweaksButton"
                                    Content="Diff Preview" Style="{DynamicResource ModernGhostBtn}"
                                    Command="{Binding TweaksVM.OpenDiffPreviewCommand}"
                                    Padding="8,6" FontSize="12" ToolTip="Preview dry-run differences" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CENTER VIEW CONTENT HOST -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

                <!-- BOTTOM STICKY ACTION BAR -->
                <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <DockPanel LastChildFill="False">
                        <!-- Primary Operation Action Buttons -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <!-- Apply Selected Tweaks -->
                            <Button AutomationProperties.AutomationId="RunTweaksButton"
                                    Content="Apply Selected Tweaks" Style="{DynamicResource ModernPrimaryBtn}"
                                    Command="{Binding TweaksVM.ApplySelectedTweaksCommand}"
                                    Padding="18,9" FontSize="13" FontWeight="Bold" Margin="0,0,10,0" />

                            <!-- Undo Selected Tweaks -->
                            <Button AutomationProperties.AutomationId="UndoTweaksButton"
                                    Content="Undo Selected Tweaks" Style="{DynamicResource ModernSecondaryBtn}"
                                    Command="{Binding TweaksVM.UndoSelectedTweaksCommand}"
                                    Padding="14,9" FontSize="13" Margin="0,0,10,0" />

                            <!-- Re-Scan System -->
                            <Button Content="Re-Scan System" Style="{DynamicResource ModernGhostBtn}"
                                    Command="{Binding TweaksVM.RescanSystemCommand}"
                                    Padding="10,8" FontSize="12" Margin="0,0,6,0" ToolTip="Check active tweaks against real Windows state" />

                            <!-- Create Restore Point -->
                            <Button Content="Create Restore Point" Style="{DynamicResource ModernGhostBtn}"
                                    Command="{Binding TweaksVM.CreateRestorePointCommand}"
                                    Padding="10,8" FontSize="12" ToolTip="Create a Windows System Protection Restore point" />
                        </StackPanel>

                        <!-- Right: Execution Progress & Live Log Console Toggle -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- Active Operation Indicator -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding TweaksVM.IsBusy, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,16,0">
                                <ProgressBar Value="{Binding TweaksVM.ExecutionProgress}" Width="100" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Working..." FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Log Console Toggle Button -->
                            <Button AutomationProperties.AutomationId="ToggleLogButton"
                                    Style="{DynamicResource ModernSecondaryBtn}"
                                    Command="{Binding TweaksVM.ToggleLogDrawerCommand}"
                                    Padding="12,7" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TweaksVM.LogEntries.Count, StringFormat='Log Console ({0})'}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- COLLAPSIBLE LIVE EXECUTION LOG DRAWER -->
                <Border Grid.Row="3" Height="170"
                        Background="#0B0D13" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding TweaksVM.IsLogDrawerOpen, Converter={StaticResource BoolToVisConverter}}">
                    <Grid Margin="16,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Log Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Live Execution &amp; Detection Log" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding TweaksVM.StatusMessage}" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="Clear Log" Style="{DynamicResource ModernGhostBtn}"
                                        Command="{Binding TweaksVM.ClearLogsCommand}" Padding="6,3" FontSize="11" Margin="0,0,8,0" />
                                <Button Content="Close" Style="{DynamicResource ModernGhostBtn}"
                                        Command="{Binding TweaksVM.ToggleLogDrawerCommand}" Padding="6,3" FontSize="11" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Live Color-Coded Log List -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding TweaksVM.LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogEntryItem}">
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11"
                                                   DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <Border Background="{Binding BadgeBg}" CornerRadius="3" Padding="5,1"
                                                DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Level}" Foreground="{Binding BadgeFg}"
                                                       FontFamily="Consolas, Cascadia Code, Courier New" FontWeight="Bold" FontSize="10" />
                                        </Border>

                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- COMMAND PALETTE (Ctrl+K) OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#80000000"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Width="600" MaxHeight="450" VerticalAlignment="Top" Margin="0,60,0,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   Command="{Binding ToggleCommandPaletteCommand}" Margin="8,0,0,0" />
                        <ui:TextBox AutomationProperties.AutomationId="CommandPaletteSearchBox"
                                    PlaceholderText="Search tweaks, tools, apps, and actions... (Ctrl+K)"
                                    Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteFirstPaletteItemCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding PaletteResults}"
                             Background="Transparent" BorderThickness="0" MaxHeight="350">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteItem}">
                                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ExecutePaletteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ArrowRight24" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- DIFF PREVIEW DIALOG OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#80000000"
              Visibility="{Binding TweaksVM.IsPreviewDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Width="750" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Dry-Run Diff Preview" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button DockPanel.Dock="Right" Content="Cancel" Style="{DynamicResource ModernGhostBtn}"
                                Command="{Binding TweaksVM.CloseDiffPreviewCommand}" />
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding TweaksVM.PreviewReportText}"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderSubtleBrush}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Padding="10" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Close" Style="{DynamicResource ModernSecondaryBtn}"
                                Command="{Binding TweaksVM.CloseDiffPreviewCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- SLEEK FLOATING LIVE ACTIVITY HUD PILL -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,52,0,0"
                Background="#1E2433"
                BorderBrush="#3B82F6"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16,8"
                Panel.ZIndex="1000"
                IsHitTestVisible="False"
                Visibility="{Binding IsActivityVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Running Animated Progress Ring -->
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                 Margin="0,0,10,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsActivityRunning, Converter={StaticResource BoolToVisConverter}}" />

                <!-- Emerald Green Success Icon -->
                <TextBlock Text="✓" FontSize="14" FontWeight="ExtraBold" Foreground="#10B981"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           Visibility="{Binding IsActivitySuccess, Converter={StaticResource BoolToVisConverter}}" />

                <!-- Dynamic Status / Action Text -->
                <TextBlock Text="{Binding ActivityText}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
