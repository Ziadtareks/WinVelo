<ui:FluentWindow x:Class="Tweakora.App.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
                  xmlns:views="clr-namespace:Tweakora.App.Views"
                  xmlns:loc="clr-namespace:Tweakora.App.Localization"
                  Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}"
                  Height="780" Width="1180"
                  MinHeight="600" MinWidth="900"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  AutomationProperties.AutomationId="TweakoraMainWindow">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding ToggleCommandPaletteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <views:TweaksPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolboxViewModel}">
            <views:ToolboxPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}">
            <views:AppsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PresetsViewModel}">
            <views:PresetsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="Auto" /> <!-- Test Mode Warning Banner -->
            <RowDefinition Height="*" />    <!-- Main Workspace (Nav + Page Content) -->
            <RowDefinition Height="Auto" /> <!-- Activity Log Panel -->
        </Grid.RowDefinitions>

        <!-- Fluent Titlebar with Icon, Title, and Action Buttons -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Shield24" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <ui:Button AutomationProperties.AutomationId="OpenCommandPaletteButton"
                               Icon="{ui:SymbolIcon Search24}"
                               ToolTip="Command Palette &amp; Search (Ctrl+K)"
                               Command="{Binding ToggleCommandPaletteCommand}"
                               Appearance="Transparent" Margin="0,0,4,0" />
                    <ui:Button AutomationProperties.AutomationId="ToggleThemeButton"
                               Icon="{ui:SymbolIcon DarkTheme24}"
                               ToolTip="Toggle Dark / Light Theme"
                               Command="{Binding ToggleThemeCommand}"
                               Appearance="Transparent" Margin="0,0,4,0" />
                    <ui:Button AutomationProperties.AutomationId="ToggleLogButton"
                               Icon="{ui:SymbolIcon DocumentBulletList24}"
                               ToolTip="Toggle Activity Log"
                               Command="{Binding ToggleLogPanelCommand}"
                               Appearance="Transparent" />
                    <TextBlock AutomationProperties.AutomationId="CurrentThemeText"
                               Text="{Binding CurrentThemeName}"
                               Width="0" Height="0" Opacity="0" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Test Mode Warning Banner (Visible when simulated platform is active) -->
        <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding IsTestModeActive, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <ui:SymbolIcon Symbol="Warning24" Foreground="#856404" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AutomationId="TestModeBanner"
                           Text="TEST MODE ACTIVE — Simulated Platform Engine. Real Windows system is untouched."
                           FontWeight="Bold" Foreground="#856404" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Main Workspace: Left Nav + Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Rail -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="8,16,8,8">
                        <!-- Brand Header -->
                        <TextBlock Text="Tweakora" FontSize="18" FontWeight="Bold" Margin="12,0,0,16"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                        <!-- Nav Buttons with AutomationProperties -->
                        <ui:Button AutomationProperties.AutomationId="Nav_Dashboard"
                                   Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NavHome]}"
                                   Icon="{ui:SymbolIcon Home24}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Margin="0,0,0,4"
                                   Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />

                        <ui:Button AutomationProperties.AutomationId="Nav_Tweaks"
                                   Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NavTweaks]}"
                                   Icon="{ui:SymbolIcon Wrench24}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Margin="0,0,0,4"
                                   Command="{Binding NavigateCommand}" CommandParameter="Tweaks" />

                        <ui:Button AutomationProperties.AutomationId="Nav_Toolbox"
                                   Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NavTools]}"
                                   Icon="{ui:SymbolIcon Toolbox24}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Margin="0,0,0,4"
                                   Command="{Binding NavigateCommand}" CommandParameter="Toolbox" />

                        <ui:Button AutomationProperties.AutomationId="Nav_Apps"
                                   Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NavApps]}"
                                   Icon="{ui:SymbolIcon Apps24}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Margin="0,0,0,4"
                                   Command="{Binding NavigateCommand}" CommandParameter="Apps" />

                        <ui:Button AutomationProperties.AutomationId="Nav_Presets"
                                   Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NavPresets]}"
                                   Icon="{ui:SymbolIcon Bookmark24}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Margin="0,0,0,4"
                                   Command="{Binding NavigateCommand}" CommandParameter="Presets" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,16">
                        <ui:Button AutomationProperties.AutomationId="Nav_Settings"
                                   Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NavSettings]}"
                                   Icon="{ui:SymbolIcon Settings24}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent"
                                   Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page Content Host -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Collapsible Bottom Log Panel -->
        <Border Grid.Row="3" Height="140"
                Visibility="{Binding IsLogPanelOpen, Converter={StaticResource BoolToVisConverter}}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogTitle]}"
                               FontWeight="SemiBold" FontSize="13" />
                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                               Command="{Binding ToggleLogPanelCommand}" HorizontalAlignment="Right" Padding="4" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding LogSink.Messages}"
                         Background="Transparent" BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== COMMAND PALETTE (Ctrl+K) OVERLAY ==================== -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#70000000"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Width="600" MaxHeight="450" VerticalAlignment="Top" Margin="0,60,0,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Search Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   AutomationProperties.AutomationId="CloseCommandPaletteButton"
                                   Command="{Binding ToggleCommandPaletteCommand}" Margin="8,0,0,0" />
                        <ui:TextBox AutomationProperties.AutomationId="CommandPaletteSearchBox"
                                    PlaceholderText="Search tweaks, tools, apps, and actions... (Ctrl+K)"
                                    Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Icon="{ui:SymbolIcon Search24}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteFirstPaletteItemCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>

                    <!-- Results List -->
                    <ScrollViewer Grid.Row="1" MaxHeight="350" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PaletteResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button AutomationProperties.AutomationId="{Binding Title, StringFormat='PaletteItem_{0}'}"
                                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                               Appearance="Transparent"
                                               Margin="0,0,0,6" Padding="10"
                                               Command="{Binding DataContext.ExecutePaletteItemCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                               CommandParameter="{Binding}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                            </Border>
                                        </Grid>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
