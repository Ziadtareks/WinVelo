<UserControl x:Class="Tweakora.App.Views.ToolsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             AutomationProperties.AutomationId="ToolsTabView"
             AutomationProperties.Name="System Tools and Utilities">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1180" HorizontalAlignment="Stretch">
            <!-- OVERVIEW: Grid of Tool Tiles (Visible when no subtool is active) -->
            <Border Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="System Tools &amp; Diagnostics"
                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Integrated Windows maintenance, service controls, network tuning, and repair utilities."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" />

                    <!-- Grid of 8 Tool Tiles -->
                    <UniformGrid Columns="3" Margin="0,0,0,24">
                        <!-- 1. Startup Apps -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Startup Apps" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="Inspect apps that launch automatically on login. Disabling unnecessary items speeds up boot."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Startup" AutomationProperties.Name="Startup Applications"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Startup" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 2. Windows Services -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Server24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Windows Services" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="Audit system background services with safety shielding against disabling essential components."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Services" AutomationProperties.Name="Windows Services"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Services" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 3. Safe Cache Cleaner -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Broom24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Cleaner" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="Safely remove temporary clutter, Windows update caches, and application logs to reclaim space."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Cleaner" AutomationProperties.Name="Safe Cache Cleaner"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Cleaner" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 4. DNS Switcher -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="DNS &amp; Network" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="Benchmark response latency across privacy-first DNS providers and switch adapters with one click."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_DNS" AutomationProperties.Name="DNS Switcher"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="DNS" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 5. Quick Fixes -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Wrench24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Fixes &amp; Repairs" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="One-click diagnosis and repair for common Windows issues: search indexing, print spooler, and network."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Fixes" AutomationProperties.Name="Quick System Fixes"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Fixes" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 6. Windows Updates -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Windows Updates" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="Control update policies, driver exclusions, and reboot notification behavior without breaking security patches."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Updates" AutomationProperties.Name="Windows Updates Mode"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Updates" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 7. Optional Features -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="CheckboxChecked24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Optional Features" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="Enable or remove Windows optional components like Hyper-V, WSL, and legacy subsystems."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Features" AutomationProperties.Name="Optional Features"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Features" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 8. Restore Points -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="History24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Restore Points" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="Create and inspect Windows System Protection checkpoints to safeguard your PC."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_RestorePoints" AutomationProperties.Name="Restore Points"
                                        Content="Open Tool →" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="RestorePoints" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- SUBTOOL VIEW: Header with Back button and Quick Switcher (Visible when inside a tool) -->
            <Border Visibility="{Binding IsSubtoolOpen, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <DockPanel LastChildFill="False">
                        <!-- Back Button -->
                        <Button DockPanel.Dock="Left" AutomationProperties.Name="Back to Tools"
                                Content="← Back to Tools" Style="{DynamicResource ModernSecondaryBtn}"
                                Command="{Binding BackToOverviewCommand}" Margin="0,0,16,0" Padding="14,6" VerticalAlignment="Center" />

                        <!-- Compact Tool Switcher Bar -->
                        <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button AutomationProperties.Name="Startup Applications"
                                    Content="Startup Apps" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Startup" />
                            <Button AutomationProperties.Name="Windows Services"
                                    Content="Services" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Services" />
                            <Button AutomationProperties.Name="Safe Cache Cleaner"
                                    Content="Cleaner" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Cleaner" />
                            <Button AutomationProperties.Name="DNS Switcher"
                                    Content="DNS &amp; Network" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="DNS" />
                            <Button AutomationProperties.Name="Quick System Fixes"
                                    Content="Fixes &amp; Repairs" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Fixes" />
                            <Button AutomationProperties.Name="Windows Updates Mode"
                                    Content="Updates" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Updates" />
                            <Button AutomationProperties.Name="Optional Features"
                                    Content="Features" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Features" />
                            <Button AutomationProperties.Name="Restore Points"
                                    Content="Restore Points" Style="{DynamicResource ModernGhostBtn}"
                                    Command="{Binding SelectToolCommand}" CommandParameter="RestorePoints" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- ==================== 1. STARTUP APPS ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Startup">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Startup Applications Manager" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Review apps that launch automatically when you sign in. Disabling unused startup items reduces login delay."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Optimize Startup Apps"
                                    AutomationProperties.Name="Optimize Startup Apps"
                                    Style="{DynamicResource ModernPrimaryBtn}"
                                    Command="{Binding StartupVM.OptimizeStartupCommand}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding StartupVM.FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Impact, StringFormat='Impact: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Toggle startup for {0}'}"
                                                  Style="{DynamicResource ModernCheckBox}"
                                                  Command="{Binding DataContext.StartupVM.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 2. SERVICES ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Services">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Windows Services Inspector" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Inspect system background services. Protected servicing components are shielded from disabling."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.ServicesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ServiceName, StringFormat='ID: {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Grid.Column="3" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StartupType, StringFormat='Startup: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 3. CLEANER ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Cleaner">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Safe Cache &amp; Temporary File Cleaner" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Scans only whitelisted locations (%TEMP%, %WINDIR%\Temp, Update Download Cache). Preview size before cleaning."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding ToolboxVM.CleanerStatusText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Scan Now" AutomationProperties.Name="Scan Cache Now" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ToolboxVM.ScanCleanerCommand}" Margin="0,0,8,0" />
                                <Button Content="Clean Selected" AutomationProperties.Name="Clean Selected Items" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding ToolboxVM.CleanNowCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.CleanerCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding PathDescription}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 4. DNS & NETWORK ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="DNS">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Secure DNS &amp; Latency Benchmark" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Test response times to major DNS providers and apply the lowest latency resolver."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding ToolboxVM.DnsStatusText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Benchmark All" AutomationProperties.Name="Benchmark All DNS Providers" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ToolboxVM.BenchmarkAllDnsCommand}" Margin="0,0,8,0" />
                                <Button Content="Apply Fastest" AutomationProperties.Name="Apply Fastest DNS" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding ToolboxVM.ApplyFastestDnsCommand}" Margin="0,0,8,0" />
                                <Button Content="Reset to DHCP" AutomationProperties.Name="Reset DNS to DHCP" Style="{DynamicResource ModernGhostBtn}"
                                        Command="{Binding ToolboxVM.ResetDnsToDhcpCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Nagle's Algorithm Toggle -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="TCP Latency: Nagle's Algorithm (Global TCPNoDelay)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Sets TcpAckFrequency=1 and TCPNoDelay=1 on network adapters. Note: Most modern games manage TCP_NODELAY per-socket."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" AutomationProperties.Name="Disable Nagle's Algorithm Toggle" IsChecked="{Binding ToolboxVM.IsNagleDisabled, Mode=TwoWay}"
                                      Style="{DynamicResource ModernCheckBox}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.DnsProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <Border Background="#107C41" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Active" FontSize="10" Foreground="White" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrimaryDns, StringFormat='Primary: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0" />
                                                <TextBlock Text="{Binding SecondaryDns, StringFormat='Secondary: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0" />
                                                <TextBlock Text="{Binding PingMs, StringFormat='Latency: {0} ms'}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Ping" AutomationProperties.Name="{Binding Name, StringFormat='Ping {0}'}" Style="{DynamicResource ModernGhostBtn}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToolboxVM.TestDnsLatencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Content="Apply" AutomationProperties.Name="{Binding Name, StringFormat='Apply {0} DNS'}" Style="{DynamicResource ModernSecondaryBtn}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToolboxVM.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 5. FIXES & REPAIRS ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Fixes">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Windows Repairs &amp; Diagnostic Fixes" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="One-click repairs for common Windows component corruptions, network stack issues, and system file integrity."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.FixesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <Border Background="{DynamicResource BgDeepBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Script, StringFormat='Command: {0}'}" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Run Repair" AutomationProperties.Name="{Binding Title, StringFormat='Run Repair: {0}'}" Style="{DynamicResource ModernPrimaryBtn}" VerticalAlignment="Center" Margin="14,0,0,0"
                                                Command="{Binding DataContext.ToolboxVM.RunFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 6. WINDOWS UPDATES ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Updates">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Windows Update Configuration" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Select an honest update policy. Security updates can be delayed without disabling the servicing stack."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdatesVM.ActiveModeTitle, StringFormat='Current: {0}'}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Update Mode Cards (Default, Recommended, Suspended) -->
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <!-- Mode 1: Default -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Default (Out of Box)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Standard Microsoft automatic updates." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,10" />
                                <TextBlock Text="• Automatically checks and downloads all updates." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="• Driver updates included via Windows Update." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
                                <Button Content="Apply Default Mode" AutomationProperties.Name="Apply Default Update Mode" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding UpdatesVM.ApplyModeCommand}" CommandParameter="Default" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- Mode 2: Recommended -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Recommended (Security First)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="Delays feature updates by 2-3 years while keeping security patches." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,10" />
                                <TextBlock Text="• Critical security patches installed." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="• Prevents unexpected reboot interruptions." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
                                <Button Content="Apply Recommended" AutomationProperties.Name="Apply Recommended Update Mode" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding UpdatesVM.ApplyModeCommand}" CommandParameter="Recommended" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- Mode 3: Suspended -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Suspended (Manual Only)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource CautionRedBrush}" />
                                <TextBlock Text="Pauses automatic checks; updates only when you trigger manually." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,10" />
                                <TextBlock Text="• No background update scans or downloads." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="• Servicing stack remains intact and functional." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
                                <Button Content="Apply Suspended" AutomationProperties.Name="Apply Suspended Update Mode" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding UpdatesVM.ApplyModeCommand}" CommandParameter="Suspended" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ==================== 7. OPTIONAL FEATURES ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Features">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Windows Optional Features" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Enable or disable optional system components such as WSL, Hyper-V, Windows Sandbox, and virtualization."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Enable Selected" AutomationProperties.Name="Enable Selected Features" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding ConfigVM.InstallSelectedFeaturesCommand}" Margin="0,0,8,0" />
                                <Button Content="Disable Selected" AutomationProperties.Name="Disable Selected Features" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ConfigVM.UninstallSelectedFeaturesCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ConfigVM.Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Background="{DynamicResource StatusDefaultBgBrush}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 8. RESTORE POINTS ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="RestorePoints">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Windows System Protection (Restore Points)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Create manual checkpoints using Windows System Protection to safeguard system state before making configuration changes."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,10" />

                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource StatusAppliedBgBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding RestorePointCount, StringFormat='Restore Points Found: {0}'}"
                                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource StatusAppliedFgBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding RestoreStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel LastChildFill="False">
                                <TextBox DockPanel.Dock="Left" Width="360"
                                         AutomationProperties.Name="Restore Point Description Input"
                                         Text="{Binding RestorePointDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,6" Margin="0,0,10,0"
                                         Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}" />
                                <Button DockPanel.Dock="Left" Content="Create Restore Point"
                                        AutomationProperties.Name="Create Restore Point"
                                        Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding CreateRestorePointCommand}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
