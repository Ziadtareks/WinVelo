<UserControl x:Class="Tweakora.App.Views.InstallTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             AutomationProperties.AutomationId="InstallTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Action Bar -->
            <RowDefinition Height="Auto" /> <!-- Category Filter Bar -->
            <RowDefinition Height="*" />    <!-- Apps Grid -->
            <RowDefinition Height="Auto" /> <!-- Progress & Log Bar -->
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Package Manager Selector -->
                    <TextBlock Text="Package Manager:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <ComboBox SelectedValue="{Binding PackageManager, Mode=TwoWay}" Width="120" Margin="0,0,16,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="WinGet" IsSelected="True" />
                        <ComboBoxItem Content="Chocolatey" />
                    </ComboBox>

                    <!-- Action Buttons -->
                    <ui:Button AutomationProperties.AutomationId="InstallSelectedButton"
                               Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Content="Install Selected" Command="{Binding InstallSelectedCommand}"
                               IsEnabled="{Binding IsBusy, Converter={x:Null}}" Margin="0,0,8,0" />

                    <ui:Button AutomationProperties.AutomationId="UninstallSelectedButton"
                               Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}"
                               Content="Uninstall Selected" Command="{Binding UninstallSelectedCommand}"
                               IsEnabled="{Binding IsBusy, Converter={x:Null}}" Margin="0,0,8,0" />

                    <ui:Button AutomationProperties.AutomationId="UpgradeAllButton"
                               Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}"
                               Content="Upgrade All" Command="{Binding UpgradeAllCommand}"
                               Margin="0,0,8,0" />

                    <ui:Button AutomationProperties.AutomationId="ClearAppSelectionButton"
                               Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}"
                               Content="Clear Selection" Command="{Binding ClearSelectionCommand}" />
                </StackPanel>

                <!-- Selected Counter Badge -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount, StringFormat='{}Selected: {0}'}"
                               Foreground="White" FontWeight="Bold" FontSize="12" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Category Filter Chips / Bar -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Content="{Binding}" Margin="0,0,6,0" Padding="12,5"
                                   Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Apps List (Dense Multi-Column Grid) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding FilteredApps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="280" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Margin="4" Padding="10,8"
                                ToolTip="{Binding Description}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- App Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="{Binding Key, StringFormat='AppCheck_{0}'}"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />

                                <!-- App Name & Category -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <Border Visibility="{Binding IsFoss, Converter={StaticResource BoolToVis}}"
                                                Background="#E6F4EA" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                            <TextBlock Text="FOSS" FontSize="9" FontWeight="Bold" Foreground="#137333" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Website / Info Link Button -->
                                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="4"
                                           Icon="{ui:SymbolIcon Globe20}" ToolTip="Open official project website"
                                           Command="{Binding DataContext.OpenAppWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Progress and Output Log Bar -->
        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,6">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressBar HorizontalAlignment="Right" Width="150" Height="10"
                                 Value="{Binding ProgressPercent}" Maximum="100" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
