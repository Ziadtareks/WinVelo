<UserControl x:Class="Tweakora.App.Views.DashboardTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             AutomationProperties.AutomationId="DashboardTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- ==================== SYSTEM HEALTH BANNER ==================== -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Welcome & Admin Badge & Restore Point -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="System Health &amp; Velocity Dashboard" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Real-time hardware status and 1-click optimization center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Admin Status Pill & Restore Point Button -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- Admin Badge -->
                            <Border Background="{Binding AdminBadgeBg}" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Shield20" Foreground="{Binding AdminBadgeFg}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AdminStatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding AdminBadgeFg}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Create Restore Point Button -->
                            <ui:Button AutomationProperties.AutomationId="CreateRestorePointButton"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon History24}"
                                       Content="Create Restore Point"
                                       Command="{Binding CreateRestorePointCommand}"
                                       Padding="12,6" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Middle Row: Smart Hardware Advisor & Optimization Score Banner -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Settings Meter -->
                            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConfiguredSettingsPercentage, StringFormat='{}{0}%'}" FontSize="17" FontWeight="ExtraBold" Foreground="{Binding ConfiguredSettingsBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="SETTINGS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Advisor Details & Progress Bar -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="Configured System Settings: " FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ConfiguredSettingsStatusText}" FontSize="13" FontWeight="Bold" Foreground="{Binding ConfiguredSettingsBrush}" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ConfiguredSettingsDetailText}" FontSize="11" Foreground="#94A3B8" />
                                </DockPanel>
                                <ProgressBar Value="{Binding ConfiguredSettingsPercentage}" Maximum="100" Height="6" Margin="0,2,0,5" Foreground="{Binding ConfiguredSettingsBrush}" Background="#1E293B" BorderThickness="0" />
                                <TextBlock Text="{Binding SmartAdvisorSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Smart Analyze & Optimize Button -->
                            <!-- Smart Analyze & Optimize Button -->
                            <ui:Button Grid.Column="2"
                                       AutomationProperties.AutomationId="SmartAnalyzeOptimizeButton"
                                       Appearance="Primary"
                                       Command="{Binding SmartAnalyzeAndOptimizeCommand}"
                                       IsEnabled="{Binding IsNotSmartOptimizing}"
                                       Padding="14,8"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                     Foreground="#FFFFFF"
                                                     Visibility="{Binding IsSmartOptimizing, Converter={StaticResource BoolToVisConverter}}" />
                                    <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,8,0"
                                                   Visibility="{Binding IsNotSmartOptimizing, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="Smart Analyze &amp; Optimize" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- Bottom Row: 3 Hardware Cards (OS, CPU, RAM) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- OS & Device Card -->
                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="Desktop24" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="OPERATING SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SystemInfo.OsName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SystemInfo.BuildNumber, StringFormat='{}Host: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- CPU Card -->
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,0,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="DeveloperBoard24" Foreground="#38BDF8" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="PROCESSOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SystemInfo.ProcessorName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SystemInfo.Architecture}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- RAM Card with Progress Bar and Free Up RAM Button -->
                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="8,0,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Memory16" Foreground="#34D399" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                                        <!-- Sleek Pulsing Green LIVE Badge -->
                                        <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.8" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <TextBlock Text="LIVE" FontSize="9" FontWeight="ExtraBold" Foreground="#10B981" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RamUsagePercentage, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{Binding RamBarColor}" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Primary & Subtitle RAM Telemetry -->
                                <TextBlock Text="{Binding RamUsageText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding AvailableRamText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                <ProgressBar Value="{Binding RamUsagePercentage}" Maximum="100" Height="6" Margin="0,6,0,8" Foreground="{Binding RamBarColor}" Background="#1E293B" BorderThickness="0" />

                                <!-- Free Up RAM Button -->
                                <ui:Button AutomationProperties.AutomationId="PurgeRamButton"
                                           Command="{Binding FreeUpRamCommand}"
                                           IsEnabled="{Binding IsNotPurgingRam}"
                                           Appearance="Secondary"
                                           FontSize="11"
                                           Padding="8,4"
                                           HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0"
                                                         Foreground="{DynamicResource AccentPrimaryBrush}"
                                                         Visibility="{Binding IsPurgingRam, Converter={StaticResource BoolToVisConverter}}" />
                                        <ui:SymbolIcon Symbol="Broom16" Margin="0,0,6,0"
                                                       Visibility="{Binding IsNotPurgingRam, Converter={StaticResource BoolToVisConverter}}" />
                                        <TextBlock Text="Free Up RAM (Purge Cache)" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Global Status Bar Message (if any) -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,24">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GlobalStatusMessage}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Style="{DynamicResource ModernGhostBtn}"
                                Padding="4,1" Margin="6,0,0,0"
                                Visibility="{Binding HasFailedDetails, Converter={StaticResource BoolToVisConverter}}"
                                Command="{Binding ShowDetailsDialogCommand}">
                            <TextBlock Text="(details)" FontSize="11" Foreground="#60A5FA" TextDecorations="Underline" />
                        </Button>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RestorePointStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ==================== 1-CLICK PROFILES SECTION ==================== -->
            <TextBlock Text="1-CLICK SMART OPTIMIZATION PROFILES" FontSize="14" FontWeight="ExtraBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,12" />

            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,0,28">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Header: Icon, Title, Badge -->
                                    <RowDefinition Height="*" />    <!-- Description -->
                                    <RowDefinition Height="Auto" /> <!-- Impact / Tweak Count -->
                                    <RowDefinition Height="Auto" /> <!-- Action Button & Status -->
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                            <ui:SymbolIcon Symbol="{Binding IconSymbol}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding TweakCountText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right" Background="{Binding BadgeBg}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeFg}" />
                                    </Border>
                                </DockPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18" />

                                <!-- Impact Badge -->
                                <DockPanel Grid.Row="2" Margin="0,0,0,14" LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <ui:SymbolIcon Symbol="Sparkle20" Foreground="#FBBF24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ImpactText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Button & Status Message -->
                                <DockPanel Grid.Row="3" LastChildFill="False">
                                    <ui:Button DockPanel.Dock="Left"
                                               Appearance="Primary"
                                               AutomationProperties.AutomationId="{Binding Id, StringFormat='ProfileBtn_{0}'}"
                                               Content="{Binding ButtonText}"
                                               Command="{Binding ApplyCommand}"
                                               Padding="16,7" FontWeight="SemiBold" />

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                                   Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Style="{DynamicResource ModernGhostBtn}"
                                                Padding="4,1" Margin="4,0,0,0"
                                                Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisConverter}}"
                                                Command="{Binding ShowDetailsCommand}">
                                            <TextBlock Text="(details)" FontSize="11" Foreground="#60A5FA" TextDecorations="Underline" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ==================== TOP 8 INSTANT QUICK-TOGGLES ==================== -->
            <DockPanel LastChildFill="False" Margin="2,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="INSTANT QUICK-TOGGLES" FontSize="14" FontWeight="ExtraBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="1-click instant system toggles" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding QuickToggles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Icon + Toggle Switch + ProgressRing -->
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Left" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Width="30" Height="30">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Switch Button + Animated Spinner -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                         Foreground="#3B82F6"
                                                         Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisConverter}}" />
                                        <ui:ToggleSwitch AutomationProperties.AutomationId="{Binding Id, StringFormat='Toggle_{0}'}"
                                                         IsChecked="{Binding IsActive, Mode=OneWay}"
                                                         IsEnabled="{Binding IsNotApplying}"
                                                         Command="{Binding ToggleCommand}"
                                                         CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                                         VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Title and Status Badge -->
                                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBackground}"
                                            BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding StatusBadgeForeground}" />
                                    </Border>
                                </DockPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" LineHeight="15" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

    <!-- EXECUTION DETAILS DIALOG OVERLAY -->
    <Grid Background="#80000000"
          Visibility="{Binding IsDetailsDialogOpen, Converter={StaticResource BoolToVisConverter}}"
          Panel.ZIndex="2000">
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10"
                Width="700" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding DetailsDialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                            Command="{Binding CloseDetailsDialogCommand}" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding ExecutionDetailsItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E2433" BorderBrush="#334155" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusFgColor}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Id, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Reason}" FontSize="11" Foreground="#EF4444"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas, Cascadia Code, Courier New" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <ui:Button Content="Close" Appearance="Secondary"
                               Command="{Binding CloseDetailsDialogCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- IRREVERSIBLE TWEAK WARNING MODAL -->
    <Grid Background="#80000000"
          Visibility="{Binding IsIrreversibleDialogOpen, Converter={StaticResource BoolToVisConverter}}"
          Panel.ZIndex="2100">
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="#EF4444"
                BorderThickness="1" CornerRadius="10"
                Width="650" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="18" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IrreversibleDialogTitle}" FontSize="16" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                            Command="{Binding CancelIrreversibleCommand}" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="The following action(s) make permanent system changes that cannot be fully restored by Undo. Please review the details below before proceeding:"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl ItemsSource="{Binding IrreversibleWarningItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E24" BorderBrush="#DC2626" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FCA5A5" />
                                        <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,4" />
                                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#F87171" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,10,0"
                               Command="{Binding CancelIrreversibleCommand}" />
                    <ui:Button Content="I Understand, Apply Changes" Appearance="Danger"
                               Command="{Binding ConfirmIrreversibleCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- PROFILE PREVIEW DIALOG MODAL -->
    <Grid Background="#80000000"
          Visibility="{Binding IsProfilePreviewOpen, Converter={StaticResource BoolToVisConverter}}"
          Panel.ZIndex="2150">
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10"
                Width="780" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Layer24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding ProfilePreviewTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                            Command="{Binding CancelProfilePreviewCommand}" />
                </DockPanel>

                <!-- Description & Notice -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ProfilePreviewDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info16" Foreground="#60A5FA" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProfilePreviewNotice}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Loading State or Items List -->
                <Grid Grid.Row="2">
                    <!-- Loading Indicator -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20"
                                Visibility="{Binding IsProfilePreviewLoading, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,0,0,8" />
                        <TextBlock Text="Analyzing system states..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Items ScrollViewer -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                        <ItemsControl ItemsSource="{Binding ProfilePreviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2433" BorderBrush="#334155" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox (disabled if already applied) -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding IsSelectable}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- Tweak Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" FontFamily="Consolas, Cascadia Code, Courier New" />
                                                    <TextBlock Text="{Binding ReversibleText, StringFormat='Reversible: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" />
                                                    <TextBlock Text="Reboot Required" FontSize="11" Foreground="#F59E0B" Margin="0,0,10,0"
                                                               Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisConverter}}" />
                                                    <TextBlock Text="Explorer Restart" FontSize="11" Foreground="#38BDF8"
                                                               Visibility="{Binding RequiresExplorerRestart, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status & Risk Badges -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- State Badge -->
                                                <Border Background="{Binding StateBg}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StateFg}" />
                                                </Border>

                                                <!-- Risk Badge -->
                                                <Border Background="{Binding RiskBadgeBg}" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding Risk}" FontSize="10" FontWeight="Bold" Foreground="{Binding RiskBadgeFg}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,10,0"
                               Command="{Binding CancelProfilePreviewCommand}" />
                    <ui:Button Content="{Binding ProfilePreviewConfirmText}" Appearance="Primary"
                               Command="{Binding ConfirmProfilePreviewCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Grid>
</UserControl>
