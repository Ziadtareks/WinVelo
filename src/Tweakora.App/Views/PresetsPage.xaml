<UserControl x:Class="Tweakora.App.Views.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetsTitle]}"
                       FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetsSubtitle]}"
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

            <!-- Tabs: Profiles / History / Export -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Content="System Profiles" Icon="{ui:SymbolIcon Bookmark24}" Margin="0,0,8,0"
                           Command="{Binding SwitchTabCommand}" CommandParameter="Profiles" />
                <ui:Button Content="Change History (Rollback Journal)" Icon="{ui:SymbolIcon History24}" Margin="0,0,8,0"
                           Command="{Binding SwitchTabCommand}" CommandParameter="History" />
                <ui:Button Content="Export &amp; Script Generator" Icon="{ui:SymbolIcon Code24}" Margin="0,0,8,0"
                           Command="{Binding SwitchTabCommand}" CommandParameter="Export" />
            </StackPanel>

            <!-- Status Banner -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                </Grid>
            </Border>

            <!-- ==================== TAB 1: SYSTEM PROFILES ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Profiles">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TweakIds.Count, StringFormat='{}{0} Tweaks'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <ui:Button Content="Apply Profile" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Margin="0,0,0,6"
                                                       Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Content=".JSON" ToolTip="Export Profile to JSON" Margin="0,0,4,0"
                                                           Command="{Binding DataContext.ExportJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Content=".REG" ToolTip="Export Profile to Windows .reg file" Margin="0,0,4,0"
                                                           Command="{Binding DataContext.ExportRegCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Content=".PS1" ToolTip="Export Profile to PowerShell script"
                                                           Command="{Binding DataContext.ExportPs1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== TAB 2: CHANGE HISTORY ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="History">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:Card Margin="0,0,0,16" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Rollback Journal History" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Every applied change is recorded in the write-ahead journal before modifying system state. Roll back any session to its original baseline."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <ItemsControl ItemsSource="{Binding HistorySessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,10" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SessionId, StringFormat='Session: {0}'}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <Border Background="#10107C41" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Completed &amp; Protected" FontSize="11" Foreground="#107C41" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StartedAtUtc, StringFormat='Recorded: {0:yyyy-MM-dd HH:mm:ss} UTC'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Records.Count, StringFormat='Reversible Actions in Session: {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="1" Content="Rollback Session" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Danger" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Command="{Binding DataContext.RollbackSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== TAB 3: EXPORT & SCRIPTING ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Export">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:Card Margin="0,0,0,16" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Script &amp; Profile Code Generator" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Preview generated JSON, Windows Registry (.reg), or PowerShell (.ps1) deployment scripts."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:TextBox Text="{Binding ExportResultPreview}" IsReadOnly="True" AcceptsReturn="True"
                                TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Height="380"
                                VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
