<UserControl x:Class="Tweakora.App.Views.TweaksTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             AutomationProperties.AutomationId="TweaksTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Sub-header / Filter summary -->
            <RowDefinition Height="*" />    <!-- Scrollable Cards List -->
        </Grid.RowDefinitions>

        <!-- Filters & Results Status Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="16,10" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <!-- Left: Full Filter Controls Suite -->
                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <ui:TextBox AutomationProperties.AutomationId="TweaksSearchBox"
                                AutomationProperties.Name="Search tweaks"
                                PlaceholderText="Search tweaks..."
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Width="180" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <!-- Category Dropdown -->
                    <ComboBox AutomationProperties.Name="Filter by category"
                              ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              Width="120" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <!-- Risk Dropdown -->
                    <ComboBox AutomationProperties.Name="Filter by risk"
                              ItemsSource="{Binding RiskOptions}"
                              SelectedItem="{Binding SelectedRisk, Mode=TwoWay}"
                              Width="95" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <!-- State Dropdown -->
                    <ComboBox AutomationProperties.Name="Filter by state"
                              ItemsSource="{Binding StateOptions}"
                              SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                              Width="110" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- Recommended Only Toggle -->
                    <CheckBox AutomationProperties.AutomationId="RecommendedOnlyCheckBox"
                              Content="Recommended only"
                              IsChecked="{Binding IsRecommendedOnly, Mode=TwoWay}"
                              Margin="0,0,12,0" VerticalAlignment="Center"
                              FontSize="11" Foreground="#34D399" FontWeight="SemiBold"
                              ToolTip="Filter to conservative, well-documented, reversible settings (Safe and Low risk only)" />

                    <!-- Show Experimental Tweaks Toggle -->
                    <CheckBox AutomationProperties.AutomationId="ShowExperimentalTweaksCheckBox"
                              Content="Show experimental"
                              IsChecked="{Binding ShowExperimentalTweaks, Mode=TwoWay}"
                              Margin="0,0,8,0" VerticalAlignment="Center"
                              FontSize="11" Foreground="#94A3B8"
                              ToolTip="Display unproven community-lore tweaks (quarantined from presets)" />
                </WrapPanel>

                <!-- Right: Scan Status and Available Count -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilteredTweaks.Count, StringFormat='{}{0} available'}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    </Border>

                    <!-- Progress scanning indicator -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0">
                        <ProgressBar IsIndeterminate="True" Width="70" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScanStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Center Scrollable Tweak Cards List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,4,16,16">
            <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TweakCardModel}">
                        <!-- TWEAK CARD -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="14,12" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Top Header Row: Checkbox, Title, Badges -->
                                    <RowDefinition Height="Auto" /> <!-- Description -->
                                    <RowDefinition Height="Auto" /> <!-- Warnings (if any) -->
                                    <RowDefinition Height="Auto" /> <!-- Effect Note (if any) -->
                                    <RowDefinition Height="Auto" /> <!-- Metadata footer tags & Details button -->
                                    <RowDefinition Height="Auto" /> <!-- Expandable Info Drawer -->
                                </Grid.RowDefinitions>

                                <!-- Top Header Row (Collapsed card essentials) -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <!-- Selection Checkbox -->
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Title, StringFormat='Select {0}'}"
                                                  Style="{DynamicResource ModernCheckBox}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <!-- Bold Title -->
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <!-- Reboot Requirement Icon -->
                                        <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,6,0"
                                                Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Requires system reboot to take effect">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowSync24" Foreground="#F87171" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Reboot" FontSize="10" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Explorer Restart Icon -->
                                        <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,6,0"
                                                Visibility="{Binding RequiresExplorerRestart, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Requires Windows Explorer restart to take effect">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" Foreground="#60A5FA" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Explorer" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right Badges & Direct 1-Click Toggle -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <!-- Inline Busy Indicator -->
                                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                                         Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <!-- Direct 1-Click Toggle Switch -->
                                        <ui:ToggleSwitch AutomationProperties.AutomationId="{Binding Id, StringFormat='TweakToggle_{0}'}"
                                                         AutomationProperties.Name="{Binding Title, StringFormat='Toggle {0}'}"
                                                         IsChecked="{Binding ToggleCheckedState, Mode=OneWay}"
                                                         IsEnabled="{Binding IsNotApplying}"
                                                         Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}"
                                                         Margin="0,0,10,0" VerticalAlignment="Center" />

                                        <!-- Real System State Status Badge (Applied / Partial / Not applied / Can't verify) -->
                                        <Border Background="{Binding StatusBadgeBackground}"
                                                BorderBrush="{Binding StatusBadgeBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                       Foreground="{Binding StatusBadgeForeground}"
                                                       FontSize="10" FontWeight="ExtraBold" />
                                        </Border>

                                        <!-- Risk Color Chip (Safe green / Low blue / Medium amber / High red) -->
                                        <Border Background="{Binding RiskBadgeBackground}"
                                                BorderBrush="{Binding RiskBadgeBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,3">
                                            <TextBlock Text="{Binding Risk}"
                                                       Foreground="{Binding RiskBadgeForeground}"
                                                       FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Clean Wrap-enabled Description -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                           Margin="28,6,0,0" />

                                <!-- Warning Notice Box (if applicable) -->
                                <Border Grid.Row="2" Background="{DynamicResource RiskModerateBgBrush}"
                                        BorderBrush="{DynamicResource RiskModerateFgBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="28,8,0,0"
                                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Warnings, StringFormat='⚠️ {0}'}"
                                               Foreground="{DynamicResource RiskModerateFgBrush}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Border>

                                <!-- Effect Note (if applicable) -->
                                <Border Grid.Row="3" Background="{DynamicResource StatusDefaultBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="28,6,0,0"
                                        Visibility="{Binding HasEffectNote, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding EffectNote, StringFormat='ℹ️ {0}'}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Border>

                                <!-- Metadata / Category / Reboot Tags Footer & Details Toggle -->
                                <DockPanel Grid.Row="4" Margin="28,8,0,0" LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <!-- ID Badge -->
                                        <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Id}" FontSize="10" FontFamily="Consolas, Cascadia Code, Courier New"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>

                                        <!-- Category Group Badge -->
                                        <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CategoryGroup}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>

                                        <!-- Evidence Badge -->
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Evidence}" FontSize="10" Foreground="#94A3B8" />
                                        </Border>

                                        <!-- Needs Review Badge -->
                                        <Border Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="NEEDS REVIEW ⚠️" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" />
                                        </Border>

                                        <!-- Reboot Requirement Badge -->
                                        <Border Background="{DynamicResource RiskCautionBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Reboot Required" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource RiskCautionFgBrush}" />
                                        </Border>

                                        <!-- Explorer Restart Badge -->
                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2"
                                                Visibility="{Binding RequiresExplorerRestart, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Explorer Restart" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Details Toggle Button -->
                                    <Button DockPanel.Dock="Right"
                                            AutomationProperties.AutomationId="{Binding Id, StringFormat='DetailsButton_{0}'}"
                                            Command="{Binding ToggleExpandCommand}"
                                            Style="{DynamicResource ModernGhostBtn}"
                                            Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" Foreground="#60A5FA">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Details ▾" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="Hide Details ▴" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </DockPanel>

                                <!-- Expandable Info Drawer (O&O ShutUp10++ style) -->
                                <Border Grid.Row="5"
                                        Background="#111827"
                                        BorderBrush="#1F2937"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="28,10,0,0"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <!-- What It Does Section -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="WHAT IT DOES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <TextBlock Text="{Binding WhatItDoes}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="17" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Side Effects Section -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="SIDE EFFECTS / POTENTIAL IMPACT" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,3" />
                                            <TextBlock Text="{Binding SideEffects}" FontSize="12" Foreground="#E2E8F0" LineHeight="17" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Where to find this in Windows (for UI-equivalent settings) -->
                                        <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                                Visibility="{Binding HasUiEquivalentLocation, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚙️ WHERE TO FIND THIS IN WINDOWS: " FontSize="10" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UiEquivalentLocation}" FontSize="11" Foreground="#A7F3D0" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Exact Changes Section -->
                                        <StackPanel Margin="0,0,0,8" Visibility="{Binding HasExactChanges, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="EXACT CHANGES (ENGINE SPECIFICATION)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,3" />
                                            <ItemsControl ItemsSource="{Binding ExactChanges}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='• {0}'}"
                                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                                   FontSize="11" Foreground="#CBD5E1" LineHeight="16" TextWrapping="Wrap" Margin="0,1,0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Needs Review Warning Notice (if applicable) -->
                                        <Border Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                                Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="⚠️ NEEDS REVIEW: The exact behavior or real-world benefit of this tweak requires further validation. Excluded from automated presets."
                                                       FontSize="11" Foreground="#FBBF24" TextWrapping="Wrap" />
                                        </Border>

                                        <!-- Sources / Documentation Links -->
                                        <StackPanel Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="DOCUMENTATION &amp; SOURCES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                            <!-- Verified Source Quote (if documented) -->
                                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
                                                    Visibility="{Binding HasSourceQuote, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SourceQuote, StringFormat='&quot;{0}&quot;'}"
                                                           FontSize="11" FontStyle="Italic" Foreground="#94A3B8" LineHeight="16" TextWrapping="Wrap" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Sources}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{DynamicResource ModernGhostBtn}"
                                                                HorizontalAlignment="Left"
                                                                Padding="0,2" Margin="0,1,0,1">
                                                            <TextBlock Text="{Binding StringFormat='🔗 {0}'}"
                                                                       FontSize="11" Foreground="#60A5FA" TextDecorations="Underline" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- TOAST NOTIFICATION OVERLAY (Safe / Low instant apply + Undo) -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,32,24"
                Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1"
                CornerRadius="8" Padding="16,12"
                Panel.ZIndex="1500"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#34D399" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastMessage}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ui:Button AutomationProperties.AutomationId="ToastUndoButton"
                           AutomationProperties.Name="Undo applied tweak"
                           Content="{Binding ToastActionText}" Appearance="Primary"
                           Command="{Binding UndoToastActionCommand}"
                           Padding="14,4" Margin="0,0,10,0" />
                <Button Style="{DynamicResource ModernGhostBtn}" Content="✕"
                        AutomationProperties.Name="Dismiss notification"
                        Command="{Binding DismissToastCommand}"
                        Padding="6,2" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- EXECUTION DETAILS DIALOG OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000"
              Visibility="{Binding IsDetailsDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="2000">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Width="700" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding DetailsDialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                                Command="{Binding CloseDetailsDialogCommand}" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <ItemsControl ItemsSource="{Binding ExecutionDetailsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2433" BorderBrush="#334155" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                    <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayStatus}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusFgColor}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Id, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Reason}" FontSize="11" Foreground="#EF4444"
                                                       TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas, Cascadia Code, Courier New" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <ui:Button Content="Close" Appearance="Secondary"
                                   Command="{Binding CloseDetailsDialogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- IRREVERSIBLE TWEAK WARNING MODAL -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000"
              Visibility="{Binding IsIrreversibleDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="2100">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#EF4444"
                    BorderThickness="1" CornerRadius="10"
                    Width="650" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="18" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IrreversibleDialogTitle}" FontSize="16" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                                Command="{Binding CancelIrreversibleCommand}" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="The following action(s) make permanent system changes that cannot be fully restored by Undo. Please review the details below before proceeding:"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding IrreversibleWarningItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E24" BorderBrush="#DC2626" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FCA5A5" />
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,4" />
                                            <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#F87171" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,10,0"
                                   Command="{Binding CancelIrreversibleCommand}" />
                        <ui:Button Content="I Understand, Apply Changes" Appearance="Danger"
                                   Command="{Binding ConfirmIrreversibleCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
