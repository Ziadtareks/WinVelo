<UserControl x:Class="Tweakora.App.Views.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolsTitle]}"
                       FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolsSubtitle]}"
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

            <!-- Tool Selection Buttons -->
            <WrapPanel Margin="0,0,0,20">
                <ui:Button Content="Smart Cleaner" Icon="{ui:SymbolIcon Broom24}" Margin="0,0,8,8"
                           Command="{Binding SelectToolCommand}" CommandParameter="Cleaner" />
                <ui:Button Content="Startup Apps" Icon="{ui:SymbolIcon Apps24}" Margin="0,0,8,8"
                           Command="{Binding SelectToolCommand}" CommandParameter="Startup" />
                <ui:Button Content="Services Manager" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,8,8"
                           Command="{Binding SelectToolCommand}" CommandParameter="Services" />
                <ui:Button Content="Fixes Center" Icon="{ui:SymbolIcon Wrench24}" Margin="0,0,8,8"
                           Command="{Binding SelectToolCommand}" CommandParameter="Fixes" />
                <ui:Button Content="DNS Switcher" Icon="{ui:SymbolIcon Globe24}" Margin="0,0,8,8"
                           Command="{Binding SelectToolCommand}" CommandParameter="Network" />
            </WrapPanel>

            <!-- ==================== SECTION 1: SMART CLEANER ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Cleaner">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Safe Cache &amp; Junk Cleaner" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Whitelisted locations only (%TEMP%, %WINDIR%\Temp, Update Download Cache). Preview size first before cleaning."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,8" />
                                <TextBlock Text="{Binding CleanerStatusText}" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Purge RAM" Icon="{ui:SymbolIcon Broom24}" Margin="0,0,8,0"
                                           Command="{Binding PurgeRamCommand}" />
                                <ui:Button Content="Scan Now" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0"
                                           Command="{Binding ScanCleanerCommand}" />
                                <ui:Button Content="Clean Selected" Icon="{ui:SymbolIcon Delete24}" Appearance="Primary"
                                           Command="{Binding CleanNowCommand}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Cleaner Categories List -->
                    <ItemsControl ItemsSource="{Binding CleanerCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PathDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="13" />
                                        </Border>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== SECTION 2: STARTUP MANAGER ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Startup">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Startup Applications" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Control which applications start automatically when you sign in to Windows. Disabling unnecessary apps speeds up boot time."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <ItemsControl ItemsSource="{Binding StartupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Location, StringFormat='Registry: {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding Impact, StringFormat='Impact: {0}'}" FontSize="11" FontWeight="Medium" />
                                        </Border>
                                        <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}"
                                                         Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}" VerticalAlignment="Center" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== SECTION 3: SERVICES MANAGER ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Services">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Windows Services Inspector" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Inspect and review Windows system services. Safe modification with rollback journal protection."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <ItemsControl ItemsSource="{Binding ServicesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ServiceName, StringFormat='Service ID: {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Grid.Column="3" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                            <TextBlock Text="{Binding StartupType, StringFormat='Startup: {0}'}" FontSize="12" FontWeight="Medium" />
                                        </Border>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== SECTION 4: FIXES CENTER ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Fixes">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Windows Repairs &amp; Diagnostic Fixes" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="One-click safe repair actions for network, update cache, and Windows subsystem health."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,8" />
                            <TextBlock Text="{Binding FixStatusText}" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="13" />
                        </StackPanel>
                    </ui:Card>

                    <ItemsControl ItemsSource="{Binding FixesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,10" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                                </Border>
                                                <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="Medium" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Script, StringFormat='Command: {0}'}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="Run Repair" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Command="{Binding DataContext.RunFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== SECTION 5: DNS SWITCHER ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Network">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Secure DNS &amp; Network Latency Optimizer" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Benchmark latency across global DNS resolvers and apply the fastest provider in 1 click."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,8" />
                                <TextBlock Text="{Binding DnsStatusText}" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Benchmark All DNS" Icon="{ui:SymbolIcon Globe24}" Margin="0,0,8,0"
                                           Command="{Binding BenchmarkAllDnsCommand}" />
                                <ui:Button Content="Apply Fastest" Icon="{ui:SymbolIcon Sparkle24}" Appearance="Primary" Margin="0,0,8,0"
                                           Command="{Binding ApplyFastestDnsCommand}" />
                                <ui:Button Content="Reset to DHCP" Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                           Command="{Binding ResetDnsToDhcpCommand}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Gaming Latency & Nagle's Algorithm Card -->
                    <ui:Card Margin="0,0,0,16" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Games24" Foreground="#F59E0B" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Low-Latency Gaming Packets (Disable Nagle's Algorithm)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Disables TCP packet queuing delays (TcpAckFrequency = 1, TCPNoDelay = 1) on active network adapters for immediate packet dispatch in multiplayer games."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding NetworkStatusText}" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                             IsChecked="{Binding IsNagleDisabled, Mode=TwoWay}"
                                             Command="{Binding ToggleNagleCommand}"
                                             CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </ui:Card>

                    <ItemsControl ItemsSource="{Binding DnsProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,10" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                <Border Background="#107C41" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Active" FontSize="11" Foreground="White" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrimaryDns, StringFormat='Primary: {0}'}" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0" />
                                                <TextBlock Text="{Binding SecondaryDns, StringFormat='Secondary: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,0" />
                                                <TextBlock Text="{Binding PingMs, StringFormat='Latency: {0} ms'}" FontSize="12" Foreground="#0078D4" FontWeight="Medium" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="Ping Test" Icon="{ui:SymbolIcon Timer24}" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.TestDnsLatencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Grid.Column="3" Content="Apply DNS" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
