<UserControl x:Class="Tweakora.App.Views.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolsTitle]}"
                       FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolsSubtitle]}"
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

            <WrapPanel>
                <ui:CardAction Margin="0,0,16,16" Width="280">
                    <StackPanel Margin="8">
                        <TextBlock Text="Smart Cleaner" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Clean temporary files, caches, and update logs safely."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction Margin="0,0,16,16" Width="280">
                    <StackPanel Margin="8">
                        <TextBlock Text="Startup Manager" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Manage background startup applications and scheduled tasks."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction Margin="0,0,16,16" Width="280">
                    <StackPanel Margin="8">
                        <TextBlock Text="Services Manager" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Search, inspect, and configure Windows services startup state."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction Margin="0,0,16,16" Width="280">
                    <StackPanel Margin="8">
                        <TextBlock Text="Fixes Center" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="One-click repairs for Windows Update, Store, and Network."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
