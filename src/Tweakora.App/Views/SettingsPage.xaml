<UserControl x:Class="Tweakora.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsTitle]}"
                       FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsSubtitle]}"
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

            <!-- First-Run Wizard Welcome Card -->
            <Border Background="#100078D4" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Sparkle24" Foreground="#0078D4" FontSize="26" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Tweakora Control Center" FontWeight="SemiBold" FontSize="15" Foreground="#0078D4" />
                        <TextBlock Text="Designed for safety, transparency, and reversibility. Every tweak is documented with Microsoft Learn references and write-ahead rollback protection."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Got It" Appearance="Transparent" VerticalAlignment="Center" Margin="12,0,0,0"
                               Command="{Binding DismissWelcomeCommand}" />
                </Grid>
            </Border>

            <!-- Experience Mode Card -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="User Experience Mode" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Beginner Mode simplifies technical details; Advanced Mode shows exact registry keys, values, and command syntax."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ExperienceMode, StringFormat='Current Mode: {0}'}" FontWeight="Medium" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Beginner" Margin="0,0,8,0"
                                   Command="{Binding SetExperienceModeCommand}" CommandParameter="Beginner" />
                        <ui:Button Content="Advanced" Appearance="Primary"
                                   Command="{Binding SetExperienceModeCommand}" CommandParameter="Advanced" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Language Setting -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Language]}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Select your preferred application language / اختر لغة الواجهة"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LanguageEn]}"
                                   Command="{Binding SwitchLanguageCommand}" CommandParameter="en" Margin="0,0,8,0" />
                        <ui:Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LanguageAr]}"
                                   Command="{Binding SwitchLanguageCommand}" CommandParameter="ar" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Theme Setting -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme]}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Toggle between Fluent Dark and Light appearance themes."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeDark]}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Dark" Margin="0,0,8,0" />
                        <ui:Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeLight]}"
                                   Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Safety & Backup Configuration -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Safety Shield &amp; Journaling" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="System Restore Point Verification" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="Automatically request Windows to create a restore point before running batch tweaks."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCreateRestorePoint}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Rollback Journal Directory" FontSize="13" FontWeight="Medium" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding JournalPath}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="Consolas" FontSize="11" />
                </StackPanel>
            </ui:Card>

            <!-- About Tweakora -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Tweakora" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Open-source Windows 10 &amp; 11 System Control Center &amp; Toolbox."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="Licensed under MIT. Source code published on GitHub."
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ShieldCheckmark24" Foreground="#107C41" FontSize="36" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
