<UserControl x:Class="Tweakora.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DashboardWelcome]}"
                       FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DashboardSubtitle]}"
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

            <!-- Safety Banner -->
            <Border Background="#10107C41" BorderBrush="#107C41" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#107C41" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Safety Shield Active" FontWeight="SemiBold" FontSize="15" Foreground="#107C41" />
                        <TextBlock Text="Every action is logged in the Write-Ahead Rollback Journal before execution. Restore point verification is enabled."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- System Overview Card -->
            <ui:Card Margin="0,0,0,20" Padding="20">
                <StackPanel>
                    <TextBlock Text="System Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- OS and Build -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Operating System" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SystemSummary.OsVersion}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SystemSummary.OsBuild}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Hardware / Architecture -->
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Architecture &amp; Memory" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SystemSummary.Architecture, StringFormat='{}{0} Architecture'}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SystemSummary.TotalRamGb, StringFormat='{}{0} GB RAM'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- System Uptime -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="System Uptime" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SystemSummary.Uptime}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SystemSummary.MachineName, StringFormat='PC: {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Applied Tweaks Metric -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Active Tweaks" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SystemSummary.AppliedTweaksCount}" FontSize="16" FontWeight="Bold" Foreground="#107C41" />
                                <TextBlock Text="{Binding SystemSummary.TotalCatalogTweaksCount, StringFormat=' / {0} Tweaks'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Catalog active &amp; ready" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Rollback Journal Status -->
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Rollback Engine" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SystemSummary.RollbackJournalStatus}" FontSize="14" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,4,0,0" />
                            <TextBlock Text="Write-Ahead log active" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Platform Engine Mode -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Platform Mode" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SystemSummary.PlatformMode}" FontSize="14" FontWeight="SemiBold" Foreground="#8764B8" Margin="0,4,0,0" />
                            <TextBlock Text="Host protection verified" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Features & Quick Hub -->
            <TextBlock Text="Control Center Hub" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,16" />
            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <!-- Tweaks Hub -->
                <ui:Card Margin="0,0,12,12" Padding="16">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Text="System Tweaks" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Privacy, telemetry reduction, UI styling, and safe performance enhancements."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <!-- Smart Cleaner Hub -->
                <ui:Card Margin="0,0,12,12" Padding="16">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Broom24" FontSize="24" Foreground="#107C41" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Text="Smart Cleaner" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Scans only safe, whitelisted temporary caches and update logs. Preview before cleaning."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <!-- Startup & Services Hub -->
                <ui:Card Margin="0,0,12,12" Padding="16">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Apps24" FontSize="24" Foreground="#0078D4" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Text="Startup &amp; Services" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Inspect autostart programs and tune background Windows services with reversible settings."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
