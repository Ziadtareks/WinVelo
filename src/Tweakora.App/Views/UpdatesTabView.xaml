<UserControl x:Class="Tweakora.App.Views.UpdatesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tweakora.App.ViewModels"
             xmlns:updates="clr-namespace:Tweakora.Modules.Updates;assembly=Tweakora.Modules"
             AutomationProperties.AutomationId="UpdatesTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Active Status Header -->
            <RowDefinition Height="*" />    <!-- Mode Cards -->
            <RowDefinition Height="Auto" /> <!-- Apply & Status Bar -->
        </Grid.RowDefinitions>

        <!-- Active Status Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Current Windows Update Profile:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveModeTitle}" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Mode Cards (3 Columns) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CARD 1: Default (Out of Box) -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Default (Out of Box)" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="Standard Microsoft Windows Update behavior." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="• Windows automatically checks for and downloads all updates." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="• Feature updates installed as soon as Microsoft releases them." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="• Recommended for ordinary home users requiring automatic maintenance." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                    </StackPanel>

                    <ui:Button Grid.Row="2" AutomationProperties.AutomationId="SelectMode_Default"
                               Content="Select Default Profile" HorizontalAlignment="Stretch"
                               Command="{Binding SelectModeCommand}">
                        <ui:Button.CommandParameter>
                            <updates:UpdateProfileMode>Default</updates:UpdateProfileMode>
                        </ui:Button.CommandParameter>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- CARD 2: Security (Recommended) -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="2" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Security Only" FontSize="16" FontWeight="Bold" />
                            <Border DockPanel.Dock="Right" Background="#E6F4EA" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#137333" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Maximum stability without sacrificing security patches." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="• Installs critical security updates automatically." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="• Delays annual feature updates by up to 1 year to avoid OS bugs." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="• Disables disruptive automatic reboots while working." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="• Excludes buggy third-party hardware driver updates." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                    </StackPanel>

                    <ui:Button Grid.Row="2" AutomationProperties.AutomationId="SelectMode_Security"
                               Content="Select Security Profile" Appearance="Primary" HorizontalAlignment="Stretch"
                               Command="{Binding SelectModeCommand}">
                        <ui:Button.CommandParameter>
                            <updates:UpdateProfileMode>Security</updates:UpdateProfileMode>
                        </ui:Button.CommandParameter>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- CARD 3: Disable All Updates (CAUTION) -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#C5221F" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Disable All Updates" FontSize="16" FontWeight="Bold" Foreground="#C5221F" />
                            <Border DockPanel.Dock="Right" Background="#FCE8E6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="CAUTION" FontSize="10" FontWeight="Bold" Foreground="#C5221F" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Completely halts all Windows Update activity." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Border Background="#FFF0F0" BorderBrush="#FFCCCC" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="WARNING: Stopping updates leaves your system vulnerable to newly discovered security exploits."
                                       Foreground="#C5221F" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="• Disables wuauserv, BITS, and UsoSvc services." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="• Prevents Windows from checking or downloading patches." TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />

                        <!-- Safety typed confirmation input -->
                        <TextBlock Text="To select this mode, type 'I understand':" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBox AutomationProperties.AutomationId="DisableUpdatesConfirmBox"
                                 Text="{Binding TypedConfirmation, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6" Margin="0,0,0,4" />
                    </StackPanel>

                    <ui:Button Grid.Row="2" AutomationProperties.AutomationId="SelectMode_DisableAll"
                               Content="Select Disable Profile" Appearance="Danger" HorizontalAlignment="Stretch"
                               Command="{Binding SelectModeCommand}">
                        <ui:Button.CommandParameter>
                            <updates:UpdateProfileMode>DisableAll</updates:UpdateProfileMode>
                        </ui:Button.CommandParameter>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Apply & Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <ui:Button AutomationProperties.AutomationId="ApplyUpdatesProfileButton"
                           Content="Apply Selected Profile" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                           Command="{Binding ApplySelectedModeCommand}" IsEnabled="{Binding IsApplyEnabled}"
                           DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
