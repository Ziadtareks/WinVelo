<UserControl x:Class="Tweakora.App.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization"
             xmlns:conv="clr-namespace:Tweakora.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32" MaxWidth="1050" HorizontalAlignment="Stretch">
                <!-- Header -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TweaksTitle]}"
                           FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TweaksSubtitle]}"
                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

                <!-- Inline Page Error Banner -->
                <Border Visibility="{Binding HasPageError, Converter={StaticResource BoolToVisConverter}}"
                        Background="#FDE7E9" BorderBrush="#A80000" BorderThickness="1" CornerRadius="6"
                        Padding="12" Margin="0,0,0,16">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Warning24" Foreground="#A80000" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PageErrorMessage}" Foreground="#A80000" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Action Bar: Search, Dry Run, Apply Staged, Discard -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                AutomationProperties.AutomationId="TweaksSearchBox"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchPlaceholder]}"
                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" />

                    <ui:Button Grid.Column="1"
                               AutomationProperties.AutomationId="PreviewDryRunButton"
                               Content="Dry-Run Preview"
                               Icon="{ui:SymbolIcon DocumentBulletList24}"
                               Appearance="Secondary"
                               Command="{Binding GenerateDryRunPreviewCommand}"
                               Margin="0,0,8,0" />

                    <ui:Button Grid.Column="2"
                               AutomationProperties.AutomationId="ApplyStagedButton"
                               Content="{Binding StagedCount, StringFormat='Apply Staged ({0})'}"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Appearance="Primary"
                               IsEnabled="{Binding HasStagedChanges}"
                               Command="{Binding ApplyStagedChangesCommand}"
                               Margin="0,0,8,0" />

                    <ui:Button Grid.Column="3"
                               AutomationProperties.AutomationId="DiscardStagedButton"
                               Content="Discard"
                               Icon="{ui:SymbolIcon DismissCircle24}"
                               Appearance="Secondary"
                               IsEnabled="{Binding HasStagedChanges}"
                               Command="{Binding DiscardStagedChangesCommand}" />
                </Grid>

                <!-- Category Chips -->
                <WrapPanel Margin="0,0,0,20">
                    <ui:Button AutomationProperties.AutomationId="Category_All"
                               Content="All" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="All" />
                    <ui:Button AutomationProperties.AutomationId="Category_Privacy"
                               Content="Privacy" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="privacy" />
                    <ui:Button AutomationProperties.AutomationId="Category_AI"
                               Content="AI" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="ai" />
                    <ui:Button AutomationProperties.AutomationId="Category_UI"
                               Content="UI &amp; Explorer" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="ui" />
                    <ui:Button AutomationProperties.AutomationId="Category_Performance"
                               Content="Performance" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="performance" />
                    <ui:Button AutomationProperties.AutomationId="Category_Gaming"
                               Content="Gaming" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="gaming" />
                    <ui:Button AutomationProperties.AutomationId="Category_Updates"
                               Content="Updates" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="updates" />
                </WrapPanel>

                <!-- Tweaks Cards List -->
                <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card AutomationProperties.AutomationId="{Binding Id, StringFormat='TweakCard_{0}'}"
                                     Margin="0,0,0,10">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Info & Badges -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock AutomationProperties.AutomationId="{Binding Id, StringFormat='TweakTitle_{0}'}"
                                                       Text="{Binding LocalizedName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" />

                                            <!-- Staged Badge -->
                                            <Border Visibility="{Binding IsStaged, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="Staged" Foreground="#856404" FontSize="10" FontWeight="Bold" />
                                            </Border>

                                            <!-- Risk Badge -->
                                            <Border Background="{Binding RiskBadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Risk}" Foreground="{Binding RiskBadgeForeground}" FontSize="11" FontWeight="Bold" />
                                            </Border>

                                            <!-- Restart Badges -->
                                            <Border Visibility="{Binding RequiresExplorerRestart, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#FFF0E0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="Explorer Restart" Foreground="#A05000" FontSize="10" FontWeight="SemiBold" />
                                            </Border>

                                            <Border Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#FCE8E6" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Reboot Required" Foreground="#C5221F" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LocalizedDescription}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Right: Action & Toggle -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button AutomationProperties.AutomationId="{Binding Id, StringFormat='TweakDetails_{0}'}"
                                                   Icon="{ui:SymbolIcon Info24}"
                                                   Appearance="Transparent"
                                                   ToolTip="View Details &amp; Technical Source"
                                                   Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="0,0,12,0" />

                                        <ui:ToggleSwitch AutomationProperties.AutomationId="{Binding Id, StringFormat='TweakToggle_{0}'}"
                                                         IsChecked="{Binding IsCheckedInUi, Mode=TwoWay}"
                                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                         Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Details Overlay Modal -->
        <Grid Visibility="{Binding IsDetailsPanelOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#80000000">
            <ui:Card MaxWidth="600" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock AutomationProperties.AutomationId="DetailsTweakName"
                                   Text="{Binding SelectedTweakForDetails.LocalizedName}" FontSize="18" FontWeight="Bold" />
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   AutomationProperties.AutomationId="CloseDetailsTopButton"
                                   Command="{Binding CloseDetailsCommand}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Identifier:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock AutomationProperties.AutomationId="DetailsTweakId"
                                       Text="{Binding SelectedTweakForDetails.Id}" FontFamily="Consolas" Margin="0,2,0,10" />

                            <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock AutomationProperties.AutomationId="DetailsTweakDescription"
                                       Text="{Binding SelectedTweakForDetails.LocalizedDescription}" TextWrapping="Wrap" Margin="0,2,0,10" />

                            <TextBlock Text="Effect Note:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding SelectedTweakForDetails.HasEffectNote, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="{Binding SelectedTweakForDetails.LocalizedEffectNote}" TextWrapping="Wrap" Margin="0,2,0,10"
                                       Foreground="#0078D4"
                                       Visibility="{Binding SelectedTweakForDetails.HasEffectNote, Converter={StaticResource BoolToVisConverter}}" />

                            <TextBlock Text="Warning:" FontWeight="SemiBold" FontSize="12" Foreground="#C5221F"
                                       Visibility="{Binding SelectedTweakForDetails.HasWarning, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="{Binding SelectedTweakForDetails.LocalizedWarning}" TextWrapping="Wrap" Margin="0,2,0,10"
                                       Foreground="#C5221F"
                                       Visibility="{Binding SelectedTweakForDetails.HasWarning, Converter={StaticResource BoolToVisConverter}}" />

                            <TextBlock Text="Official Documentation:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock AutomationProperties.AutomationId="DetailsTweakSource"
                                       Text="{Binding SelectedTweakForDetails.SourceUrl}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ui:Button Grid.Row="2" Content="Close" Appearance="Primary" HorizontalAlignment="Right"
                               AutomationProperties.AutomationId="CloseDetailsButton"
                               Command="{Binding CloseDetailsCommand}" />
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Dry-Run / Staged Diff Preview Modal -->
        <Grid Visibility="{Binding IsPreviewDialogOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#80000000">
            <ui:Card MaxWidth="750" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Preview Changes (Dry-Run)" FontSize="18" FontWeight="Bold" />
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   AutomationProperties.AutomationId="CancelApplyTopButton"
                                   Command="{Binding ClosePreviewDialogCommand}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding PreviewReportText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas, Cascadia Code"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button AutomationProperties.AutomationId="CancelApplyButton"
                                   Content="Cancel" Appearance="Secondary"
                                   Command="{Binding ClosePreviewDialogCommand}" Margin="0,0,8,0" />
                        <ui:Button AutomationProperties.AutomationId="ConfirmApplyButton"
                                   Content="{Binding StagedCount, StringFormat='Confirm &amp; Apply ({0})'}"
                                   Appearance="Primary"
                                   Command="{Binding ConfirmApplyStagedCommand}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
