<UserControl x:Class="Tweakora.App.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization">

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32" MaxWidth="1050" HorizontalAlignment="Stretch">
                <!-- Header -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TweaksTitle]}"
                           FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TweaksSubtitle]}"
                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" />

                <!-- Action Bar: Search, Category Filters, and Dry Run Button -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchPlaceholder]}"
                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,12,0" />

                    <ui:Button Grid.Column="1"
                               Content="Preview Changes (Dry-Run)"
                               Icon="{ui:SymbolIcon DocumentBulletList24}"
                               Appearance="Secondary"
                               Command="{Binding GenerateDryRunPreviewCommand}" />
                </Grid>

                <!-- Category Chips -->
                <WrapPanel Margin="0,0,0,20">
                    <ui:Button Content="All" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="All" />
                    <ui:Button Content="Privacy" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="privacy" />
                    <ui:Button Content="AI" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="ai" />
                    <ui:Button Content="UI &amp; Explorer" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="ui" />
                    <ui:Button Content="Performance" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="performance" />
                    <ui:Button Content="Gaming" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="gaming" />
                    <ui:Button Content="Updates" Margin="0,0,6,6"
                               Appearance="Secondary"
                               Command="{Binding SelectCategoryCommand}" CommandParameter="updates" />
                </WrapPanel>

                <!-- Tweaks Cards List -->
                <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,10">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Info & Badges -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding LocalizedName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0" />

                                            <!-- Risk Badge -->
                                            <Border Background="{Binding RiskBadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Risk}" Foreground="{Binding RiskBadgeForeground}" FontSize="11" FontWeight="Bold" />
                                            </Border>

                                            <!-- Restart Badges -->
                                            <Border Visibility="{Binding RequiresExplorerRestart, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#FFF0E0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="Explorer Restart" Foreground="#A05000" FontSize="10" FontWeight="SemiBold" />
                                            </Border>

                                            <Border Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#FCE8E6" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Reboot Required" Foreground="#C5221F" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LocalizedDescription}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Right: Action & Toggle -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon Info24}"
                                                   Appearance="Transparent"
                                                   ToolTip="View Details &amp; Technical Source"
                                                   Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="0,0,12,0" />

                                        <ui:ToggleSwitch IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                         IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                                                         Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Details Overlay Modal -->
        <Grid Visibility="{Binding IsDetailsPanelOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#80000000">
            <ui:Card MaxWidth="600" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SelectedTweakForDetails.LocalizedName}" FontSize="18" FontWeight="Bold" />
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   Command="{Binding CloseDetailsCommand}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Identifier:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedTweakForDetails.Id}" FontFamily="Consolas" Margin="0,2,0,10" />

                            <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedTweakForDetails.LocalizedDescription}" TextWrapping="Wrap" Margin="0,2,0,10" />

                            <TextBlock Text="Effect Note:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding SelectedTweakForDetails.LocalizedEffectNote, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="{Binding SelectedTweakForDetails.LocalizedEffectNote}" TextWrapping="Wrap" Margin="0,2,0,10"
                                       Foreground="#0078D4"
                                       Visibility="{Binding SelectedTweakForDetails.LocalizedEffectNote, Converter={StaticResource BoolToVisConverter}}" />

                            <TextBlock Text="Warning:" FontWeight="SemiBold" FontSize="12" Foreground="#C5221F"
                                       Visibility="{Binding SelectedTweakForDetails.LocalizedWarning, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="{Binding SelectedTweakForDetails.LocalizedWarning}" TextWrapping="Wrap" Margin="0,2,0,10"
                                       Foreground="#C5221F"
                                       Visibility="{Binding SelectedTweakForDetails.LocalizedWarning, Converter={StaticResource BoolToVisConverter}}" />

                            <TextBlock Text="Official Documentation:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedTweakForDetails.SourceUrl}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ui:Button Grid.Row="2" Content="Close" Appearance="Primary" HorizontalAlignment="Right"
                               Command="{Binding CloseDetailsCommand}" />
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Dry-Run Preview Modal -->
        <Grid Visibility="{Binding IsPreviewDialogOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#80000000">
            <ui:Card MaxWidth="750" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Preview Changes (Dry-Run)" FontSize="18" FontWeight="Bold" />
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   Command="{Binding ClosePreviewDialogCommand}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding PreviewReportText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas, Cascadia Code"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>

                    <ui:Button Grid.Row="2" Content="Done" Appearance="Primary" HorizontalAlignment="Right" Margin="0,12,0,0"
                               Command="{Binding ClosePreviewDialogCommand}" />
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
