<UserControl x:Class="Tweakora.App.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Tweakora.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TweaksTitle]}"
                       FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TweaksSubtitle]}"
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

            <ui:TextBox PlaceholderText="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchPlaceholder]}"
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,16" />

            <ui:Card Margin="0,0,0,12">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Diagnostic Data Level" FontSize="16" FontWeight="Medium" Margin="0,0,10,0" />
                            <Border Background="#E6F4EA" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Safe" Foreground="#137333" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Reduces diagnostic data sent to Microsoft to the lowest allowed level."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="False" IsEnabled="False" />
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
