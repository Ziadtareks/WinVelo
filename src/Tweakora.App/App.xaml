<Application x:Class="Tweakora.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Tweakora.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/DesignTokens.xaml" />
                <ResourceDictionary Source="Styles/FluentDarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <conv:BoolToControlAppearanceConverter x:Key="BoolToAppearanceConverter" />

            <!-- Custom Accent and Font fallbacks -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI, Tahoma, Arial</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
