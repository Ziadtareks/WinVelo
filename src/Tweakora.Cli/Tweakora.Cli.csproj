<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>winvelo-cli</AssemblyName>
    <RootNamespace>Tweakora.Cli</RootNamespace>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tweakora.Core\Tweakora.Core.csproj" />
    <ProjectReference Include="..\Tweakora.Platform\Tweakora.Platform.csproj" />
    <ProjectReference Include="..\Tweakora.Modules\Tweakora.Modules.csproj" />
    <ProjectReference Include="..\Tweakora.Simulation\Tweakora.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Catalog\**\*" Link="Catalog\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
