<UserControl x:Class="WinVelo.App.Views.UpdatesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinVelo.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:WinVelo.App.ViewModels"
             xmlns:updates="clr-namespace:WinVelo.Modules.Updates;assembly=WinVelo.Modules"
             AutomationProperties.AutomationId="UpdatesTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Active Status Header -->
            <RowDefinition Height="*" />    <!-- Mode Cards -->
            <RowDefinition Height="Auto" /> <!-- Apply & Status Bar -->
        </Grid.RowDefinitions>

        <!-- Active Status Header -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Tr Updates_CurrentWindowsUpdateProfile}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveModeTitle}" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Mode Cards (3 Columns) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CARD 1: Default (Out of Box) -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{loc:Tr Tools_DefaultOutOfBox}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Tr Updates_StandardMicrosoftWindowsUpdateBehavior}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{loc:Tr Updates_WindowsAutomaticallyChecksForAnd}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="{loc:Tr Updates_FeatureUpdatesInstalledAsSoon}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="{loc:Tr Updates_RecommendedForOrdinaryHomeUsers}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                    </StackPanel>

                    <ui:Button Grid.Row="2" AutomationProperties.AutomationId="SelectMode_Default"
                               AutomationProperties.Name="Select Default Profile"
                               Content="{loc:Tr Updates_SelectDefaultProfile}" HorizontalAlignment="Stretch"
                               Command="{Binding SelectModeCommand}">
                        <ui:Button.CommandParameter>
                            <updates:UpdateProfileMode>Default</updates:UpdateProfileMode>
                        </ui:Button.CommandParameter>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- CARD 2: Security (Recommended) -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="2" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{loc:Tr Updates_SecurityOnly}" FontSize="16" FontWeight="Bold" />
                            <Border DockPanel.Dock="Right" Background="#E6F4EA" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="{loc:Tr Wizard_Recommended}" FontSize="10" FontWeight="Bold" Foreground="#137333" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{loc:Tr Updates_MaximumStabilityWithoutSacrificingSecuri}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{loc:Tr Updates_InstallsCriticalSecurityUpdatesAutomatic}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="{loc:Tr Updates_DelaysAnnualFeatureUpdatesBy}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="{loc:Tr Updates_DisablesDisruptiveAutomaticRebootsWhile}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="{loc:Tr Updates_ExcludesBuggyThirdPartyHardware}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                    </StackPanel>

                    <ui:Button Grid.Row="2" AutomationProperties.AutomationId="SelectMode_Security"
                               AutomationProperties.Name="Select Security Profile"
                               Content="{loc:Tr Updates_SelectSecurityProfile}" Appearance="Primary" HorizontalAlignment="Stretch"
                               Command="{Binding SelectModeCommand}">
                        <ui:Button.CommandParameter>
                            <updates:UpdateProfileMode>Security</updates:UpdateProfileMode>
                        </ui:Button.CommandParameter>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- CARD 3: Disable All Updates (CAUTION) -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#C5221F" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{loc:Tr Updates_DisableAllUpdates}" FontSize="16" FontWeight="Bold" Foreground="#C5221F" />
                            <Border DockPanel.Dock="Right" Background="#FCE8E6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="{loc:Tr Updates_Caution}" FontSize="10" FontWeight="Bold" Foreground="#C5221F" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{loc:Tr Updates_CompletelyHaltsAllWindowsUpdate}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Border Background="#FFF0F0" BorderBrush="#FFCCCC" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{loc:Tr Updates_WarningStoppingUpdatesLeavesYour}"
                                       Foreground="#C5221F" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{loc:Tr Updates_DisablesWuauservBitsAndUsosvc}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="{loc:Tr Updates_PreventsWindowsFromCheckingOr}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" />

                        <!-- Safety typed confirmation input -->
                        <TextBlock Text="{loc:Tr Updates_ToSelectThisModeType}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBox AutomationProperties.AutomationId="DisableUpdatesConfirmBox"
                                 AutomationProperties.Name="Disable Updates Confirmation Input"
                                 Text="{Binding TypedConfirmation, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6" Margin="0,0,0,4" />
                    </StackPanel>

                    <ui:Button Grid.Row="2" AutomationProperties.AutomationId="SelectMode_DisableAll"
                               AutomationProperties.Name="Select Disable Profile"
                               Content="{loc:Tr Updates_SelectDisableProfile}" Appearance="Danger" HorizontalAlignment="Stretch"
                               Command="{Binding SelectModeCommand}">
                        <ui:Button.CommandParameter>
                            <updates:UpdateProfileMode>DisableAll</updates:UpdateProfileMode>
                        </ui:Button.CommandParameter>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Apply & Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <ui:Button AutomationProperties.AutomationId="ApplyUpdatesProfileButton"
                           AutomationProperties.Name="Apply Selected Update Profile"
                           Content="{loc:Tr Updates_ApplySelectedProfile}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                           Command="{Binding ApplySelectedModeCommand}" IsEnabled="{Binding IsApplyEnabled}"
                           DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
