<UserControl x:Class="WinVelo.App.Views.InstallTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinVelo.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:WinVelo.App.ViewModels"
             xmlns:controls="clr-namespace:WinVelo.App.Controls"
             AutomationProperties.AutomationId="InstallTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Search & Manager Bar -->
            <RowDefinition Height="Auto" /> <!-- Category Filter Bar -->
            <RowDefinition Height="*" />    <!-- Responsive Apps Grid -->
            <RowDefinition Height="Auto" /> <!-- Sticky Selection Footer (appears only when HasSelection) -->
        </Grid.RowDefinitions>

        <!-- Top Search, Manager & Upgrade Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Search Input (AutomationId="TopSearchBox" for UI tests) -->
                    <ui:TextBox AutomationProperties.AutomationId="TopSearchBox"
                                AutomationProperties.Name="Search applications"
                                PlaceholderText="{loc:Tr Apps_SearchApplications}"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Width="220" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- Package Manager Selector -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{loc:Tr Apps_PackageManager}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding AvailablePackageManagers}"
                                  SelectedItem="{Binding PackageManager, Mode=TwoWay}"
                                  AutomationProperties.Name="Package Manager"
                                  Width="120" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Upgrade All Button -->
                    <ui:Button AutomationProperties.AutomationId="UpgradeAllButton"
                               AutomationProperties.Name="Upgrade All Apps"
                               Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}"
                               Content="{loc:Tr Apps_UpgradeAll}" Command="{Binding UpgradeAllCommand}"
                               VerticalAlignment="Center" Margin="0,0,8,0" Padding="12,5" />
                </WrapPanel>

                <!-- Right: Active Status / Apps Count -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilteredApps.Count, StringFormat={loc:Tr Apps_0Apps}}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Category Filter Bar -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="16,8">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Content="{Binding}" Margin="0,0,6,4" Padding="12,4"
                                   AutomationProperties.Name="{Binding StringFormat='Category: {0}'}"
                                   Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Apps List: Responsive Grid that never scrolls horizontally -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
            <ItemsControl ItemsSource="{Binding FilteredApps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ResponsiveUniformGrid MinItemWidth="280" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="4" Padding="12,10"
                                ToolTip="{Binding Description}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /> <!-- Checkbox -->
                                    <ColumnDefinition Width="Auto" /> <!-- Icon Tile -->
                                    <ColumnDefinition Width="*" />    <!-- Name, Category, State Badge -->
                                    <ColumnDefinition Width="Auto" /> <!-- Action / Link -->
                                </Grid.ColumnDefinitions>

                                <!-- Selection Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="{Binding Key, StringFormat='AppCheck_{0}'}"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}"
                                          Style="{DynamicResource ModernCheckBox}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />

                                <!-- App Icon Tile -->
                                <Border Grid.Column="1" Background="{Binding IconBackground}"
                                        BorderBrush="{Binding IconBorder}" BorderThickness="1"
                                        CornerRadius="8" Width="40" Height="40" Margin="0,0,10,0"
                                        VerticalAlignment="Center" ClipToBounds="True">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Real Extracted Windows Exe Icon from Disk -->
                                        <Image FlowDirection="LeftToRight" Source="{Binding IconImage}" Width="28" Height="28"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVis}}" />

                                        <!-- Authentic SVG Vector Logo -->
                                        <Viewbox FlowDirection="LeftToRight" Width="22" Height="22"
                                                 Visibility="{Binding HasSvgIcon, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{Binding SvgIconPath}" Fill="White" Stretch="Uniform" />
                                        </Viewbox>

                                        <!-- Vector Symbol Fallback -->
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" Foreground="White" FontSize="18"
                                                       Visibility="{Binding HasSymbolIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- App Name, Category & State Badge -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               ToolTip="{Binding Name}" TextWrapping="Wrap" Margin="0,0,0,4" />

                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- State Badge: Installed / Not installed / Update available -->
                                        <Border Background="{Binding StateBadgeBackground}"
                                                BorderBrush="{Binding StateBadgeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText, Converter={StaticResource Tr}}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding StateBadgeForeground}" />
                                        </Border>

                                        <TextBlock Text="{Binding Category, Converter={StaticResource Tr}}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Official Website Link Button -->
                                <ui:Button Grid.Column="3" Appearance="Transparent" Padding="4" Margin="4,0,0,0"
                                           AutomationProperties.Name="{Binding Name, StringFormat='Visit website for {0}'}"
                                           Icon="{ui:SymbolIcon Globe20}" ToolTip="{loc:Tr Apps_VisitOfficialWebsite}"
                                           Command="{Binding DataContext.OpenAppWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Sticky Selection Bar (Appears ONLY when there is a selection) -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="16,10"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="False">
                <!-- Left: Selected Count Text -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionStatusText}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Right: Action Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ui:Button AutomationProperties.AutomationId="InstallSelectedButton"
                               AutomationProperties.Name="Install Selected Apps"
                               Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Content="{Binding SelectionStatusText}" Command="{Binding InstallSelectedCommand}"
                               Margin="0,0,8,0" Padding="14,6" FontWeight="SemiBold" />

                    <ui:Button AutomationProperties.AutomationId="UninstallSelectedButton"
                               AutomationProperties.Name="Uninstall Selected Apps"
                               Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}"
                               Content="{loc:Tr Apps_UninstallSelected}" Command="{Binding UninstallSelectedCommand}"
                               Margin="0,0,8,0" Padding="12,6" />

                    <Button Style="{DynamicResource ModernGhostBtn}"
                            AutomationProperties.AutomationId="ClearAppSelectionButton"
                            AutomationProperties.Name="Clear App Selection"
                            Content="{loc:Tr Apps_Clear}" Command="{Binding ClearSelectionCommand}"
                            Padding="8,4" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
