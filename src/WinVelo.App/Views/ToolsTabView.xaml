<UserControl x:Class="WinVelo.App.Views.ToolsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinVelo.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:WinVelo.App.ViewModels"
             AutomationProperties.AutomationId="ToolsTabView"
             AutomationProperties.Name="System Tools and Utilities">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1180" HorizontalAlignment="Stretch">
            <!-- OVERVIEW: Grid of Tool Tiles (Visible when no subtool is active) -->
            <Border Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Tools_SystemToolsDiagnostics}"
                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Tr Tools_IntegratedWindowsMaintenanceServiceContr}"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" />

                    <!-- Grid of 8 Tool Tiles -->
                    <UniformGrid Columns="3" Margin="0,0,0,24">
                        <!-- 1. Startup Apps -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_StartupApps}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_InspectAppsThatLaunchAutomatically}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Startup" AutomationProperties.Name="Startup Applications"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Startup" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 2. Windows Services -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Server24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_WindowsServices}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_AuditSystemBackgroundServicesWith}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Services" AutomationProperties.Name="Windows Services"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Services" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 3. Safe Cache Cleaner -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Broom24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_Cleaner}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_SafelyRemoveTemporaryClutterWindows}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Cleaner" AutomationProperties.Name="Safe Cache Cleaner"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Cleaner" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 4. DNS Switcher -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_DnsNetwork}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_BenchmarkResponseLatencyAcrossPrivacy}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_DNS" AutomationProperties.Name="DNS Switcher"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="DNS" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 5. Quick Fixes -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Wrench24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_FixesRepairs}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_OneClickDiagnosisAndRepair}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Fixes" AutomationProperties.Name="Quick System Fixes"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Fixes" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 6. Windows Updates -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_WindowsUpdates}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_ControlUpdatePoliciesDriverExclusions}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Updates" AutomationProperties.Name="Windows Updates Mode"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Updates" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 7. Optional Features -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="CheckboxChecked24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_OptionalFeatures}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_EnableOrRemoveWindowsOptional}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_Features" AutomationProperties.Name="Optional Features"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="Features" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 8. Restore Points -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="History24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_RestorePoints}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_CreateAndInspectWindowsSystem}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_RestorePoints" AutomationProperties.Name="Restore Points"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="RestorePoints" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- 9. Built-in apps (WinUtil AppX removal) -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Tools_BuiltInApps}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr Tools_BuiltInAppsDescription}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Grid.Row="3" AutomationProperties.AutomationId="Tool_BuiltInApps" AutomationProperties.Name="Built-in apps"
                                        Content="{loc:Tr Tools_OpenTool}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding SelectToolCommand}" CommandParameter="BuiltInApps" HorizontalAlignment="Left" Padding="12,5" />
                            </Grid>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- SUBTOOL VIEW: Header with Back button and Quick Switcher (Visible when inside a tool) -->
            <Border Visibility="{Binding IsSubtoolOpen, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <DockPanel LastChildFill="False">
                        <!-- Back Button -->
                        <Button DockPanel.Dock="Left" AutomationProperties.Name="Back to Tools"
                                Content="{loc:Tr Tools_BackToTools}" Style="{DynamicResource ModernSecondaryBtn}"
                                Command="{Binding BackToOverviewCommand}" Margin="0,0,16,0" Padding="14,6" VerticalAlignment="Center" />

                        <!-- Compact Tool Switcher Bar -->
                        <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button AutomationProperties.Name="Startup Applications"
                                    Content="{loc:Tr Tools_StartupApps}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Startup" />
                            <Button AutomationProperties.Name="Windows Services"
                                    Content="{loc:Tr Tools_Services}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Services" />
                            <Button AutomationProperties.Name="Safe Cache Cleaner"
                                    Content="{loc:Tr Tools_Cleaner}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Cleaner" />
                            <Button AutomationProperties.Name="DNS Switcher"
                                    Content="{loc:Tr Tools_DnsNetwork}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="DNS" />
                            <Button AutomationProperties.Name="Quick System Fixes"
                                    Content="{loc:Tr Tools_FixesRepairs}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Fixes" />
                            <Button AutomationProperties.Name="Windows Updates Mode"
                                    Content="{loc:Tr Tools_Updates}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Updates" />
                            <Button AutomationProperties.Name="Optional Features"
                                    Content="{loc:Tr Tools_Features}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="Features" />
                            <Button AutomationProperties.Name="Restore Points"
                                    Content="{loc:Tr Tools_RestorePoints}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,4,0"
                                    Command="{Binding SelectToolCommand}" CommandParameter="RestorePoints" />
                            <Button AutomationProperties.Name="Built-in apps"
                                    Content="{loc:Tr Tools_BuiltInApps}" Style="{DynamicResource ModernGhostBtn}"
                                    Command="{Binding SelectToolCommand}" CommandParameter="BuiltInApps" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- ==================== 1. STARTUP APPS ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Startup">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Startup_StartupApplicationsManager}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_ReviewAppsThatLaunchAutomatically}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Startup_OptimizeStartupApps}"
                                    AutomationProperties.Name="Optimize Startup Apps"
                                    Style="{DynamicResource ModernPrimaryBtn}"
                                    Command="{Binding StartupVM.OptimizeStartupCommand}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding StartupVM.FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Impact, Converter={StaticResource Tr}, StringFormat={loc:Tr Tools_Impact0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Toggle startup for {0}'}"
                                                  Style="{DynamicResource ModernCheckBox}"
                                                  Command="{Binding DataContext.StartupVM.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 2. SERVICES ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Services">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Tools_WindowsServicesInspector}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Tools_InspectSystemBackgroundServicesProtected}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.ServicesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ServiceName, StringFormat={loc:Tr Home_Id0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Grid.Column="3" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StartupType, StringFormat={loc:Tr Tools_Startup0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 3. CLEANER ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Cleaner">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Tools_SafeCacheTemporaryFileCleaner}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_ScansOnlyWhitelistedLocationsTemp}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding ToolboxVM.CleanerStatusText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Tr Tools_ScanNow}" AutomationProperties.Name="Scan Cache Now" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ToolboxVM.ScanCleanerCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:Tr Tools_CleanSelected}" AutomationProperties.Name="Clean Selected Items" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding ToolboxVM.CleanNowCommand}" />
                                <Button Content="{loc:Tr Tools_StopCleanup}" AutomationProperties.Name="Stop Cleanup" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ToolboxVM.CancelCleanCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding ToolboxVM.IsCleaning, Converter={StaticResource BoolToVisConverter}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.CleanerCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding PathDescription}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 4. DNS & NETWORK ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="DNS">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Tools_SecureDnsLatencyBenchmark}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_TestResponseTimesToMajor}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding ToolboxVM.DnsStatusText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Tr Tools_BenchmarkAll}" AutomationProperties.Name="Benchmark All DNS Providers" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ToolboxVM.BenchmarkAllDnsCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:Tr Tools_ApplyFastest}" AutomationProperties.Name="Apply Fastest DNS" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding ToolboxVM.ApplyFastestDnsCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:Tr Tools_ResetToDhcp}" AutomationProperties.Name="Reset DNS to DHCP" Style="{DynamicResource ModernGhostBtn}"
                                        Command="{Binding ToolboxVM.ResetDnsToDhcpCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Nagle's Algorithm Toggle -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Tools_TcpLatencyNagleSAlgorithm}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_SetsTcpackfrequency1AndTcpnodelay}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" AutomationProperties.Name="Disable Nagle's Algorithm Toggle" IsChecked="{Binding ToolboxVM.IsNagleDisabled, Mode=TwoWay}"
                                      Style="{DynamicResource ModernCheckBox}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.DnsProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource Tr}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <Border Background="#107C41" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{loc:Tr Tools_Active}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description, Converter={StaticResource Tr}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrimaryDns, StringFormat={loc:Tr Tools_Primary0}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0" />
                                                <TextBlock Text="{Binding SecondaryDns, StringFormat={loc:Tr Tools_Secondary0}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0" />
                                                <TextBlock Text="{Binding PrimaryDns6, StringFormat='IPv6: {0}'}" FlowDirection="LeftToRight" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0" />
                                                <TextBlock Text="{Binding PingMs, StringFormat={loc:Tr Tools_Latency0Ms}}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{loc:Tr Tools_Ping}" AutomationProperties.Name="{Binding Name, StringFormat='Ping {0}'}" Style="{DynamicResource ModernGhostBtn}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToolboxVM.TestDnsLatencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Content="{loc:Tr Tools_Apply}" AutomationProperties.Name="{Binding Name, StringFormat='Apply {0} DNS'}" Style="{DynamicResource ModernSecondaryBtn}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToolboxVM.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 5. FIXES & REPAIRS ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Fixes">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Tools_WindowsRepairsDiagnosticFixes}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Tools_OneClickRepairsForCommon}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ToolboxVM.FixStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ToolboxVM.FixesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <Border Background="{DynamicResource StatusDefaultBgBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category, Converter={StaticResource Tr}}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <Border Background="{DynamicResource BgDeepBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                                <TextBlock FlowDirection="LeftToRight" Text="{Binding Script, StringFormat={loc:Tr Tools_Command0}}" FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{loc:Tr Tools_RunRepair}" AutomationProperties.Name="{Binding Title, StringFormat='Run Repair: {0}'}" Style="{DynamicResource ModernPrimaryBtn}" VerticalAlignment="Center" Margin="14,0,0,0"
                                                Command="{Binding DataContext.ToolboxVM.RunFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Remote access helpers (from WinUtil's Config tab) -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Tools_RemoteAccessAndSignIn}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{loc:Tr Config_OpensshServer}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Tr Config_InstallsAndEnablesSshRemote}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Tools_OpenSsh" AutomationProperties.Name="Configure OpenSSH"
                                        Content="{loc:Tr Config_ConfigureOpenssh}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ConfigVM.ConfigureOpenSshCommand}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{loc:Tr Config_AutologonSysinternals}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Tr Tools_AutologonOpensTheOfficialPage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Tools_AutoLogon" AutomationProperties.Name="AutoLogon (Sysinternals)"
                                        Content="{loc:Tr Tools_OpenPage}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ConfigVM.RunFixCommand}" CommandParameter="autologon" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Power plan (WinUtil "Performance Plans") and O&O ShutUp10++ -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Tools_PowerPlanAndPrivacyTools}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{loc:Tr Tools_UltimatePerformancePlan}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Tr Tools_UltimatePerformanceNotForLaptops}" FontSize="11" Foreground="{DynamicResource CautionRedBrush}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button AutomationProperties.AutomationId="Tools_UltimatePlanEnable" AutomationProperties.Name="Enable Ultimate Performance"
                                            Content="{loc:Tr Tools_Enable}" Style="{DynamicResource ModernSecondaryBtn}" Margin="0,0,6,0"
                                            Command="{Binding ToolboxVM.EnableUltimatePlanCommand}" />
                                    <Button AutomationProperties.AutomationId="Tools_UltimatePlanDisable" AutomationProperties.Name="Disable Ultimate Performance"
                                            Content="{loc:Tr Tools_Disable}" Style="{DynamicResource ModernSecondaryBtn}"
                                            Command="{Binding ToolboxVM.DisableUltimatePlanCommand}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="O&amp;O ShutUp10++" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Tr Tools_OosuOpensTheOfficialPage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Tools_Oosu" AutomationProperties.Name="O&amp;O ShutUp10++"
                                        Content="{loc:Tr Tools_OpenPage}" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ToolboxVM.OpenOosuCommand}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding ToolboxVM.PowerPlanStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Classic Windows panels (WinUtil's legacy control panel shortcuts) -->
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Config_LegacyControlPanels14Shortcuts}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Config_InstantAccessToClassicWindows}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ConfigVM.LegacyPanels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button AutomationProperties.AutomationId="{Binding Key, StringFormat='{}Panel_{0}'}" AutomationProperties.Name="{Binding Name}"
                                                Content="{Binding Name}" Style="{DynamicResource ModernGhostBtn}" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.ConfigVM.LaunchPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ConfigVM.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 6. WINDOWS UPDATES ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Updates">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Tools_WindowsUpdateConfiguration}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_SelectAnHonestUpdatePolicy}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdatesVM.ActiveModeTitle, StringFormat={loc:Tr Tools_Current0}}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Update Mode Cards (Default, Recommended, Suspended) -->
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <!-- Mode 1: Default -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Tools_DefaultOutOfBox}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_StandardMicrosoftAutomaticUpdates}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,10" />
                                <TextBlock Text="{loc:Tr Tools_AutomaticallyChecksAndDownloadsAll}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Tr Tools_DriverUpdatesIncludedViaWindows}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
                                <Button Content="{loc:Tr Tools_ApplyDefaultMode}" AutomationProperties.Name="Apply Default Update Mode" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding UpdatesVM.ApplyModeCommand}" CommandParameter="Default" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- Mode 2: Recommended -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Tools_RecommendedSecurityFirst}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_DelaysFeatureUpdatesBy2}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,10" />
                                <TextBlock Text="{loc:Tr Tools_CriticalSecurityPatchesInstalled}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Tr Tools_PreventsUnexpectedRebootInterruptions}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
                                <Button Content="{loc:Tr Tools_ApplyRecommended}" AutomationProperties.Name="Apply Recommended Update Mode" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding UpdatesVM.ApplyModeCommand}" CommandParameter="Recommended" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- Mode 3: Suspended -->
                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Tools_SuspendedManualOnly}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource CautionRedBrush}" />
                                <TextBlock Text="{loc:Tr Tools_PausesAutomaticChecksUpdatesOnly}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,10" />
                                <TextBlock Text="{loc:Tr Tools_NoBackgroundUpdateScansOr}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Tr Tools_ServicingStackRemainsIntactAnd}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="{loc:Tr Tools_TypeIUnderstandToConfirm}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBox AutomationProperties.Name="Type I understand to confirm"
                                         Text="{Binding UpdatesVM.TypedConfirmation, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,4" Margin="0,0,0,10"
                                         Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}" />
                                <Button Content="{loc:Tr Tools_ApplySuspended}" AutomationProperties.Name="Apply Suspended Update Mode" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding UpdatesVM.ApplyModeCommand}" CommandParameter="Suspended" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="{Binding UpdatesVM.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ==================== 7. OPTIONAL FEATURES ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="Features">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Tools_WindowsOptionalFeatures}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Tools_EnableOrDisableOptionalSystem}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Tr Tools_EnableSelected}" AutomationProperties.Name="Enable Selected Features" Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding ConfigVM.InstallSelectedFeaturesCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:Tr Tools_DisableSelected}" AutomationProperties.Name="Disable Selected Features" Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding ConfigVM.UninstallSelectedFeaturesCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding ConfigVM.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ConfigVM.FilteredFeatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Background="{DynamicResource StatusDefaultBgBrush}">
                                            <TextBlock Text="{Binding Category, Converter={StaticResource Tr}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 8. RESTORE POINTS ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="RestorePoints">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Tools_WindowsSystemProtectionRestorePoints}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Tools_CreateManualCheckpointsUsingWindows}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,10" />

                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource StatusAppliedBgBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding RestorePointCount, StringFormat={loc:Tr Tools_RestorePointsFound0}}"
                                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource StatusAppliedFgBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding RestoreStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel LastChildFill="False">
                                <TextBox DockPanel.Dock="Left" Width="360"
                                         AutomationProperties.Name="Restore Point Description Input"
                                         Text="{Binding RestorePointDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,6" Margin="0,0,10,0"
                                         Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}" />
                                <Button DockPanel.Dock="Left" Content="{loc:Tr Home_CreateRestorePoint}"
                                        AutomationProperties.Name="Create Restore Point"
                                        Style="{DynamicResource ModernPrimaryBtn}"
                                        Command="{Binding CreateRestorePointCommand}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 9. BUILT-IN APPS (WinUtil AppX removal) ==================== -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTool}" Value="BuiltInApps">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr Tools_BuiltInApps}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Tools_BuiltInAppsLong}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button AutomationProperties.AutomationId="Appx_SelectRecommended" AutomationProperties.Name="Select recommended built-in apps" Content="{loc:Tr Tools_SelectRecommended}" Style="{DynamicResource ModernSecondaryBtn}" Margin="0,0,6,6"
                                        Command="{Binding ToolboxVM.SelectRecommendedAppxCommand}" />
                                <Button AutomationProperties.AutomationId="Appx_SelectInstalled" AutomationProperties.Name="Select installed built-in apps" Content="{loc:Tr Tools_SelectInstalled}" Style="{DynamicResource ModernSecondaryBtn}" Margin="0,0,6,6"
                                        Command="{Binding ToolboxVM.SelectInstalledAppxCommand}" />
                                <Button AutomationProperties.AutomationId="Appx_Clear" AutomationProperties.Name="Clear built-in app selection" Content="{loc:Tr Tools_ClearSelection}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,6,6"
                                        Command="{Binding ToolboxVM.ClearAppxSelectionCommand}" />
                                <Button AutomationProperties.AutomationId="Appx_Refresh" AutomationProperties.Name="Refresh built-in apps" Content="{loc:Tr Tools_Refresh}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,18,6"
                                        Command="{Binding ToolboxVM.RefreshAppxCommand}" />
                                <Button AutomationProperties.AutomationId="Appx_Remove" AutomationProperties.Name="Remove selected built-in apps" Content="{loc:Tr Tools_RemoveSelected}" Style="{DynamicResource ModernPrimaryBtn}" Margin="0,0,6,6"
                                        Command="{Binding ToolboxVM.RemoveSelectedAppxCommand}" />
                                <Button AutomationProperties.AutomationId="Appx_Reinstall" AutomationProperties.Name="Reinstall selected built-in apps" Content="{loc:Tr Tools_ReinstallSelected}" Style="{DynamicResource ModernSecondaryBtn}" Margin="0,0,6,6"
                                        Command="{Binding ToolboxVM.ReinstallSelectedAppxCommand}" />
                                <Button AutomationProperties.AutomationId="Appx_Cancel" AutomationProperties.Name="Cancel built-in app operation" Content="{loc:Tr Apps_Cancel}" Style="{DynamicResource ModernGhostBtn}" Margin="0,0,6,6"
                                        Command="{Binding ToolboxVM.CancelAppxCommand}"
                                        Visibility="{Binding ToolboxVM.IsAppxBusy, Converter={StaticResource BoolToVisConverter}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ToolboxVM.AppxStatusText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ToolboxVM.BuiltInApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{DynamicResource ModernCheckBox}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description, Converter={StaticResource Tr}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Note, Converter={StaticResource Tr}}" Foreground="{DynamicResource CautionRedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource StatusDefaultBgBrush}">
                                            <TextBlock Text="{Binding Risk, Converter={StaticResource Tr}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Background="{DynamicResource StatusDefaultBgBrush}">
                                            <TextBlock Text="{Binding InstalledText, Converter={StaticResource Tr}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
