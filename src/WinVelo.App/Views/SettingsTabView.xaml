<UserControl x:Class="WinVelo.App.Views.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinVelo.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:WinVelo.App.ViewModels"
             AutomationProperties.AutomationId="SettingsTabView"
             AutomationProperties.Name="Application Settings">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{loc:Tr Main_Settings}" FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_PreferencesExecutionSafetyAndApplication}"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">

                <!-- 1. Experience Level -->
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_ExperienceLevel}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Tr Settings_ChooseHowMuchTechnicalDetail}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <RadioButton GroupName="ModeGroup" IsChecked="{Binding IsSimpleMode, Mode=OneWay}"
                                                 Command="{Binding SetSimpleModeCommand}"
                                                 AutomationProperties.Name="Simple mode selection"
                                                 Content="{loc:Tr Settings_SimpleMode}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                                    <TextBlock Text="{loc:Tr Settings_CuratedPresetsAndSafeReversible}"
                                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="22,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <RadioButton GroupName="ModeGroup" IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                                                 Command="{Binding SetAdvancedModeCommand}"
                                                 AutomationProperties.Name="Advanced mode selection"
                                                 Content="{loc:Tr Wizard_AdvancedMode}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                                    <TextBlock Text="{loc:Tr Settings_FullCatalogAccessWithRegistry}"
                                               FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="22,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Safety & Execution -->
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_SafetyExecution}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Tr Settings_ConfigureExecutionGuardsAndCatalog}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                        <!-- Dry-Run Mode Toggle -->
                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Settings_DryRunMode}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Settings_SimulateOperationsWithoutMakingAny}"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsDryRun, Mode=TwoWay}"
                                      Style="{DynamicResource ModernCheckBox}"
                                      AutomationProperties.Name="Dry run mode toggle" />
                        </DockPanel>

                        <!-- Recommended Only Filter -->
                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Settings_ShowRecommendedOnlyByDefault}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Settings_FilterTheTweaksCatalogTo}"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding RecommendedOnly, Mode=TwoWay}"
                                      Style="{DynamicResource ModernCheckBox}"
                                      AutomationProperties.Name="Show recommended only toggle" />
                        </DockPanel>

                        <!-- Show Experimental Tweaks -->
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Settings_ShowExperimentalTweaks}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Settings_UnlockExperimentalTweaksUnderDevelopment}"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowExperimental, Mode=TwoWay}"
                                      Style="{DynamicResource ModernCheckBox}"
                                      AutomationProperties.Name="Show experimental tweaks toggle" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Appearance & Setup -->
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_InterfaceSetup}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Tr Settings_AppearanceAndFirstRunConfiguration}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                        <!-- Language -->
                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Settings_Language}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Settings_LanguageHint}"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <ComboBox DockPanel.Dock="Right" MinWidth="160"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.AutomationId="LanguageComboBox"
                                      AutomationProperties.Name="Language selection" />
                        </DockPanel>
                        <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="6"
                                Background="{DynamicResource AccentSubtleBrush}"
                                Visibility="{Binding IsLanguageRestartNeeded, Converter={StaticResource BoolToVisConverter}}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="{loc:Tr Settings_RestartNow}"
                                        Style="{DynamicResource ModernSecondaryBtn}"
                                        Command="{Binding RestartToApplyLanguageCommand}"
                                        AutomationProperties.AutomationId="RestartForLanguageButton"
                                        AutomationProperties.Name="Restart to apply language"
                                        Padding="12,6" Margin="12,0,0,0" FontSize="{StaticResource FontSizeCaption}" />
                                <TextBlock Text="{loc:Tr Settings_LanguageRestartNotice}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Settings_Theme}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Settings_ToggleBetweenDarkAndLight}"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Settings_ToggleDarkLight}"
                                    Style="{DynamicResource ModernSecondaryBtn}"
                                    Command="{Binding ToggleThemeCommand}"
                                    AutomationProperties.Name="Toggle theme button"
                                    Padding="12,6" FontSize="{StaticResource FontSizeCaption}" />
                        </DockPanel>

                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{loc:Tr Settings_FirstRunSetupWizard}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Settings_ReLaunchTheInitialSetup}"
                                           FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Settings_RunSetupWizard}"
                                    Style="{DynamicResource ModernSecondaryBtn}"
                                    Command="{Binding OpenWizardCommand}"
                                    AutomationProperties.Name="Reopen setup wizard button"
                                    Padding="12,6" FontSize="{StaticResource FontSizeCaption}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 4. About WinVelo -->
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Main_AboutWinvelo}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding VersionDisplay, StringFormat={loc:Tr Settings_Winvelo0AnHonestWindows}}"
                                   FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding OsDescription, StringFormat={loc:Tr Settings_OperatingSystem0}}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Tr Settings_WinveloDoesNotPromiseUnverified}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Tr Settings_CatalogDerivedFromChrisTitus}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
