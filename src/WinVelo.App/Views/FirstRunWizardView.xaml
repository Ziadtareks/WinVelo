<UserControl x:Class="WinVelo.App.Views.FirstRunWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinVelo.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:WinVelo.App.ViewModels"
             Focusable="True"
             AutomationProperties.AutomationId="FirstRunWizardView"
             AutomationProperties.Name="First-Run Setup Wizard">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <!-- Opaque modal dialog container (MaxWidth: 560px, Padding: 24px) -->
    <Border Background="{DynamicResource BgCardBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="12"
            Width="560" MaxWidth="560"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.75" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Header & Step Indicator -->
                <RowDefinition Height="*" />    <!-- Step Content -->
                <RowDefinition Height="Auto" /> <!-- Navigation Buttons -->
            </Grid.RowDefinitions>

            <!-- TOP HEADER & PROGRESS -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StepDescription}" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Step Counter / Visual Indicator -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentStep, StringFormat={loc:Tr Wizard_Step0Of3}}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <!-- Visual 3-segment progress indicator -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Width="24" Height="4" CornerRadius="2" Margin="0,0,4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Width="24" Height="4" CornerRadius="2" Margin="0,0,4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Width="24" Height="4" CornerRadius="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ==================== STEP 1: WHAT WINVELO DOES AND DOES NOT DO ==================== -->
            <StackPanel Grid.Row="1" Margin="0,4,0,16">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{loc:Tr Wizard_WinveloIsBuiltOnTransparency}"
                           FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <!-- Bullet 1: Transparent Tuning -->
                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#064E3B" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkStarburst24" Foreground="#10B981" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Wizard_TransparentEvidenceBasedSettings}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Wizard_EveryTweakShowsItsSource}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bullet 2: Non-Destructive Rollbacks -->
                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="History24" Foreground="#60A5FA" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Wizard_SafetyFullRollbacks}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Wizard_EveryChangeRecordsBaselineValues}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bullet 3: Servicing Protection -->
                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#78350F" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#FBBF24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Wizard_ProtectsWindowsUpdatesIntegrity}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Tr Wizard_CoreSystemComponentsWindowsUpdate}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== STEP 2: SYSTEM RESTORE PROTECTION ==================== -->
            <StackPanel Grid.Row="1" Margin="0,4,0,16">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Status Banner -->
                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Wizard_CurrentStatus}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding RestoreStatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />

                        <!-- Enable Button (if disabled) -->
                        <Button Content="{loc:Tr Wizard_TurnOnSystemRestoreDrive}"
                                AutomationProperties.Name="Turn On System Restore"
                                Command="{Binding EnableSystemRestoreCommand}"
                                IsEnabled="{Binding IsSystemRestoreEnabled, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,6" FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryBtn}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemRestoreEnabled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Create & Verify Restore Point Card -->
                <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Wizard_SystemRestorePointVerification}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Tr Wizard_CreateAFreshRestorePoint}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="16" />

                        <DockPanel LastChildFill="False">
                            <ui:Button DockPanel.Dock="Left"
                                       AutomationProperties.Name="Create and Verify Restore Point"
                                       Appearance="Primary"
                                       Command="{Binding CreateAndVerifyRestorePointCommand}"
                                       IsEnabled="{Binding IsCreatingRestorePoint, Converter={StaticResource BoolToVisConverter}}"
                                       Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="AddCircle24" Margin="0,0,6,0" FontSize="16" />
                                    <TextBlock Text="{loc:Tr Wizard_CreateVerifyRestorePoint}" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                        </DockPanel>

                        <!-- Verified / Result Message -->
                        <Border Background="{DynamicResource BgCardHoverBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock Text="{Binding RestoreVerificationMessage}" FontSize="12"
                                       Foreground="#38BDF8" TextWrapping="Wrap" LineHeight="16" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== STEP 3: CHOOSE A MODE ==================== -->
            <StackPanel Grid.Row="1" Margin="0,4,0,16">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{loc:Tr Wizard_SelectHowMuchOfThe}"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <!-- Simple Mode Card -->
                <Border BorderThickness="2" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" Cursor="Hand"
                        Background="{DynamicResource BgDeepBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimpleMode}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding SelectSimpleModeCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"
                              AutomationProperties.Name="Select Simple Mode">
                            <Ellipse StrokeThickness="2">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimpleMode}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimpleMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Tr Wizard_SimpleModeRecommended}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                <Border Background="#064E3B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr Wizard_Recommended}" FontSize="9" FontWeight="Bold" Foreground="#10B981" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{loc:Tr Wizard_OnlyRecommendedTweaksAreVisible}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Advanced Mode Card -->
                <Border BorderThickness="2" CornerRadius="8" Padding="14,12" Cursor="Hand"
                        Background="{DynamicResource BgDeepBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimpleMode}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding SelectAdvancedModeCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"
                              AutomationProperties.Name="Select Advanced Mode">
                            <Ellipse StrokeThickness="2">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimpleMode}" Value="False">
                                                <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimpleMode}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Tr Wizard_AdvancedMode}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr Wizard_AllTweaks}" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{loc:Tr Wizard_FullCatalogAcrossAllRisk}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== NAVIGATION BUTTONS ==================== -->
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,8,0,0">
                <!-- Back Button -->
                <Button DockPanel.Dock="Left" Content="{loc:Tr Wizard_Back}"
                        AutomationProperties.Name="Previous Wizard Step"
                        Command="{Binding PreviousStepCommand}" Padding="16,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModernGhostBtn}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Right Buttons: Skip / Next / Finish -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="SkipWizardButton"
                            AutomationProperties.Name="Skip Setup"
                            Content="{loc:Tr Wizard_SkipSetup}" Style="{DynamicResource ModernGhostBtn}"
                            IsCancel="True"
                            Command="{Binding FinishCommand}" Margin="0,0,10,0" Padding="14,8" />

                    <!-- Next Step Button (Steps 1 & 2) -->
                    <ui:Button AutomationProperties.AutomationId="WizardNextButton"
                               AutomationProperties.Name="Next Step"
                               Appearance="Primary" Content="{loc:Tr Wizard_NextStep}"
                               IsDefault="True"
                               Command="{Binding NextStepCommand}" Padding="18,8" FontWeight="SemiBold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Finish Button (Step 3) -->
                    <ui:Button AutomationProperties.AutomationId="WizardFinishButton"
                               AutomationProperties.Name="Get Started"
                               Appearance="Primary" Content="{loc:Tr Wizard_GetStarted}"
                               IsDefault="True"
                               Command="{Binding FinishCommand}" Padding="18,8" FontWeight="SemiBold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
