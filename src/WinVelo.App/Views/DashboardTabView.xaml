<UserControl x:Class="WinVelo.App.Views.DashboardTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinVelo.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:WinVelo.App.ViewModels"
             AutomationProperties.AutomationId="DashboardTabView">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="SegmentedRadioBtn" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- ==================== CALM STATUS & SERVICING CENTER ==================== -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header & Badges -->
                        <RowDefinition Height="Auto" /> <!-- Pending Alert Banners -->
                        <RowDefinition Height="Auto" /> <!-- Calm Status Cards (3 Columns) -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header & Quick Status Pills -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Home_Overview}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Home_SystemProtectionStatusTrackedChanges}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Badges -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <!-- Admin Badge -->
                            <Border AutomationProperties.AutomationId="AdminStatusBadge"
                                    AutomationProperties.Name="Administrator Status"
                                    Background="{Binding AdminBadgeBg}" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Shield20" Foreground="{Binding AdminBadgeFg}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock AutomationProperties.AutomationId="AdminStatusBadge"
                                               AutomationProperties.Name="Administrator Status"
                                               Text="{Binding AdminStatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding AdminBadgeFg}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Create Restore Point Button -->
                            <ui:Button AutomationProperties.AutomationId="CreateRestorePointButton"
                                       AutomationProperties.Name="Create Restore Point"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon History24}"
                                       Content="{loc:Tr Home_CreateRestorePoint}"
                                       Command="{Binding CreateRestorePointCommand}"
                                       Padding="12,6" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 1: Pending Alerts Banners (Reboot, Explorer) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <!-- Pending Reboot Alert -->
                        <Border Background="#78350F" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding IsRebootPending, Converter={StaticResource BoolToVisConverter}}">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="#FDE68A" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr Home_SystemRebootRequiredToComplete}" FontWeight="SemiBold" FontSize="12" Foreground="#FEF3C7" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Pending Explorer Restart Alert -->
                        <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding IsExplorerRestartPending, Converter={StaticResource BoolToVisConverter}}">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Desktop24" Foreground="#93C5FD" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ExplorerRestartPendingMessage}" FontWeight="SemiBold" FontSize="12" Foreground="#DBEAFE" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{loc:Tr Home_RestartExplorer}"
                                           AutomationProperties.Name="Restart Windows Explorer"
                                           Command="{Binding RestartExplorerCommand}" Padding="10,4" FontSize="11" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Row 2: 3 Compact Status Cards -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: System Restore -->
                        <Border Grid.Column="0" AutomationProperties.AutomationId="SystemRestoreCard"
                                AutomationProperties.Name="System Restore Status"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,6,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="History24" Foreground="{Binding SystemRestoreBadgeFg}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock AutomationProperties.AutomationId="SystemRestoreHeader"
                                               AutomationProperties.Name="System Restore"
                                               Text="{loc:Tr Home_RestoreProtection}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SystemRestoreStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RestorePointStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Changes made by WinVelo -->
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="CheckmarkStarburst24" Foreground="#38BDF8" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr Home_WinveloChanges}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding AppliedTweaksSummaryText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{loc:Tr Home_TrackedInRollbackJournal}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Servicing Health -->
                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="6,0,0,0"
                                ToolTip="{Binding ServicingHealthDetails}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="HeartPulse24" Foreground="{Binding ServicingHealthBadgeFg}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr Home_ServicingHealth}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ServicingHealthShortStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Tr Home_HoverForComponentDetails}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== PRESETS SECTION (CURATED PRESETS) ==================== -->
            <DockPanel LastChildFill="False" Margin="2,0,0,12">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{loc:Tr Home_Presets}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Tr Home_CuratedTweakCollectionsReviewBefore}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border AutomationProperties.AutomationId="{Binding Id, StringFormat='PresetCard_{0}'}"
                                AutomationProperties.Name="{Binding Title}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Header: Icon, Title -->
                                    <RowDefinition Height="Auto" /> <!-- One-line Description -->
                                    <RowDefinition Height="Auto" /> <!-- Tiers Subtitle & Selector -->
                                    <RowDefinition Height="*" />    <!-- Included Tweaks Preview -->
                                    <RowDefinition Height="Auto" /> <!-- Action Button & Status -->
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Left" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock AutomationProperties.AutomationId="{Binding Id, StringFormat='PresetCard_{0}'}"
                                               AutomationProperties.Name="{Binding Title}"
                                               Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- One-line Description -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                <!-- Tiers Subtitle & Standard/Full Selector -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding TiersSubtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{loc:Tr Home_Standard}"
                                                         AutomationProperties.AutomationId="{Binding Id, StringFormat='TierStandard_{0}'}"
                                                         AutomationProperties.Name="{Binding Title, StringFormat='Standard tier for {0}'}"
                                                         GroupName="{Binding Id, StringFormat='Tier_{0}'}"
                                                         IsChecked="{Binding IsStandardTier, Mode=TwoWay}"
                                                         Style="{StaticResource SegmentedRadioBtn}" />
                                            <RadioButton Content="{loc:Tr Home_Full}"
                                                         AutomationProperties.AutomationId="{Binding Id, StringFormat='TierFull_{0}'}"
                                                         AutomationProperties.Name="{Binding Title, StringFormat='Full tier for {0}'}"
                                                         GroupName="{Binding Id, StringFormat='Tier_{0}'}"
                                                         IsChecked="{Binding IsFullTier, Mode=TwoWay}"
                                                         Style="{StaticResource SegmentedRadioBtn}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Included Tweaks Preview -->
                                <Border Grid.Row="3" Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Home_IncludedTweaks}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding PreviewTweakSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" LineHeight="16" MaxHeight="52" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <!-- Button & Status Message -->
                                <DockPanel Grid.Row="4" LastChildFill="False">
                                    <ui:Button DockPanel.Dock="Left"
                                               Appearance="Primary"
                                               AutomationProperties.AutomationId="{Binding Id, StringFormat='ProfileBtn_{0}'}"
                                               AutomationProperties.Name="{Binding Title, StringFormat='Review {0}'}"
                                               Content="{Binding ButtonText}"
                                               Command="{Binding ApplyCommand}"
                                               Padding="16,7" FontWeight="SemiBold" />

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                                   Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Style="{DynamicResource ModernGhostBtn}"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Show details for {0} profile'}"
                                                Padding="4,1" Margin="4,0,0,0"
                                                Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisConverter}}"
                                                Command="{Binding ShowDetailsCommand}">
                                            <TextBlock Text="{loc:Tr Config_Details}" FontSize="11" Foreground="#60A5FA" TextDecorations="Underline" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Secondary Actions Row: Undo All & Get Recommendations -->
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,24">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- Undo all WinVelo changes as a secondary text button -->
                        <Button AutomationProperties.AutomationId="UndoAllWinVeloButton"
                                AutomationProperties.Name="Undo all WinVelo changes"
                                Content="{loc:Tr Home_UndoAllWinveloChanges}"
                                Style="{DynamicResource ModernSecondaryBtn}"
                                Command="{Binding UndoAllChangesCommand}"
                                Padding="12,6" FontSize="12" Margin="0,0,10,0" />

                        <!-- Get recommendations as a secondary text button -->
                        <Button AutomationProperties.AutomationId="SmartAnalyzeOptimizeButton"
                                AutomationProperties.Name="Get recommendations"
                                Content="{loc:Tr Home_GetRecommendations}"
                                Style="{DynamicResource ModernSecondaryBtn}"
                                Command="{Binding GetRecommendationsCommand}"
                                IsEnabled="{Binding IsNotSmartOptimizing}"
                                Padding="12,6" FontSize="12" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GlobalStatusMessage}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Button Style="{DynamicResource ModernGhostBtn}"
                                AutomationProperties.Name="Show Global Error Details"
                                Padding="4,1" Margin="6,0,0,0"
                                Visibility="{Binding HasFailedDetails, Converter={StaticResource BoolToVisConverter}}"
                                Command="{Binding ShowDetailsDialogCommand}">
                            <TextBlock Text="{loc:Tr Config_Details}" FontSize="11" Foreground="#60A5FA" TextDecorations="Underline" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== COMMON SETTINGS (8 QUICK-TOGGLES) ==================== -->
            <DockPanel LastChildFill="False" Margin="2,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="{loc:Tr Home_CommonSettings}" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{loc:Tr Home_ToggleIndividualWindowsSettings}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding QuickToggles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Icon + Toggle Switch + ProgressRing -->
                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Left" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Width="30" Height="30">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Switch Button + Animated Spinner -->
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                         Foreground="#3B82F6"
                                                         Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisConverter}}" />
                                        <ui:ToggleSwitch AutomationProperties.AutomationId="{Binding Id, StringFormat='Toggle_{0}'}"
                                                         AutomationProperties.Name="{Binding Title, StringFormat='Toggle {0}'}"
                                                         IsChecked="{Binding IsActive, Mode=OneWay}"
                                                         IsEnabled="{Binding IsNotApplying}"
                                                         Command="{Binding ToggleCommand}"
                                                         CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                                         VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Title and Status Badge -->
                                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBackground}"
                                            BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding StatusBadgeForeground}" />
                                    </Border>
                                </DockPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" LineHeight="15" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

    <!-- EXECUTION DETAILS DIALOG OVERLAY -->
    <Grid Background="#99000000"
          Visibility="{Binding IsDetailsDialogOpen, Converter={StaticResource BoolToVisConverter}}"
          Panel.ZIndex="2000">
        <Border Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="10"
                Width="700" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding DetailsDialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                            AutomationProperties.Name="Close Execution Details"
                            Command="{Binding CloseDetailsDialogCommand}" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding ExecutionDetailsItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusFgColor}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Id, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock FlowDirection="LeftToRight" Grid.Row="1" Text="{Binding Reason}" FontSize="11" Foreground="#EF4444"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas, Cascadia Code, Courier New" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <ui:Button Content="{loc:Tr Config_Close}" Appearance="Secondary"
                               AutomationProperties.Name="Close Details Dialog"
                               Command="{Binding CloseDetailsDialogCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- IRREVERSIBLE TWEAK WARNING MODAL -->
    <Grid Background="#99000000"
          Visibility="{Binding IsIrreversibleDialogOpen, Converter={StaticResource BoolToVisConverter}}"
          Panel.ZIndex="2100">
        <Border Background="{DynamicResource BgCardBrush}"
                BorderBrush="#EF4444"
                BorderThickness="1" CornerRadius="10"
                Width="650" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="18" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IrreversibleDialogTitle}" FontSize="16" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                            AutomationProperties.Name="Close Warning Dialog"
                            Command="{Binding CancelIrreversibleCommand}" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="{loc:Tr Home_TheFollowingActionSMake}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl ItemsSource="{Binding IrreversibleWarningItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="#DC2626" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FCA5A5" />
                                        <TextBlock Text="{Binding Id, StringFormat={loc:Tr Home_Id0}}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,4" />
                                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#F87171" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="{loc:Tr Config_Cancel}" Appearance="Secondary" Margin="0,0,10,0"
                               AutomationProperties.Name="Cancel Permanent Changes"
                               Command="{Binding CancelIrreversibleCommand}" />
                    <ui:Button Content="{loc:Tr Home_IUnderstandApplyChanges}" Appearance="Danger"
                               AutomationProperties.Name="Confirm Apply Permanent Changes"
                               Command="{Binding ConfirmIrreversibleCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- PROFILE PREVIEW DIALOG MODAL -->
    <Grid Background="#99000000"
          Visibility="{Binding IsProfilePreviewOpen, Converter={StaticResource BoolToVisConverter}}"
          Panel.ZIndex="2150">
        <Border Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="10"
                Width="780" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Layer24" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding ProfilePreviewTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ModernGhostBtn}"
                            AutomationProperties.Name="Close Profile Preview"
                            Command="{Binding CancelProfilePreviewCommand}" />
                </DockPanel>

                <!-- Description & Notice -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ProfilePreviewDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource BgDeepBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info16" Foreground="#60A5FA" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProfilePreviewNotice}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Loading State or Items List -->
                <Grid Grid.Row="2">
                    <!-- Loading Indicator -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20"
                                Visibility="{Binding IsProfilePreviewLoading, Converter={StaticResource BoolToVisConverter}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Tr Home_AnalyzingSystemStates}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Items ScrollViewer -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                        <ItemsControl ItemsSource="{Binding ProfilePreviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox (disabled if already applied) -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}"
                                                      IsEnabled="{Binding IsSelectable}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- Tweak Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock FlowDirection="LeftToRight" Text="{Binding Id}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" FontFamily="Consolas, Cascadia Code, Courier New" />
                                                    <TextBlock Text="{Binding ReversibleText, Converter={StaticResource Tr}, StringFormat={loc:Tr Home_Reversible0}}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" />
                                                    <TextBlock Text="{loc:Tr Home_RebootRequired}" FontSize="11" Foreground="#F59E0B" Margin="0,0,10,0"
                                                               Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisConverter}}" />
                                                    <TextBlock Text="{loc:Tr Home_RestartsExplorer}" FontSize="11" Foreground="#38BDF8"
                                                               ToolTip="{loc:Tr Home_WindowsExplorerWillBeRestarted}"
                                                               Visibility="{Binding RequiresExplorerRestart, Converter={StaticResource BoolToVisConverter}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status & Risk Badges -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- State Badge -->
                                                <Border Background="{Binding StateBg}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StateText, Converter={StaticResource Tr}}" FontSize="10" FontWeight="Bold" Foreground="{Binding StateFg}" />
                                                </Border>

                                                <!-- Risk Badge -->
                                                <Border Background="{Binding RiskBadgeBg}" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="{Binding Risk, Converter={StaticResource Tr}}" FontSize="10" FontWeight="Bold" Foreground="{Binding RiskBadgeFg}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button Content="{loc:Tr Config_Cancel}" Appearance="Secondary" Margin="0,0,10,0"
                               AutomationProperties.Name="Cancel Profile Preview"
                               Command="{Binding CancelProfilePreviewCommand}" />
                    <ui:Button Content="{Binding ProfilePreviewConfirmText}" Appearance="Primary"
                               AutomationProperties.Name="{Binding ProfilePreviewConfirmText}"
                               Command="{Binding ConfirmProfilePreviewCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Grid>
</UserControl>
