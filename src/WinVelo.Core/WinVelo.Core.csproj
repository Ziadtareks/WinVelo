<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinVelo.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.3" />
  </ItemGroup>

  <!-- The catalog is built into the assembly so the app works without a Catalog folder.
       A Catalog folder next to the exe still overrides single files (see Catalog/CatalogSource.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Catalog\**\*.json" Exclude="..\..\Catalog\schema\**;..\..\Catalog\*.json">
      <LogicalName>Catalog/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
